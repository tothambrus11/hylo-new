//! stage:typing no-std
// Soundness 2 (cost). A chain of eight equalities. Expected: accepted, in milliseconds.
trait P { type X }
fun check<T>(x: T) {}
fun g<V where V is P>() {}
fun f<T0, T1, T2, T3, T4, T5, T6, T7, T8 where T0 == T1, T1 == T2, T2 == T3, T3 == T4, T4 == T5, T5 == T6, T6 == T7, T7 == T8, T0 is P>(x: T8.X) {
  g<T8>()
  check<T0.X>(x)
}
