-  /// Reports the lookups that skipped `e` while its extendee was being computed and that `e` may
-  /// have affected, now that its extendee is known to be `extendee` (`extorder`).
+  /// Records that a lookup reached `e` while its extendee is being computed, which closes a cycle
+  /// of extendee computations: `e` and the extensions entered after it form a cycle group.
+  private mutating func noteExtensionCycle(through e: ExtensionDeclaration.ID) {
+    guard let i = extensionFrames.lastIndex(where: { (f) in f.declaration == e }) else { return }
+    let gs = Set(extensionFrames[i...].compactMap(\.group))
+    let g: Int
+    if let h = gs.min() { g = h } else { nextCycleGroup += 1; g = nextCycleGroup }
+    for k in extensionFrames.indices where k >= i || (extensionFrames[k].group.map(gs.contains) ?? false) {
+      extensionFrames[k].group = g
+    }
+    for h in gs where h != g {
+      if let x = cycleGroups.removeValue(forKey: h) {
+        cycleGroups[g, default: ([], [])].members.append(contentsOf: x.members)
+        cycleGroups[g, default: ([], [])].lookups.append(contentsOf: x.lookups)
+      }
+    }
+  }
