-      reportCircularExtension(e, lookingUp: n)
-      return
+  /// The extendees of a cycle group depend on each other through member lookups. The group is
+  /// circular if one of these lookups may be affected by a member of the group that declares the
+  /// name looked up: whichever member is evaluated first, that lookup is made while the other's
+  /// extendee is unknown. The test uses the final extendees only, so its verdict does not depend on
+  /// the order in which the members were entered; otherwise the skips were exact.
+  private mutating func popExtensionFrame() {
+    let f = extensionFrames.removeLast()
+    guard let g = f.group else { return }
+    cycleGroups[g, default: ([], [])].members.append(f.declaration)
+    cycleGroups[g, default: ([], [])].lookups.append(contentsOf: f.lookups)
+    if extensionFrames.contains(where: { (x) in x.group == g }) { return }
+    let (members, lookups) = cycleGroups.removeValue(forKey: g)!
+    TyperCounters.bump("extorder.cycles")
+    var seen = Set<ExtensionDeclaration.ID>()
+    for m in members where seen.insert(m).inserted {
+      let u = extendeeType(m)
+      let names = declarations(lexicallyIn: .init(node: m))
+      for (q, s, n) in lookups where names[n.identifier] != nil && mayMatch(u, q, in: s) {
+        reportCircularExtension(m, lookingUp: n)
+        break
+      }
     }
   }
 
