+  /// Returns the single resolution thread solving an open equality `?v ~ x` or `x ~ ?v`, where
+  /// `?v` is a unification variable that does not occur in `x`, by reflexivity, or `nil` if `t`
+  /// does not have that form.
+  ///
+  /// Binding `?v` to `x` is the most general solution: any other solution assigns `?v` to a type
+  /// equal to `x`, and the goals that remain are closed under equality (coercions transport them
+  /// along proved equalities), so the other solutions add nothing but ambiguity.
+  private mutating func mostGeneralEqualityThread(
+    _ t: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment,
+    then continuation: [ResolutionThread.ContinuationItem],
+    penalties: Int, ancestors: [AnyTypeIdentity]
+  ) -> [ResolutionThread]? {
+    let u = program.types.reify(t, applying: environment.substitutions, withVariables: .kept)
+    guard u[.hasVariable], let e = program.types.cast(u, to: EqualityWitness.self) else {
+      return nil
+    }
+    let (l, r) = (program.types[e].lhs, program.types[e].rhs)
+    let s = environment.substitutions
+    if l.isVariable && !program.types.occurs(l, in: r, under: s) {
+    } else if r.isVariable && !program.types.occurs(r, in: l, under: s) {
+    } else {
+      return nil
+    }
+    TyperCounters.bump("eqmgu.solved")
+    let builtinCost = environment.givens.count + givens(visibleFrom: scopeOfUse).count
+    let w = expression(referringTo: .coercion(.reflexivity))
+    return [
+      formThread(
+        matching: w, to: u, in: environment, then: continuation,
+        penalties: penalties + builtinCost, ancestors: ancestors)
+    ]
   }
 
