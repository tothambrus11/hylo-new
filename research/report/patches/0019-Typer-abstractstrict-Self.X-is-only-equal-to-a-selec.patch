diff --git a/Sources/FrontEnd/Typer/TyperCounters.swift b/Sources/FrontEnd/Typer/TyperCounters.swift
index 03b8220..eb11295 100644
--- a/Sources/FrontEnd/Typer/TyperCounters.swift
+++ b/Sources/FrontEnd/Typer/TyperCounters.swift
@@ -169,6 +169,12 @@ public enum TyperExperiments {
   /// requirement (`pick<T where T is P>(t: T) -> T.X` applied to an `A` returns `A.X`).
   nonisolated(unsafe) public static var headsubst: Bool = enabled.contains("headsubst")
 
+  /// SEMANTIC FIX: the associated type `(Self::P).X` selected through the witness that a trait
+  /// or conformance declares is only equal to a selection through that same witness. Without it,
+  /// `Self.X` is equated with `T.X` for another witness `T is P` of a type equal to `Self`, which
+  /// converts `W.X` into `V.X` when `V == W` (compare `negative/associated-type-inequality`).
+  nonisolated(unsafe) public static var abstractstrict: Bool = enabled.contains("abstractstrict")
+
   /// SEMANTIC FIX: the associated type read from a generic conformance is instantiated with the
   /// type arguments of the witness (`Box<A>.X` is `A`, not the uninstantiated `T`).
   nonisolated(unsafe) public static var assocsubst: Bool = enabled.contains("assocsubst")
diff --git a/Sources/FrontEnd/Types/TypeStore.swift b/Sources/FrontEnd/Types/TypeStore.swift
