+      // Fix (`abstractstrict`): a selection through the witness being declared is only equal to
+      // another selection through that witness, not to one through any witness of an equal type.
+      let eitherAbstract = TyperExperiments.abstractstrict
+        ? ((a.value == .abstract) && (b.value == .abstract))
+        : ((a.value == .abstract) || (b.value == .abstract))
+      return (eitherAbstract || sameReference)
         && unifiable(a.type, b.type, extending: &ss, handlingCoercionsWith: areCoercible)
     } else {
