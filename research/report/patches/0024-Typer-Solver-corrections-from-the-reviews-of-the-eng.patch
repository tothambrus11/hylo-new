+  /// Returns `true` iff `a` and `b` are the same tree of references and applications, whatever
+  /// the types recorded on their inner nodes.
+  private func sameValue(_ a: WitnessExpression, _ b: WitnessExpression) -> Bool {
+    switch (a.value, b.value) {
+    case (.termApplication(let f, let x), .termApplication(let g, let y)):
+      return sameValue(f, g) && sameValue(x, y)
+    case (.typeApplication(let f, let x), .typeApplication(let g, let y)):
+      return sameValue(f, g) && (Array(x.values) == Array(y.values))
+    case (.nested(let x), .nested(let y)):
+      return sameValue(x, y)
+    case (.termApplication, _), (.typeApplication, _), (.nested, _):
+      return false
+    default:
+      return a.value == b.value
+    }
+  }
+
+  /// Returns `true` iff `w` refers to a given that is visible from `scopeOfUse`.
+  private mutating func isVisibleGiven(
+    _ w: WitnessExpression, from scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    for g in givens(visibleFrom: scopeOfUse).joined() where expression(referringTo: g) == w {
+      return true
+    }
+    return false
+  }
+
+  /// Returns `true` iff each premise that the deferred premise of type `a` mentions was
+  /// discharged by the witness that resolving it alone gives (`premcommit`).
+  ///
+  /// Name resolution commits: `A.X` is the associated type selected through the result of
+  /// resolving `A is P` alone. Without this test, a call `f<A>()` of `f<T where T is P, T.X is Q>`
+  /// would instead select, among all witnesses of `A is P`, one for which `A.X is Q` holds.
+  private mutating func commits(
+    _ a: AnyTypeIdentity, _ solved: [Int: WitnessExpression], _ operand: SummonResult,
+    _ environment: ResolutionThread.Environment, in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    if !TyperExperiments.premcommit { return true }
+    var mentioned: [Int] = []
+    _ = rewritingWitnesses(in: a, { (w) in
+      if case .assumed(let j) = w.value, !mentioned.contains(j) { mentioned.append(j) }
+      return nil
+    })
+
+    for j in mentioned {
+      guard let (g, hs) = environment.discharged[j], let w = solved[j] else { continue }
+      let goal = program.types.reify(g, applying: operand.substitutions, withVariables: .kept)
+      var hypotheses: [Given] = []
+      var open = goal[.hasVariable] || w.hasVariable
+      for h in hs {
+        guard case .assumed(let i, let t) = h else { hypotheses.append(h); continue }
+        let u = program.types.reify(t, applying: operand.substitutions, withVariables: .kept)
+        if u[.hasVariable] { open = true }
+        hypotheses.append(.assumed(i, u))
+      }
+      if open {
+        // The premise cannot be resolved alone in a meaningful way.
+        TyperCounters.bump("premcommit.open")
+        continue
+      }
+
+      let saved = (lastResolutionExhaustedDepth, heightExhausted)
+      let rs: [SummonResult]
+      if hypotheses.isEmpty {
+        rs = summon(goal, in: scopeOfUse)
+      } else {
+        let e = ResolutionThread.Environment(
+          substitutions: .init(), givens: hypotheses,
+          nextGivenIdentifier: environment.nextGivenIdentifier)
+        let ts = summon(goal, in: scopeOfUse, where: e, then: [], penalties: 0)
+        rs = takeSummonResults(from: ts, in: scopeOfUse)
+      }
+      (lastResolutionExhaustedDepth, heightExhausted) = saved
+      TyperCounters.bump("premcommit.checked")
+
+      guard let r = rs.uniqueElement else {
+        TyperCounters.bump("premcommit.ambiguous")
+        return false
+      }
+      let v = rewritingWitnesses(
+        in: program.types.reify(r.witness, applying: r.substitutions, withVariables: .kept),
+        { (x) in if case .assumed(let k) = x.value { solved[k] } else { nil } })
+      if !sameValue(v, w) {
+        TyperCounters.bump("premcommit.cut")
+        return false
+      }
+    }
+    return true
+  }
+
