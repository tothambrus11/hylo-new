+    // Build the term graph. Each node is a dealiased type; compound nodes have a shape and
+    // children. Concrete associated types are atoms; abstract ones are handled separately.
+    var nodes: [AnyTypeIdentity] = []
+    var index: [AnyTypeIdentity: Int] = [:]
+    var children: [[Int]] = []
+    var shapes: [String?] = []
+    var abstractProjections: [Int] = []
+    var concreteProjections: [AssociatedTypeDeclaration.ID: [Int]] = [:]
+    var unmodelled = false
+    func node(_ x: AnyTypeIdentity) -> Int {
+      let y = program.types.dealiased(x)
+      if let i = index[y] { return i }
+      let i = nodes.count
+      nodes.append(y)
+      index[y] = i
+      children.append([])
+      shapes.append(nil)
+      var cs: [Int] = []
+      var shape: String? = nil
+      switch program.types[y] {
+      case let u as TypeApplication:
+        cs.append(node(u.abstraction))
+        for a in u.arguments.values { cs.append(node(a)) }
+        shape = "app"
+      case let u as Tuple:
+        if case .cons(let h, let r) = u { cs = [node(h), node(r)]; shape = "cons" }
+      case let u as Metatype:
+        cs = [node(u.inhabitant)]; shape = "meta"
+      case let u as EqualityWitness:
+        cs = [node(u.lhs), node(u.rhs)]; shape = "eq"
+      case let u as Arrow:
+        cs = [node(u.environment)] + u.inputs.map({ (p) in node(p.type) }) + [node(u.output)]
+        shape = "arrow \(u.style) \(u.effect) " + u.inputs.map({ (p) in "\(p.label ?? "_"):\(p.access)" }).joined(separator: ",")
+      case let u as RemoteType:
+        cs = [node(u.projectee)]; shape = "remote \(u.access)"
+      case let u as FunctionPointer:
+        cs = u.inputs.map({ (x) in node(x) }) + [node(u.output)]; shape = "fp"
+      case let u as AssociatedType:
+        cs = [node(u.qualification.type)]
+        if (u.qualification.value == .abstract) && TyperExperiments.abstractstrict {
+          // A selection through the declared witness at a given type is equal to itself only.
+          cs = []
+        } else if u.qualification.value == .abstract {
+          shape = "abstract \(u.declaration)"
+          abstractProjections.append(i)
+        } else {
+          concreteProjections[u.declaration, default: []].append(i)
+        }
+      case let u as Bundle:
+        cs = [node(u.shape.erased)]; shape = "bundle \(u.variants)"
+      case is GenericParameter, is Struct, is Enum, is Trait, is MachineType, is Namespace,
+        is LiteralType, is Metakind:
+        break
+      default:
+        // A kind of type whose parts are not modelled is treated as an atom, which is only
+        // correct for proving: a refutation that involves such a type is not trusted.
+        unmodelled = true
+      }
+      children[i] = cs
+      shapes[i] = shape
+      return i
+    }
+    let a = node(lhs)
+    let b = node(rhs)
+    let factNodes = facts.map({ (l, r, w, c) in (node(l), node(r), w, c) })
+
+    // A projection `(T::$k).X` through a premise `$k : P<T>` that has not been discharged yet is
+    // equal to `(T::w).X`, where `w` is the witness that will discharge `$k`, if resolution of
+    // `P<T>` has a unique result in the environment in which `$k` will be discharged (the givens
+    // assumed before `$k`). Resolution is deterministic, so that is the witness eventually used.
+    //
+    // The environment of the discharge must be the same as the one used here: its givens must be
+    // closed, so that variables bound later cannot change which givens match. A projection that
+    // cannot be resolved this way is left as an atom, and a refutation that may depend on it is
+    // not trusted (search decides instead), so that the verdict does not depend on the context.
+    var resolvedPremises: [(Int, Int)] = []
+    var unresolvedPremises = false
+    var visibleValues = Set<WitnessExpression.Value>()
+    for g in groups.joined() { visibleValues.insert(expression(referringTo: g).value) }
+    func isPremiseProjection(_ u: AssociatedType) -> Bool {
+      switch u.qualification.value {
+      case .assumed: return true
+      case .reference: return !visibleValues.contains(u.qualification.value)
+      default: return false
+      }
+    }
+    for n in concreteProjections.values.joined() {
+      let u = program.types[nodes[n]] as! AssociatedType
+      if isPremiseProjection(u) { unresolvedPremises = true }
+    }
+    if unresolvedPremises && premiseResolutionDepth < 2 {
+      unresolvedPremises = false
+      premiseResolutionDepth += 1
+      defer { premiseResolutionDepth -= 1 }
+      for n in concreteProjections.values.joined() {
+        let u = program.types[nodes[n]] as! AssociatedType
+        if !isPremiseProjection(u) { continue }
+        unresolvedPremises = true
+        let position: Int
+        switch u.qualification.value {
+        case .assumed(let k):
+          guard let p = environment.givens.firstIndex(where: { (g) in
+            if case .assumed(k, _) = g { true } else { false }
+          }) else { continue }
+          position = p
+        case .reference where !visibleValues.contains(u.qualification.value):
+          // A using of a callee, whose premise is assumed with the same type and not discharged.
+          let q = program.types.reify(
+            u.qualification.type, applying: environment.substitutions, withVariables: .kept)
+          let ps = environment.givens.indices.filter({ (i) in
+            if case .assumed(_, let t) = environment.givens[i] {
+              program.types.reify(t, applying: environment.substitutions, withVariables: .kept) == q
+            } else { false }
+          })
+          guard let p = ps.uniqueElement else { continue }
+          position = p
+        default:
+          continue
+        }
+        let prefix = Array(environment.givens[..<position])
+        let q = program.types.reify(
+          u.qualification.type, applying: environment.substitutions, withVariables: .kept)
+        let closed = !q[.hasVariable] && prefix.allSatisfy({ (g) in
+          if case .assumed(_, let t) = g {
+            !program.types.reify(t, applying: environment.substitutions, withVariables: .kept)[.hasVariable]
+          } else { true }
+        })
+        if !closed { continue }
+        var env = ResolutionThread.Environment(
+          substitutions: environment.substitutions, givens: prefix,
+          nextGivenIdentifier: environment.nextGivenIdentifier)
+        env.log = []
+        let ts = summon(q, in: scopeOfUse, where: env, then: [], penalties: 0)
+        let rs = takeSummonResults(from: ts, in: scopeOfUse)
+        guard let r = rs.uniqueElement else { continue }
+        let v = program.types.reify(r.witness, applying: r.substitutions, withVariables: .kept)
+        if v.type[.hasVariable] || v.type[.hasError] { continue }
+        let m = node(demand(AssociatedType(declaration: u.declaration, qualification: v)).erased)
+        TyperCounters.bump("eqsolve.premises")
+        resolvedPremises.append((n, m))
+      }
+      unresolvedPremises = concreteProjections.values.joined().contains(where: { (n) in
+        let u = program.types[nodes[n]] as! AssociatedType
+        return isPremiseProjection(u) && !resolvedPremises.contains(where: { $0.0 == n })
+      })
+    }
+
+    // An abstract projection `(Self::P).X` is equal to `(T::w).X` if `w` is the only witness of a
+    // conformance to `P` among the givens of the scope whose type is `P<T>` with `T` equal to
+    // `Self` under the equalities of the scope. The rule is decided from the scope alone (not from
+    // the goal, nor from assumed givens), so that it is the same in every context and so that
+    // assuming more equalities never retracts a conclusion. It agrees with `v-abs-7.hylo` (one
+    // witness) and with `associated-type-inequality.hylo` (two witnesses: no merge).
+    var abstractBindings: [(Int, Int)] = []
+    if !abstractProjections.isEmpty && !TyperExperiments.abstractstrict {
+      let scopeFacts = factNodes.filter({ (f) in f.3 >= environment.givens.count })
+      var candidates: [(head: Int, abstraction: AnyTypeIdentity, witness: WitnessExpression)] = []
+      var ambiguous = Set<AnyTypeIdentity>()
+      var anyWildcard = false
+      for g in groups[environment.givens.count...].joined() {
+        let w = expression(referringTo: g)
+        if w.type[.hasError] || w.value == .abstract { continue }
+        let (c, h) = program.types.contextAndHead(w.type)
+        if c.parameters.contains(where: { (p) in p.erased == h }) { anyWildcard = true; continue }
+        guard let app = program.types[h] as? TypeApplication else { continue }
+        if !c.parameters.isEmpty || !c.usings.isEmpty || h[.hasVariable] {
+          ambiguous.insert(app.abstraction)
+          continue
+        }
+        candidates.append((node(h), app.abstraction, w))
+      }
+      var p0 = Array(nodes.indices)
+      func find0(_ x: Int) -> Int {
+        var x = x
+        while p0[x] != x { p0[x] = p0[p0[x]]; x = p0[x] }
+        return x
+      }
+      for (i, j, _, _) in scopeFacts { let (x, y) = (find0(i), find0(j)); if x != y { p0[x] = y } }
+      var changed = true
+      while changed {
+        changed = false
+        var table: [EqualitySignature: Int] = [:]
+        for q in nodes.indices where shapes[q] != nil {
+          let k = EqualitySignature(shape: shapes[q]!, children: children[q].map(find0))
+          if let r = table[k] {
+            let (x, y) = (find0(q), find0(r))
+            if x != y { p0[x] = y; changed = true }
+          } else {
+            table[k] = q
+          }
+        }
+      }
+      if !anyWildcard {
+        for x in abstractProjections {
+          let u = program.types[nodes[x]] as! AssociatedType
+          let q = children[x][0]
+          guard let app = program.types[nodes[q]] as? TypeApplication,
+            !ambiguous.contains(app.abstraction)
+          else { continue }
+          let cs = candidates.filter({ (c) in
+            c.abstraction == app.abstraction && find0(c.head) == find0(q)
+          })
+          guard let c = cs.uniqueElement else { continue }
+          let m = node(demand(AssociatedType(declaration: u.declaration, qualification: c.witness)).erased)
+          TyperCounters.bump("eqsolve.abstractBindings")
+          abstractBindings.append((x, m))
+        }
+      }
+    }
+
+    // Close under congruence, with a signature table and use lists (Nelson-Oppen).
+    var parent: [Int] = []
+    var uses: [[Int]] = []
+    var edges: [[EqualityEdge]] = []
+    func find(_ x: Int) -> Int {
+      var x = x
+      while parent[x] != x { parent[x] = parent[parent[x]]; x = parent[x] }
+      return x
+    }
+    do {
+      parent = Array(nodes.indices)
+      uses = Array(repeating: [], count: nodes.count)
+      edges = Array(repeating: [], count: nodes.count)
+      var table: [EqualitySignature: Int] = [:]
+      var pending: [(Int, Int)] = []
+
+      func signature(_ p: Int) -> EqualitySignature {
+        .init(shape: shapes[p]!, children: children[p].map(find))
+      }
+      func register(_ p: Int) {
+        let k = signature(p)
+        if let q = table[k] {
+          if find(q) != find(p) { pending.append((p, q)) }
+        } else {
+          table[k] = p
+        }
+      }
+      func union(_ x: Int, _ y: Int) {
+        var (i, j) = (find(x), find(y))
+        if i == j { return }
+        if uses[i].count > uses[j].count { swap(&i, &j) }
+        parent[i] = j
+        let moved = uses[i]
+        uses[i] = []
+        uses[j].append(contentsOf: moved)
+        for p in moved { register(p) }
+      }
+      func drain() {
+        while let (p, q) = pending.popLast() {
+          if find(p) == find(q) { continue }
+          edges[p].append(.init(target: q, proof: nil, reversed: false, cost: builtinCost))
+          edges[q].append(.init(target: p, proof: nil, reversed: false, cost: builtinCost))
+          union(p, q)
+        }
+      }
+
+      for p in nodes.indices where shapes[p] != nil {
+        for c in Set(children[p]) { uses[c].append(p) }
+      }
+      for p in nodes.indices where shapes[p] != nil { register(p) }
+      drain()
+      for (i, j) in resolvedPremises + abstractBindings {
+        pending.append((i, j))
+        drain()
+      }
+      for (i, j, w, c) in factNodes {
+        edges[i].append(.init(target: j, proof: w, reversed: false, cost: c + builtinCost))
+        edges[j].append(.init(target: i, proof: w, reversed: true, cost: c + 2 * builtinCost))
+        union(i, j)
+        drain()
+      }
+
+    }
+
+    if find(a) != find(b) && (unresolvedPremises || unmodelled) {
+      TyperCounters.bump("eqsolve.untrusted")
+      return .notApplicable
+    }
+    if find(a) != find(b) {
+      TyperCounters.bump("eqsolve.refuted")
+      if TyperExperiments.enabled.contains("trace") {
+        print("[trace] eqsolve refuted \(program.show(goal)) with facts " + facts.map({ (l, r, _, _) in "\(program.show(l)) ~ \(program.show(r))" }).joined(separator: ", "))
+        for n in concreteProjections.values.joined() {
+          let u = program.types[nodes[n]] as! AssociatedType
+          print("[trace]   projection \(program.show(nodes[n])) through \(program.show(u.qualification)) class \(find(n))")
+        }
+        print("[trace]   assumed: " + environment.givens.map({ (g) in if case .assumed(let j, let t) = g { "$\(j): \(program.show(t))" } else { "?" } }).joined(separator: ", "))
+      }
+      return .refuted
+    }
+
+    // Reconstruct a proof from a cheapest path (Dijkstra with a binary heap).
+    var distance = Array(repeating: Int.max, count: nodes.count)
+    var previous: [Int: (Int, EqualityEdge)] = [:]
+    var heap: [(Int, Int)] = [(0, a)]
+    distance[a] = 0
+    func less(_ l: (Int, Int), _ r: (Int, Int)) -> Bool { (l.0, l.1) < (r.0, r.1) }
+    func push(_ e: (Int, Int)) {
+      heap.append(e)
+      var i = heap.count - 1
+      while i > 0, less(heap[i], heap[(i - 1) / 2]) { heap.swapAt(i, (i - 1) / 2); i = (i - 1) / 2 }
+    }
+    func pop() -> (Int, Int) {
+      let top = heap[0]
+      let last = heap.removeLast()
+      if !heap.isEmpty {
+        heap[0] = last
+        var i = 0
+        while true {
+          let (l, r) = (2 * i + 1, 2 * i + 2)
+          var m = i
+          if l < heap.count && less(heap[l], heap[m]) { m = l }
+          if r < heap.count && less(heap[r], heap[m]) { m = r }
+          if m == i { break }
+          heap.swapAt(i, m); i = m
+        }
+      }
+      return top
+    }
+    while !heap.isEmpty {
+      let (dx, x) = pop()
+      if dx > distance[x] { continue }
+      if x == b { break }
+      for d in edges[x] {
+        let n = dx + d.cost
+        if n < distance[d.target] {
+          distance[d.target] = n
+          previous[d.target] = (x, d)
+          push((n, d.target))
+        }
+      }
+    }
+    var path: [(Int, Int, EqualityEdge)] = []
+    var x = b
+    while x != a {
+      let (p, d) = previous[x]!
+      path.append((p, x, d))
+      x = p
+    }
+    path.reverse()
+
+    var proof: WitnessExpression? = nil
+    for (p, q, d) in path {
+      let step = equalityStep(from: nodes[p], to: nodes[q], via: d)
+      proof = proof.map({ (w) in transitivityWitness(nodes[a], nodes[p], nodes[q], w, step) }) ?? step
+    }
+    TyperCounters.bump("eqsolve.proved")
+    return .proved(proof!, cost: distance[b] - builtinCost)
+  }
+
+  /// Returns the single resolution thread solving an open equality `?v ~ x` or `x ~ ?v`, where
+  /// `?v` is a unification variable that does not occur in `x`, by reflexivity, or `nil` if `t`
+  /// does not have that form.
+  ///
+  /// Binding `?v` to `x` is the most general solution: any other solution assigns `?v` to a type
+  /// equal to `x`, and the goals that remain are closed under equality (coercions transport them
+  /// along proved equalities), so the other solutions add nothing but ambiguity.
+  private mutating func mostGeneralEqualityThread(
+    _ t: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment,
+    then continuation: [ResolutionThread.ContinuationItem],
+    penalties: Int, ancestors: [AnyTypeIdentity]
+  ) -> [ResolutionThread]? {
+    let u = program.types.reify(t, applying: environment.substitutions, withVariables: .kept)
+    guard u[.hasVariable], let e = program.types.cast(u, to: EqualityWitness.self) else {
+      return nil
+    }
+    let (l, r) = (program.types[e].lhs, program.types[e].rhs)
+    let s = environment.substitutions
+    if l.isVariable && !program.types.occurs(l, in: r, under: s) {
+    } else if r.isVariable && !program.types.occurs(r, in: l, under: s) {
+    } else {
+      return nil
+    }
+    TyperCounters.bump("eqmgu.solved")
+    let builtinCost = environment.givens.count + givens(visibleFrom: scopeOfUse).count
+    let w = expression(referringTo: .coercion(.reflexivity))
+    return [
+      formThread(
+        matching: w, to: u, in: environment, then: continuation,
+        penalties: penalties + builtinCost, ancestors: ancestors)
+    ]
+  }
+
+  /// Returns a proof of `x ~ y` from an edge of the equality graph.
+  private mutating func equalityStep(
+    from x: AnyTypeIdentity, to y: AnyTypeIdentity, via d: EqualityEdge
+  ) -> WitnessExpression {
+    if let w = d.proof {
+      return d.reversed ? symmetryWitness(x, y, w) : w
+    } else {
+      // A congruence: coerce `x ~ x` to `x ~ y`, assuming the equalities of the parts, as `match`
+      // does when it assumes equalities between mismatching parts.
+      let r = reflexivityWitness(x)
+      let t = demand(EqualityWitness(lhs: x, rhs: y)).erased
+      let c = demand(EqualityWitness(lhs: r.type, rhs: t)).erased
+      return .init(value: .termApplication(.init(value: .builtin(.coercion), type: c), r), type: t)
+    }
+  }
+
+  /// Returns the instantiation of the built-in given `g` with `arguments`.
+  private mutating func builtinWitness(
+    _ g: EqualityProperty, _ arguments: [AnyTypeIdentity]
+  ) -> WitnessExpression {
+    let w = expression(referringTo: .coercion(g))
+    let u = program.types[UniversalType.ID(uncheckedFrom: w.type)]
+    let a = TypeArguments(mapping: u.parameters, to: arguments)
+    return .init(value: .typeApplication(w, a), type: program.types.substitute(a, in: u.head))
+  }
+
+  /// Returns `f` applied to `x`, where `f` is a witness of an implication.
+  private mutating func applied(_ f: WitnessExpression, to x: WitnessExpression) -> WitnessExpression {
+    if TyperExperiments.selfcheck {
+      if let i = program.types[f.type] as? Implication, let h = i.usings.first,
+        program.types.dealiased(h) == program.types.dealiased(x.type)
+      {
+        TyperCounters.bump("selfcheck.proofStep.confirmed")
+      } else {
+        selfCheckViolation(
+          "ill-typed proof step: \(program.show(f.type)) applied to \(program.show(x.type))")
+      }
+    }
+    return .init(
+      value: .termApplication(f, x),
+      type: program.types.dropFirstRequirement(.init(uncheckedFrom: f.type)))
+  }
+
+  /// Returns a proof of `x ~ x`.
+  private mutating func reflexivityWitness(_ x: AnyTypeIdentity) -> WitnessExpression {
+    builtinWitness(.reflexivity, [x])
+  }
+
+  /// Returns a proof of `y ~ x` given a proof `w` of `x ~ y`.
+  private mutating func symmetryWitness(
+    _ y: AnyTypeIdentity, _ x: AnyTypeIdentity, _ w: WitnessExpression
+  ) -> WitnessExpression {
+    applied(builtinWitness(.symmetry, [x, y]), to: w)
+  }
+
+  /// Returns a proof of `x ~ z` given proofs `p` of `x ~ y` and `q` of `y ~ z`.
+  private mutating func transitivityWitness(
+    _ x: AnyTypeIdentity, _ y: AnyTypeIdentity, _ z: AnyTypeIdentity,
+    _ p: WitnessExpression, _ q: WitnessExpression
+  ) -> WitnessExpression {
+    applied(applied(builtinWitness(.transitivity, [x, y, z]), to: p), to: q)
+  }
+
+  /// Returns `true` if `t` is an equality `a ~ b` that implicit resolution provably cannot derive
+  /// from the givens visible from `scopeOfUse` and those assumed in `environment`.
+  ///
+  /// Requires `fixsubst`: without it, resolution derives equalities that do not hold.
+  ///
+  /// The test computes the classes of the equivalence relation generated by the ground equality
+  /// givens in scope (and by unifiability between their sides) and refutes `a ~ b` when `a` and `b`
+  /// fall into different classes. It only applies when every side is an atom (a generic parameter,
+  /// an associated type, or a nominal or machine type without arguments), so that congruence cannot
+  /// relate two classes, and gives up if a given may derive an equality from its parameters (a
+  /// quantified equality or a bare-variable head) or if `t` has open variables.
+  private mutating func equalityIsRefuted(
+    _ t: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment
+  ) -> Bool {
+    let u = program.types.reify(t, applying: environment.substitutions, withVariables: .kept)
+    guard !u[.hasVariable], let e = program.types.cast(u, to: EqualityWitness.self) else {
+      return false
+    }
+
+    func atom(_ x: AnyTypeIdentity) -> AnyTypeIdentity? {
+      let y = program.types.dealiased(x)
+      if y[.hasVariable] || y[.hasError] { return nil }
+      switch program.types[y] {
+      case is GenericParameter, is AssociatedType, is Struct, is Enum, is Trait, is MachineType:
+        return y
+      default:
+        return nil
+      }
+    }
+    guard let a = atom(program.types[e].lhs), let b = atom(program.types[e].rhs) else {
+      return false
+    }
+    if a == b { return false }
+
+    // Collect the ground equality facts.
+    var facts: [(AnyTypeIdentity, AnyTypeIdentity)] = []
+    let gs = environment.givens + Array(givens(visibleFrom: scopeOfUse).joined())
+    for g in gs {
+      let w = declaredType(of: g)
+      if w[.hasError] { continue }
+      let (c, h) = program.types.contextAndHead(w)
+      if c.parameters.contains(where: { (p) in p.erased == h }) { return false }
+      guard let f = program.types.cast(h, to: EqualityWitness.self) else { continue }
+      if !c.parameters.isEmpty || !c.usings.isEmpty { return false }
+      guard let l = atom(program.types[f].lhs), let r = atom(program.types[f].rhs) else {
+        return false
+      }
+      facts.append((l, r))
+    }
+
+    // Union-find over atoms, merging the sides of facts and unifiable atoms.
+    var atoms = [a, b]
+    for (l, r) in facts { atoms.append(l); atoms.append(r) }
+    var parent: [AnyTypeIdentity: AnyTypeIdentity] = [:]
+    func find(_ x: AnyTypeIdentity) -> AnyTypeIdentity {
+      var x = x
+      while let p = parent[x], p != x { x = p }
+      return x
+    }
+    func union(_ x: AnyTypeIdentity, _ y: AnyTypeIdentity) {
+      let (i, j) = (find(x), find(y))
+      if i != j { parent[i] = j }
+    }
+    for (l, r) in facts { union(l, r) }
+    let distinct = Array(Set(atoms))
+    for i in distinct.indices {
+      for j in distinct.indices where j > i {
+        if program.types.unifiable(distinct[i], distinct[j]) != nil { union(distinct[i], distinct[j]) }
+      }
+    }
+    return find(a) != find(b)
+  }
+
+  /// Returns `true` if a value of type `t` (the type of a given or the extendee of an extension,
+  /// whose parameters are opened and whose context is ignored) may match `q` in `scopeOfUse`.
+  ///
+  /// The test over-approximates the match judgement of implicit resolution: the heads must unify
+  /// up to coercions that `canDeriveCoercions` does not rule out.
+  private mutating func mayMatch(
+    _ t: AnyTypeIdentity, _ q: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment = .empty
+  ) -> Bool {
+    if t[.hasError] || q[.hasError] { return false }
+    var x = t
+    while let u = program.types[x] as? UniversalType {
+      let a = TypeArguments(mapping: u.parameters, to: { _ in fresh().erased })
+      x = program.types.substitute(a, in: u.head)
+    }
+    let h = program.types.contextAndHead(x).head
+    let k = program.types.contextAndHead(q).head
+    var s = SubstitutionTable()
+    var coercions: [(AnyTypeIdentity, AnyTypeIdentity)] = []
+    let unified = program.types.unifiable(h, k, extending: &s) { (a, b) in
+      coercions.append((a, b))
+      return true
+    }
+    if !unified && coercions.isEmpty { return false }
+    for (a, b) in coercions {
+      let (a1, b1) = (
+        program.types.reify(a, applying: s, withVariables: .kept),
+        program.types.reify(b, applying: s, withVariables: .kept))
+      if !canDeriveCoercions(a1, b1, in: scopeOfUse, where: environment) { return false }
+    }
+    return true
+  }
+
+  /// Records that a lookup reached `e` while its extendee is being computed, which closes a cycle
+  /// of extendee computations: `e` and the extensions entered after it form a cycle group.
+  private mutating func noteExtensionCycle(through e: ExtensionDeclaration.ID) {
+    guard let i = extensionFrames.lastIndex(where: { (f) in f.declaration == e }) else { return }
+    let gs = Set(extensionFrames[i...].compactMap(\.group))
+    let g: Int
+    if let h = gs.min() { g = h } else { nextCycleGroup += 1; g = nextCycleGroup }
+    for k in extensionFrames.indices where k >= i || (extensionFrames[k].group.map(gs.contains) ?? false) {
+      extensionFrames[k].group = g
+    }
+    for h in gs where h != g {
+      if let x = cycleGroups.removeValue(forKey: h) {
+        cycleGroups[g, default: ([], [])].members.append(contentsOf: x.members)
+        cycleGroups[g, default: ([], [])].lookups.append(contentsOf: x.lookups)
+      }
+    }
+  }
+
+  /// Pops the innermost extension frame; if it is the last frame of its cycle group on the stack,
+  /// checks the group (`extorder`).
+  ///
+  /// The extendees of a cycle group depend on each other through member lookups. The group is
+  /// circular if one of these lookups may be affected by a member of the group that declares the
+  /// name looked up: whichever member is evaluated first, that lookup is made while the other's
+  /// extendee is unknown. The test uses the final extendees only, so its verdict does not depend on
+  /// the order in which the members were entered; otherwise the skips were exact.
+  private mutating func popExtensionFrame() {
+    let f = extensionFrames.removeLast()
+    guard let g = f.group else { return }
+    cycleGroups[g, default: ([], [])].members.append(f.declaration)
+    cycleGroups[g, default: ([], [])].lookups.append(contentsOf: f.lookups)
+    if extensionFrames.contains(where: { (x) in x.group == g }) { return }
+    let (members, lookups) = cycleGroups.removeValue(forKey: g)!
+    TyperCounters.bump("extorder.cycles")
+    var seen = Set<ExtensionDeclaration.ID>()
+    for m in members where seen.insert(m).inserted {
+      let u = extendeeType(m)
+      let names = declarations(lexicallyIn: .init(node: m))
+      for (q, s, n) in lookups where names[n.identifier] != nil && mayMatch(u, q, in: s) {
+        reportCircularExtension(m, lookingUp: n)
+        break
+      }
+    }
+  }
+
+  /// Records the givens that implicit resolution of `t` in `scopeOfUse` skips because the types
+  /// of their declarations are being computed (`givencheck`).
+  private mutating func recordSkippedGivens(
+    _ t: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment
+  ) {
+    func skipped(_ g: Given) -> DeclarationIdentity? {
+      switch g {
+      case .user(let d):
+        return declarationsOnStack.contains(d) && !contextUsingsOnStack.contains(d) ? d : nil
+      case .nested(_, let h):
+        return skipped(h)
+      default:
+        return nil
+      }
+    }
+    let u = program.types.reify(t, applying: environment.substitutions, withVariables: .kept)
+    var gs: [Given] = []
+    for s in program.scopes(from: scopeOfUse) { gs.append(contentsOf: givens(lexicallyIn: s)) }
+    for f in program[scopeOfUse.module].sourceFileIdentities where f != scopeOfUse.file {
+      gs.append(contentsOf: givens(lexicallyIn: .init(file: f)))
+    }
+    for g in gs {
+      if let d = skipped(g) { pendingGivenChecks.append((g, d, u, scopeOfUse, environment)) }
+    }
+  }
+
+  /// Checks the givens skipped by implicit resolution whose types are now known, reporting those
+  /// that would have been candidates for the resolution that skipped them (`givencheck`).
+  ///
+  /// Such a given has a type that depends on a resolution it may affect, so the program has no
+  /// reading independent of the order in which declarations are checked.
+  private mutating func checkPendingGivens() {
+    if checkingPendingGivens { return }
+    checkingPendingGivens = true
+    defer { checkingPendingGivens = false }
+    var remaining: [(Given, DeclarationIdentity, AnyTypeIdentity, ScopeIdentity, ResolutionThread.Environment)] = []
+    while let (g, d, q, s, e) = pendingGivenChecks.popLast() {
+      if declarationsOnStack.contains(d) { remaining.append((g, d, q, s, e)); continue }
+      if reportedCircularGivens.contains(d) { continue }
+      let w = expression(referringTo: g)
+      if mayMatch(w.type, q, in: s, where: e) {
+        reportedCircularGivens.insert(d)
+        TyperCounters.bump("givencheck.reported")
+        let m = "circular given: the type of this given depends on an implicit resolution of '\(program.show(q))' that it may satisfy"
+        report(.init(.error, m, at: program.spanForDiagnostic(about: d)))
+      }
+    }
+    pendingGivenChecks = remaining
+  }
+
+  /// Returns whether search derives `t` in `environment`, discharging the assumptions of
+  /// `environment`, with the pruning identified by `mode` disabled; `nil` if the search was
+  /// abandoned (`selfcheck`).
+  private mutating func searchDerives(
+    _ t: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment, verifying mode: SelfCheck
+  ) -> Bool? {
+    let saved = (selfCheck, selfCheckInconclusive)
+    selfCheck = mode
+    selfCheckInconclusive = false
+    defer { (selfCheck, selfCheckInconclusive) = saved }
+    var e = environment
+    e.log = []
+    // The premises that wait for a witness of the enclosing thread cannot be released here.
+    e.deferred = []
+    let ts = summon(t, in: scopeOfUse, where: e, then: [], penalties: 0)
+    let rs = takeSummonResults(from: ts, in: scopeOfUse)
+    if !rs.isEmpty { return true }
+    return selfCheckInconclusive ? nil : false
+  }
+
+  /// Reports that a pruning decision was contradicted by the work it avoided (`selfcheck`).
+  private mutating func selfCheckViolation(_ m: String) {
+    TyperCounters.bump("selfcheck.violations")
+    print("[selfcheck] VIOLATION: \(m)")
+  }
+
+  /// Reports that implicit resolution in `scopeOfUse` was abandoned (`budget`).
+  private mutating func reportResolutionBudgetExhausted(in scopeOfUse: ScopeIdentity) {
+    if !reportedBudgetScopes.insert(scopeOfUse).inserted { return }
+    let m = "implicit resolution is too complex: more than \(TyperExperiments.budgetLimit) candidate derivations; consider adding explicit type arguments or annotations"
+    if let n = scopeOfUse.node {
+      report(.init(.error, m, at: program.spanForDiagnostic(about: n)))
+    } else {
+      report(.init(.error, m, at: program[scopeOfUse.file].source.span))
+    }
+  }
+
+  /// Reports that the extendee of `e` depends on a lookup of `n`, which `e` may affect.
+  private mutating func reportCircularExtension(_ e: ExtensionDeclaration.ID, lookingUp n: Name) {
+    if !reportedCircularExtensions.insert(e).inserted { return }
+    let m = "circular extension: the extendee of this extension depends on a lookup of '\(n.identifier)', which this extension may affect"
+    report(.init(.error, m, at: program.spanForDiagnostic(about: e)))
+  }
+
   /// Returns `true` iff there is a declaration introducing an implicit that is being typed.
   private func hasImplicitOnStack() -> Bool {
-    declarationsOnStack.contains(where: program.isImplicit)
+    if TyperExperiments.stackscan {
+      if declarationsOnStack.isEmpty { return false }
+      for d in declarationsOnStack {
+        switch program.tag(of: d) {
+        case ConformanceDeclaration.self:
+          return true
+        case BindingDeclaration.self:
+          if program[castUnchecked(d, to: BindingDeclaration.self)].isImplicit { return true }
+        default:
+          continue
+        }
+      }
+      return false
+    }
+    return declarationsOnStack.contains(where: program.isImplicit)
   }
 
 }
