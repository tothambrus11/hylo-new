+  /// the same type (`f<A, A>()` for `f<T, U where T is P, U is P, …>`), and the verdict then
+  /// depends on the order of the where clause.
+  nonisolated(unsafe) public static var dedup: Bool = enabled.contains("dedup")
+
+  /// SEMANTIC FIX: the memoized result of an implicit resolution is not used while a given is
+  /// deliberately hidden (a conformance being checked against the traits it refines, a
+  /// requirement of a where clause being typed). Without it a conformance satisfies the trait it
+  /// refines with itself when a member has resolved that goal before.
+  nonisolated(unsafe) public static var hidecache: Bool = enabled.contains("hidecache")
+
+  /// SEMANTIC FIX (with `premsubst`): a requirement that another requirement mentions is proved
+  /// by the witness that resolving it alone gives; if that is ambiguous, the resolution fails.
+  /// Without it, the witness is chosen among all its derivations by whether the requirements that
+  /// mention it hold, so that a shadowed conformance can be selected.
+  nonisolated(unsafe) public static var premcommit: Bool = enabled.contains("premcommit")
+
+  /// SEMANTIC FIX: in a call, an associated type of a requirement of the callee that occurs in
+  /// the callee's parameters or result is the associated type of the witness passed for that
+  /// requirement (`pick<T where T is P>(t: T) -> T.X` applied to an `A` returns `A.X`).
+  nonisolated(unsafe) public static var headsubst: Bool = enabled.contains("headsubst")
+
+  /// Overload resolution: candidates of one overload set that have the same type share one
+  /// exploration (result-preserving).
+  nonisolated(unsafe) public static var twins: Bool = enabled.contains("twins")
+
+  /// Overload resolution: look for a solution without diagnostics first; run the existing search
+  /// only if there is none (result-preserving).
+  nonisolated(unsafe) public static var cleanfirst: Bool = enabled.contains("cleanfirst")
+
+  /// With `cleanfirst`: abandon a branch in which a pending goal is certain to fail
+  /// (result-preserving).
+  nonisolated(unsafe) public static var lookahead: Bool = enabled.contains("lookahead")
+
+  /// EXPERIMENT (accepts more programs): implicit resolution bounds the height of a derivation
+  /// (the nesting of premises) instead of its size (the number of givens used). Every derivation
+  /// found today is still found; larger ones of the same height are found as well.
+  nonisolated(unsafe) public static var heightbound: Bool = enabled.contains("heightbound")
+
+  /// The number of candidate matches that a resolution may try after the layer at which the size
+  /// bound would have stopped it (`heightbound`); past it the resolution fails, silently.
+  nonisolated(unsafe) public static var heightBudget: Int = {
+    guard let p = getenv("HYLO_TC_HEIGHTBUDGET") else { return 100_000 }
+    return Int(String(cString: p)) ?? 100_000
+  }()
+
+  /// EXPERIMENT (accepts more programs): a closed pair of types may be coerced if the equality
+  /// procedure proves them equal, even if they are not both written in an equality.
+  nonisolated(unsafe) public static var eqfilter: Bool = enabled.contains("eqfilter")
+
+  /// EXPERIMENT (accepts more programs): when the innermost mismatching parts of two types cannot
+  /// be coerced, the outermost enclosing parts that can be are used instead.
+  nonisolated(unsafe) public static var eqouter: Bool = enabled.contains("eqouter")
+
+  /// EXPERIMENT (accepts more programs): a mismatching part with unification variables is
+  /// instantiated with each type of its shape written in an equality that may be equal to the
+  /// other part, so that a generic given applies to a type equal to an instance of its head.
+  nonisolated(unsafe) public static var eqclass: Bool = enabled.contains("eqclass")
+
+  /// SEMANTIC FIX: the associated type `(Self::P).X` selected through the witness that a trait
+  /// or conformance declares is only equal to a selection through that same witness. Without it,
+  /// `Self.X` is equated with `T.X` for another witness `T is P` of a type equal to `Self`, which
+  /// converts `W.X` into `V.X` when `V == W` (compare `negative/associated-type-inequality`).
+  nonisolated(unsafe) public static var abstractstrict: Bool = enabled.contains("abstractstrict")
+
+  /// SEMANTIC FIX: the associated type read from a generic conformance is instantiated with the
+  /// type arguments of the witness (`Box<A>.X` is `A`, not the uninstantiated `T`).
+  nonisolated(unsafe) public static var assocsubst: Bool = enabled.contains("assocsubst")
+
+  /// Build the standard library's symbol table in a single pass over its syntax.
+  nonisolated(unsafe) public static var symindex: Bool = enabled.contains("symindex")
+
+  /// The truncation depth of the abstract model.
+  nonisolated(unsafe) public static var absDepth: Int = {
+    guard let p = getenv("HYLO_TC_ABSDEPTH") else { return 2 }
+    return Int(String(cString: p)) ?? 2
+  }()
+
+}
+
+/// A monotonic clock for research instrumentation.
+public enum TyperClock {
+
+  /// Returns the current time in milliseconds.
+  public static func now() -> Double {
+    var t = timespec()
+    clock_gettime(CLOCK_MONOTONIC, &t)
+    return Double(t.tv_sec) * 1e3 + Double(t.tv_nsec) / 1e6
+  }
+
+}
