+#if canImport(Glibc)
+import Glibc
+#elseif canImport(Darwin)
+import Darwin
+#elseif canImport(WASILibc)
+import WASILibc
+#endif
+
+/// Research instrumentation: event counters for the type checker.
+///
+/// Not thread-safe; only meaningful when a single module is typed at a time.
+public enum TyperCounters {
+
+  /// The values of the counters, indexed by name.
+  nonisolated(unsafe) public static var values: [String: Int] = [:]
+
+  /// `true` iff counting is enabled.
+  nonisolated(unsafe) public static var enabled = false
+
+  /// Increments the counter `k` by `n`.
+  @inline(__always)
+  public static func bump(_ k: StaticString, by n: Int = 1) {
+    if enabled { values["\(k)", default: 0] += n }
+  }
+
+  /// Resets all counters.
+  public static func reset() { values = [:] }
+
+  /// Returns a textual snapshot of the counters.
+  public static func snapshot() -> String {
+    values.sorted(by: { $0.key < $1.key }).map({ "\($0.key)=\($0.value)" }).joined(separator: " ")
+  }
+
+}
+
+/// Research flags enabling experimental optimizations, read from `HYLO_TC_EXPERIMENTS`
+/// (a comma-separated list, e.g. `names,unify,index,absmodel`).
+public enum TyperExperiments {
+
+  /// The set of enabled experiments.
+  nonisolated(unsafe) public static var enabled: Set<String> = {
+    guard let p = getenv("HYLO_TC_EXPERIMENTS") else { return [] }
+    return Set(String(cString: p).split(separator: ",").map(String.init))
+  }()
+
+  /// Name-filter extensions before checking whether they apply to a type.
+  nonisolated(unsafe) public static var names: Bool = enabled.contains("names")
+
+  /// Dispatch unification on type tags before casting.
+  nonisolated(unsafe) public static var unify: Bool = enabled.contains("unify")
+
+  /// Index givens by the head constructor of their conclusion.
+  nonisolated(unsafe) public static var index: Bool = enabled.contains("index")
+
+  /// Defer overload branching and prune choices by forward checking.
+  nonisolated(unsafe) public static var solver: Bool = enabled.contains("solver")
+
+  /// Prune resolution subgoals identical to one of their ancestors.
+  nonisolated(unsafe) public static var loopcheck: Bool = enabled.contains("loopcheck")
+
+  /// Refute queries using an abstract least model of the givens.
+  nonisolated(unsafe) public static var absmodel: Bool = enabled.contains("absmodel")
+
+  /// Index visible traits by the identifiers of the members they declare.
+  nonisolated(unsafe) public static var traitindex: Bool = enabled.contains("traitindex")
+
+  /// Skip extensions that do not declare the looked-up name when their applicability check is
+  /// known to fail without observable effects.
+  nonisolated(unsafe) public static var memberskip: Bool = enabled.contains("memberskip")
+
+  /// Remember which givens can never be used to derive a coercion.
+  nonisolated(unsafe) public static var coesrc: Bool = enabled.contains("coesrc")
+
+  /// Memoize coercion-derivability queries made under assumptions, keyed by the assumptions.
+  nonisolated(unsafe) public static var coercememo: Bool = enabled.contains("coercememo")
+
+  /// The maximum number of steps of implicit resolution (`HYLO_TC_MAXDEPTH`, default 10).
+  ///
+  /// Changing it changes the semantics; it exists to measure the sensitivity to the cap.
+  nonisolated(unsafe) public static var maxImplicitDepth: Int = {
+    guard let p = getenv("HYLO_TC_MAXDEPTH") else { return 10 }
+    return Int(String(cString: p)) ?? 10
+  }()
+
+  /// Keep the type store's trees in a contiguous array for projections.
+  nonisolated(unsafe) public static var typevec: Bool = enabled.contains("typevec")
+
+  /// SEMANTIC FIX: keep substitutions computed by `match` when it assumes coercions.
+  nonisolated(unsafe) public static var fixsubst: Bool = enabled.contains("fixsubst")
+
+  /// SEMANTIC FIX: occurs check in unification.
+  nonisolated(unsafe) public static var occurs: Bool = enabled.contains("occurs")
+
+  /// SEMANTIC FIX: evaluate extendees speculatively during member lookup, discarding results
+  /// computed across a cyclic reference.
+  nonisolated(unsafe) public static var cyclecut: Bool = enabled.contains("cyclecut")
+
+  /// With `cyclecut`, also treat lookups that skip an extension being typed as cycle cuts.
+  nonisolated(unsafe) public static var cyclecutStack: Bool = enabled.contains("cyclecutstack")
+
+  /// Refute equality goals outside the equivalence classes of the ground equalities in scope
+  /// (requires `fixsubst`).
+  nonisolated(unsafe) public static var eqrefute: Bool = enabled.contains("eqrefute")
+
+  /// SEMANTIC CHANGE: decide closed equality goals with a congruence closure instead of search
+  /// (meant to be used with `fixsubst` and `occurs`).
+  nonisolated(unsafe) public static var eqsolve: Bool = enabled.contains("eqsolve")
+
+  /// SEMANTIC FIX: member lookup only evaluates extensions declaring the name, and reports a lookup
+  /// that depends on an extension whose extendee is being computed.
+  nonisolated(unsafe) public static var extorder: Bool = enabled.contains("extorder")
+
+  /// SEMANTIC FIX: the environment of an arrow contributes to its type properties.
+  /// Variant of `eqsolve`: proofs found by the decision procedure carry the penalty search would
+  /// have given them (on by default with `eqsolve`; `eqsolvefree` turns it off).
+  nonisolated(unsafe) public static var eqsolveCost: Bool = !enabled.contains("eqsolvefree")
+
+  /// Variant of `absmodel`: ground equality givens make the types they relate opaque (`⊤`)
+  /// instead of making the model inconclusive.
+  nonisolated(unsafe) public static var absquotient: Bool = enabled.contains("absquotient")
+
+  /// SEMANTIC FIX: abandon (and report) an implicit resolution whose frontier exceeds
+  /// `budgetLimit` threads (`HYLO_TC_BUDGET`, default 100000) instead of exhausting memory.
+  nonisolated(unsafe) public static var budget: Bool = enabled.contains("budget")
+
+  /// The frontier size above which `budget` abandons a resolution.
+  nonisolated(unsafe) public static var budgetLimit: Int = {
+    guard let p = getenv("HYLO_TC_BUDGET") else { return 100_000 }
+    return Int(String(cString: p)) ?? 100_000
+  }()
+
+  /// Memoize the reification of subterms within one call to `TypeStore.reify`.
+  nonisolated(unsafe) public static var reifymemo: Bool = enabled.contains("reifymemo")
+
+  /// Verification mode: every pruning decision is checked by doing the work it avoided.
+  nonisolated(unsafe) public static var selfcheck: Bool = enabled.contains("selfcheck")
+
+  /// Prints one line per implicit resolution describing its size and outcome.
+  nonisolated(unsafe) public static var census: Bool = enabled.contains("census")
+
+  /// Keep the index of givens in scopes whose coercion sources are ground equalities.
+  nonisolated(unsafe) public static var eqindex: Bool = enabled.contains("eqindex")
+
+  /// Decide the equalities between closed mismatching parts inside `match` instead of assuming
+  /// them and proving them by search (requires `eqsolve` and `fixsubst`).
+  nonisolated(unsafe) public static var eqeager: Bool = enabled.contains("eqeager")
+
+  nonisolated(unsafe) public static var arrowenv: Bool = enabled.contains("arrowenv")
+
+  /// SEMANTIC FIX: an open equality goal `?v ~ X` (?v not in X) is solved only by its most
+  /// general unifier `?v := X` (meant to be used with `eqsolve`).
+  nonisolated(unsafe) public static var eqmgu: Bool = enabled.contains("eqmgu")
+
+  /// SEMANTIC FIX: a given skipped because its type is being computed is checked afterwards; if
+  /// it would have been a candidate, the program is rejected (circular given).
+  nonisolated(unsafe) public static var givencheck: Bool = enabled.contains("givencheck")
+
+  /// SEMANTIC FIX: the signatures of extensions and givens are computed in rounds before anything
+  /// else; lookups and resolutions read them from the previous round only (replaces `givencheck`
+  /// and the cycle rule of `extorder`).
+  nonisolated(unsafe) public static var sigrounds: Bool = enabled.contains("sigrounds")
+
+  /// SEMANTIC FIX: a requirement that mentions another requirement of the same clause is proved
+  /// after it, with the witness found for it substituted into its type.
+  nonisolated(unsafe) public static var premsubst: Bool = enabled.contains("premsubst")
+
+  /// Decide whether two closed types may be coerced by looking them up in the set of the sides of
+  /// the equalities in scope, instead of comparing them with every given (result-preserving).
+  nonisolated(unsafe) public static var coeset: Bool = enabled.contains("coeset")
+
+  /// Test whether a given is being typed without copying the program (result-preserving). The
+  /// existing test forms a closure that captures a copy of the whole program value.
+  nonisolated(unsafe) public static var stackscan: Bool = enabled.contains("stackscan")
+
+  /// SEMANTIC FIX: a member selected on a value whose type is an alias of an instance of a
+  /// generic type is instantiated with the type arguments of that instance. Without it the
+  /// member keeps the type's own parameter, and `a.f(b.g())` is accepted for `a: A<Void>` and
+  /// `b: A<K>` written through aliases.
