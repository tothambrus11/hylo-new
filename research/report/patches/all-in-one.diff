+  // MARK: Experiments: indexed and refuted implicit resolution
+
+  /// The givens visible from a scope, indexed by the head constructor of their conclusion.
+  internal struct GivenIndex {
+
+    /// A given together with the offset of its group in `givens(visibleFrom:)` and its position
+    /// in the flattened sequence of visible givens.
+    typealias Entry = (group: Int, position: Int, given: Given)
+
+    /// The givens whose conclusion is headed by a nominal constructor, by constructor.
+    var byHead: [AnyTypeIdentity: [Entry]] = [:]
+
+    /// The givens whose conclusion has no nominal head (they may match anything).
+    var wildcards: [Entry] = []
+
+    /// All visible givens, in order.
+    var all: [Entry] = []
+
+    /// The givens that may be used to derive a coercion (i.e., `T ~ U` or `<T> T` heads).
+    var coercionSources: [Given] = []
+
+    /// `true` iff every coercion source is a ground equality neither side of which is a type
+    /// constructor taking arguments (`eqindex`).
+    ///
+    /// A given whose head constructor differs from a goal's can then only match by coercing the
+    /// pair of constructors, which no such equality allows, so the index remains valid.
+    var coercionSourcesAreRigid = true
+
+    /// `true` iff the head of some given is a type alias; `match` may then coerce the whole type
+    /// of that given to a goal with another head.
+    var hasAliasHead = false
+
+    /// The number of groups.
+    var groupCount: Int = 0
+
+    /// Returns the entries whose conclusion may match a type headed by `k`, in order.
+    func candidates(headedBy k: AnyTypeIdentity?) -> [Entry] {
+      guard let k else { return all }
+      let xs = byHead[k] ?? []
+      if wildcards.isEmpty { return xs }
+      if xs.isEmpty { return wildcards }
+      return (xs + wildcards).sorted(by: { (a, b) in a.position < b.position })
+    }
+
+  }
+
+  /// Returns the nominal constructor heading `t`, if any.
+  private func nominalHead(_ t: AnyTypeIdentity) -> AnyTypeIdentity? {
+    if t.isVariable { return nil }
+    switch program.types[t] {
+    case is Struct, is Enum, is Trait, is MachineType:
+      return t
+    case let u as TypeApplication:
+      switch program.types[u.abstraction] {
+      case is Struct, is Enum, is Trait: return u.abstraction
+      default: return nil
+      }
+    case let u as TypeAlias:
+      return nominalHead(u.aliasee)
+    default:
+      return nil
+    }
+  }
+
+  /// Returns the index of the givens visible from `scopeOfUse`, or `nil` if it can't be computed
+  /// because some declarations are being typed.
+  internal mutating func givenIndex(visibleFrom scopeOfUse: ScopeIdentity) -> GivenIndex? {
+    if !declarationsOnStack.isEmpty || settlingSignatures {
+      TyperCounters.bump("index.unavailable")
+      return nil
+    }
+    if givens(lexicallyIn: scopeOfUse).isEmpty, let p = program.parent(containing: scopeOfUse) {
+      return givenIndex(visibleFrom: p)
+    }
+    if let ix = cache.scopeToGivenIndex[scopeOfUse] { return ix }
+
+    var ix = GivenIndex()
+    let groups = givens(visibleFrom: scopeOfUse)
+    ix.groupCount = groups.count
+    var position = 0
+    for (o, gs) in groups.enumerated() {
+      for g in gs {
+        let e: GivenIndex.Entry = (o, position, g)
+        position += 1
+        ix.all.append(e)
+        let gt = declaredType(of: g)
+        let (context, head) = program.types.contextAndHead(gt)
+        if program.types[head] is TypeAlias { ix.hasAliasHead = true }
+        if context.parameters.contains(where: { (p) in p.erased == head })
+          || program.types.isEquality(head)
+        {
+          ix.coercionSources.append(g)
+          if !isGroundEquality(gt) || hasConstructorSide(head) { ix.coercionSourcesAreRigid = false }
+        }
+        if let k = nominalHead(head) {
+          ix.byHead[k, default: []].append(e)
+        } else {
+          ix.wildcards.append(e)
+        }
+      }
+    }
+
+    if declarationsOnStack.isEmpty {
+      cache.scopeToGivenIndex[scopeOfUse] = ix
+    }
+    return ix
+  }
+
+  /// Returns the abstract model of the givens visible from `scopeOfUse`, or `nil` if it can't be
+  /// computed because some declarations are being typed.
+  internal mutating func abstractModel(
+    visibleFrom scopeOfUse: ScopeIdentity
+  ) -> AbstractResolutionModel? {
+    if !declarationsOnStack.isEmpty || settlingSignatures { return nil }
+    if givens(lexicallyIn: scopeOfUse).isEmpty, let p = program.parent(containing: scopeOfUse) {
+      return abstractModel(visibleFrom: p)
+    }
+    if let m = cache.scopeToAbstractModel[scopeOfUse] { return m }
+
+    // Fix (`absquotient`): ground equalities make coercions possible, which the syntactic model
+    // cannot see. Instead of giving up, abstract every type that is equal to another one as `⊤`;
+    // two types equal in the theory then have unifiable abstractions.
+    if TyperExperiments.absquotient, let o = equalityOpaqueTypes(visibleFrom: scopeOfUse) {
+      var m = AbstractResolutionModel(depth: TyperExperiments.absDepth)
+      m.opaque = o
+      for g in givens(visibleFrom: scopeOfUse).joined() {
+        let gt = declaredType(of: g)
+        if isGroundEquality(gt) { continue }
+        m.add(abstractClause(of: gt, opaque: o))
+      }
+      m.saturate()
+      TyperCounters.bump("absmodel.quotient")
+      if m.isInconclusive { TyperCounters.bump("absmodel.inconclusive") }
+      if declarationsOnStack.isEmpty { cache.scopeToAbstractModel[scopeOfUse] = m }
+      return m
+    }
+
+    // The givens visible from `scopeOfUse` are those of its lexical parent plus those declared
+    // in `scopeOfUse`. Since least models are monotonic, start from the parent's model.
+    var m: AbstractResolutionModel
+    var local: [Given]
+    let parentModel = program.parent(containing: scopeOfUse).flatMap({ (p) in
+      abstractModel(visibleFrom: p)
+    })
+    if let n = parentModel, n.opaque.isEmpty {
+      m = n
+      local = givens(lexicallyIn: scopeOfUse).filter(notOnStack(_:))
+    } else if program.parent(containing: scopeOfUse) == nil, let n = cache.moduleToAbstractModel[
+      .init(module: scopeOfUse.module, imports: imports(of: scopeOfUse.file))]
+    {
+      // Files of a module importing the same modules see the same set of givens.
+      cache.scopeToAbstractModel[scopeOfUse] = n
+      return n
+    } else {
+      m = AbstractResolutionModel(depth: TyperExperiments.absDepth)
+      local = Array(givens(visibleFrom: scopeOfUse).joined())
+    }
+    let start = TyperCounters.enabled ? TyperClock.now() : 0
+    let firstNew = m.clauses.count
+    for g in local {
+      let gt = declaredType(of: g)
+      m.add(abstractClause(of: gt))
+    }
+    m.saturate(from: firstNew)
+    if TyperCounters.enabled {
+      TyperCounters.bump("absmodel.built")
+      TyperCounters.bump("absmodel.facts", by: m.factCount)
+      TyperCounters.bump("absmodel.work", by: m.work)
+      TyperCounters.bump("absmodel.micros", by: Int((TyperClock.now() - start) * 1000))
+      if m.isInconclusive { TyperCounters.bump("absmodel.inconclusive") }
+    }
+
+    if declarationsOnStack.isEmpty {
+      cache.scopeToAbstractModel[scopeOfUse] = m
+      if program.parent(containing: scopeOfUse) == nil {
+        let k = Memos.FileModelKey(module: scopeOfUse.module, imports: imports(of: scopeOfUse.file))
+        cache.moduleToAbstractModel[k] = m
+      }
+    }
+    return m
+  }
+
+  /// Returns the Horn clause abstracting a given of type `t`.
+  private func abstractClause(
+    of t: AnyTypeIdentity, opaque: Set<AbstractResolutionModel.Key> = []
+  ) -> AbstractResolutionModel.Clause {
+    let (context, head) = program.types.contextAndHead(t)
+    var bound: [GenericParameter.ID: Int] = [:]
+    for (i, p) in context.parameters.enumerated() { bound[p] = i }
+    var vs: [AnyTypeIdentity: Int] = [:]
+    let h = program.types.abstraction(of: head, binding: bound, variables: &vs, opaque: opaque)
+    // Premises that are themselves quantified or conditional are dropped (over-approximation).
+    let ps = context.usings.compactMap { (u) -> AbstractResolutionModel.Term? in
+      program.types.hasContext(u)
+        ? nil : program.types.abstraction(of: u, binding: bound, variables: &vs, opaque: opaque)
+    }
+    return .init(head: h, premises: ps)
+  }
+
+  /// Returns `true` iff a side of the equality `e` is a trait or a generic type constructor
+  /// without its arguments.
+  private mutating func hasConstructorSide(_ e: AnyTypeIdentity) -> Bool {
+    guard let w = program.types[e] as? EqualityWitness else { return true }
+    for side in [w.lhs, w.rhs] {
+      switch program.types[program.types.dealiased(side)] {
+      case is Trait:
+        return true
+      case let u as Struct:
+        if !program[u.declaration].parameters.isEmpty { return true }
+      case let u as Enum:
+        if !program[u.declaration].parameters.isEmpty { return true }
+      default:
+        continue
+      }
+    }
+    return false
+  }
+
+  /// Returns `true` iff `t` is the type of a given asserting an equality between closed types.
+  private func isGroundEquality(_ t: AnyTypeIdentity) -> Bool {
+    let (c, h) = program.types.contextAndHead(t)
+    return c.parameters.isEmpty && c.usings.isEmpty && !h[.hasVariable]
+      && program.types.isEquality(h)
+  }
+
+  /// Returns the term constructors of the types that belong to a non-trivial class of the
+  /// congruence closure of the ground equality givens visible from `scopeOfUse`, or `nil` if there
+  /// are no such givens or if a given may derive other equalities (in which case the abstract
+  /// model gives up).
+  ///
+  /// Opacity is per constructor, not per type: a type outside the equalities can be congruent to a
+  /// member of a non-trivial class (`Box<Z>` with `Z == X` and `Box<X> == Opt<Y>`), and so can an
+  /// instance of a clause with variables. Erasing every application of such a constructor is a
+  /// substitution-compatible abstraction under which equal types have unifiable images.
+  ///
+  /// The closure is computed over the subterms of the equalities, merging the abstract and
+  /// concrete projections of an associated type freely; more merges only make more constructors
+  /// opaque.
+  private mutating func equalityOpaqueTypes(
+    visibleFrom scopeOfUse: ScopeIdentity
+  ) -> Set<AbstractResolutionModel.Key>? {
+    var facts: [(AnyTypeIdentity, AnyTypeIdentity)] = []
+    for g in givens(visibleFrom: scopeOfUse).joined() {
+      let gt = declaredType(of: g)
+      if gt[.hasError] { continue }
+      let h = program.types.contextAndHead(gt).head
+      guard let e = program.types.cast(h, to: EqualityWitness.self) else { continue }
+      if !isGroundEquality(gt) { return nil }
+      facts.append((program.types[e].lhs, program.types[e].rhs))
+    }
+    if facts.isEmpty { return nil }
+
+    var nodes: [AnyTypeIdentity] = []
+    var index: [AnyTypeIdentity: Int] = [:]
+    var children: [[Int]] = []
+    var shapes: [String?] = []
+    func node(_ x: AnyTypeIdentity) -> Int {
+      let y = program.types.dealiased(x)
+      if let i = index[y] { return i }
+      let i = nodes.count
+      nodes.append(y); index[y] = i; children.append([]); shapes.append(nil)
+      var cs: [Int] = []
+      var shape: String? = nil
+      switch program.types[y] {
+      case let u as TypeApplication:
+        cs = [node(u.abstraction)] + u.arguments.values.map({ (a) in node(a) }); shape = "app"
+      case let u as Tuple:
+        if case .cons(let h, let r) = u { cs = [node(h), node(r)]; shape = "cons" }
+      case let u as Metatype:
+        cs = [node(u.inhabitant)]; shape = "meta"
+      case let u as EqualityWitness:
+        cs = [node(u.lhs), node(u.rhs)]; shape = "eq"
+      case let u as AssociatedType:
+        cs = [node(u.qualification.type)]; shape = "assoc \(u.declaration)"
+      default:
+        break
+      }
+      children[i] = cs; shapes[i] = shape
+      return i
+    }
+    let pairs = facts.map({ (l, r) in (node(l), node(r)) })
+    var parent = Array(nodes.indices)
+    func find(_ x: Int) -> Int {
+      var x = x
+      while parent[x] != x { parent[x] = parent[parent[x]]; x = parent[x] }
+      return x
+    }
+    for (i, j) in pairs { let (x, y) = (find(i), find(j)); if x != y { parent[x] = y } }
+    var changed = true
+    while changed {
+      changed = false
+      var table: [EqualitySignature: Int] = [:]
+      for p in nodes.indices where shapes[p] != nil {
+        let k = EqualitySignature(shape: shapes[p]!, children: children[p].map(find))
+        if let q = table[k] {
+          let (x, y) = (find(p), find(q))
+          if x != y { parent[x] = y; changed = true }
+        } else {
+          table[k] = p
+        }
+      }
+    }
+    var size: [Int: Int] = [:]
+    for i in nodes.indices { size[find(i), default: 0] += 1 }
+    var result = Set<AbstractResolutionModel.Key>()
+    func insertHead(_ t: AnyTypeIdentity) {
+      var vs: [AnyTypeIdentity: Int] = [:]
+      if let k = program.types.abstraction(of: t, binding: [:], variables: &vs).key {
+        result.insert(k)
+      }
+    }
+    for i in nodes.indices where size[find(i)]! > 1 { insertHead(nodes[i]) }
+    for (l, r) in facts { insertHead(l); insertHead(r) }
+    return result
+  }
