+  /// Returns whether search derives `t` in `environment`, discharging the assumptions of
+  /// `environment`, with the pruning identified by `mode` disabled; `nil` if the search was
+  /// abandoned (`selfcheck`).
+  private mutating func searchDerives(
+    _ t: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment, verifying mode: SelfCheck
+  ) -> Bool? {
+    let saved = (selfCheck, selfCheckInconclusive)
+    selfCheck = mode
+    selfCheckInconclusive = false
+    defer { (selfCheck, selfCheckInconclusive) = saved }
+    var e = environment
+    e.log = []
+    let ts = summon(t, in: scopeOfUse, where: e, then: [], penalties: 0)
+    let rs = takeSummonResults(from: ts, in: scopeOfUse)
+    if !rs.isEmpty { return true }
+    return selfCheckInconclusive ? nil : false
+  }
+
+  /// Reports that a pruning decision was contradicted by the work it avoided (`selfcheck`).
+  private mutating func selfCheckViolation(_ m: String) {
+    TyperCounters.bump("selfcheck.violations")
+    print("[selfcheck] VIOLATION: \(m)")
+  }
