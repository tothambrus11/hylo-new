+  /// Returns `true` iff matching may assume that `x` and `y` are equal and prove it afterwards.
+  private mutating func mayCoerce(
+    _ x: AnyTypeIdentity, _ y: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment
+  ) -> Bool {
+    if canDeriveCoercions(x, y, in: scopeOfUse, where: environment) { return true }
+
+    // Experiment (`eqfilter`): the test above requires each type to be written in an equality;
+    // a closed pair that the equality procedure proves is as good.
+    if TyperExperiments.eqfilter && TyperExperiments.eqsolve && (selfCheck != .equality)
+      && !x[.hasVariable] && !y[.hasVariable] && !x[.hasError] && !y[.hasError]
+    {
+      let s = environment.substitutions
+      let e = demand(
+        EqualityWitness(
+          lhs: program.types.reify(x, applying: s, withVariables: .kept),
+          rhs: program.types.reify(y, applying: s, withVariables: .kept))
+      ).erased
+      if case .proved = solveEquality(e, in: scopeOfUse, where: environment) {
+        TyperCounters.bump("eqfilter.admitted")
+        return true
+      }
+    }
+    return false
+  }
+
+  /// Returns the outermost pairs of corresponding parts of `x` and `y` that differ and may be
+  /// coerced, or `nil` if some difference between `x` and `y` is in no such pair (`eqouter`).
+  ///
+  /// The pair `(x, y)` itself is not a candidate if `atRoot` is `true`: matching never coerces
+  /// the whole type of a witness to the whole goal.
+  private mutating func outerParts(
+    _ x: AnyTypeIdentity, _ y: AnyTypeIdentity, atRoot: Bool = false, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment
+  ) -> [(AnyTypeIdentity, AnyTypeIdentity)]? {
+    if x == y { return [] }
+    if !atRoot && !x[.hasVariable] && !y[.hasVariable]
+      && mayCoerce(x, y, in: scopeOfUse, where: environment)
+    {
+      return [(x, y)]
+    }
+
+    var xs: [AnyTypeIdentity] = []
+    var ys: [AnyTypeIdentity] = []
+    switch (program.types[x], program.types[y]) {
+    case (let t as TypeApplication, let u as TypeApplication):
+      if (t.abstraction != u.abstraction)
+        || (Array(t.arguments.parameters) != Array(u.arguments.parameters))
+      { return nil }
+      (xs, ys) = (Array(t.arguments.values), Array(u.arguments.values))
+    case (.cons(let h0, let t0) as Tuple, .cons(let h1, let t1) as Tuple):
+      (xs, ys) = ([h0, t0], [h1, t1])
+    default:
+      return nil
+    }
+
+    var result: [(AnyTypeIdentity, AnyTypeIdentity)] = []
+    for (a, b) in zip(xs, ys) {
+      guard let ps = outerParts(a, b, in: scopeOfUse, where: environment) else { return nil }
+      result.append(contentsOf: ps)
+    }
+    return result
+  }
+
+  /// Returns the types written as a side of a closed equality that is assumed in `environment`
+  /// or given in `scopeOfUse`.
+  private mutating func equalitySides(
+    visibleFrom scopeOfUse: ScopeIdentity, where environment: ResolutionThread.Environment
+  ) -> [AnyTypeIdentity] {
+    let sources: [Given]
+    if TyperExperiments.index, let ix = givenIndex(visibleFrom: scopeOfUse) {
+      sources = ix.coercionSources
+    } else {
+      sources = Array(givens(visibleFrom: scopeOfUse).joined())
+    }
+    var sides: [AnyTypeIdentity] = []
+    for g in chain(environment.givens, sources) {
+      let t = program.types.reify(
+        declaredType(of: g), applying: environment.substitutions, withVariables: .kept)
+      if let e = program.types[t] as? EqualityWitness, !t[.hasVariable], !t[.hasError] {
+        for s in [e.lhs, e.rhs] where !sides.contains(s) { sides.append(s) }
+      }
+    }
+    return sides
+  }
+
+  /// Returns the threads that continue `thread` after instantiating the side of `part` that has
+  /// unification variables with each type written in an equality of the context that it unifies
+  /// with and that may be equal to the other side, or `nil` if `part` does not have exactly one
+  /// side with variables (`eqclass`).
+  ///
+  /// A given such as `<X> Box<X> is P` does not match the goal `P<T>` when `T == Box<U>` is
+  /// known: the mismatching part is `(Box<%x>, T)`, and no equality is written about `Box<%x>`.
+  /// Instantiating `%x` so that `Box<%x>` is the written type `Box<U>` leaves the closed part
+  /// `(Box<U>, T)`, which the next match assumes and proves as usual. Nothing is accepted without
+  /// that proof; the instances only add candidates.
+  private mutating func instantiatedThroughEqualities(
+    _ thread: ResolutionThread, part: (AnyTypeIdentity, AnyTypeIdentity),
+    keeping substitutions: SubstitutionTable, in scopeOfUse: ScopeIdentity
+  ) -> [ResolutionThread]? {
+    let s0 = thread.environment.substitutions.union(substitutions)
+    let x = program.types.reify(part.0, applying: s0, withVariables: .kept)
+    let y = program.types.reify(part.1, applying: s0, withVariables: .kept)
+    let (pattern, closed): (AnyTypeIdentity, AnyTypeIdentity)
+    if x[.hasVariable] && !y[.hasVariable] {
+      (pattern, closed) = (x, y)
+    } else if y[.hasVariable] && !x[.hasVariable] {
+      (pattern, closed) = (y, x)
+    } else {
+      return nil
+    }
+    if pattern.isVariable || pattern[.hasError] || closed[.hasError] { return nil }
+
+    var result: [ResolutionThread] = []
+    for m in equalitySides(visibleFrom: scopeOfUse, where: thread.environment) where m != closed {
+      var s = SubstitutionTable()
+      let unified = program.types.unifiable(pattern, m, extending: &s) { (_, _) in false }
+      if !unified || !mayCoerce(m, closed, in: scopeOfUse, where: thread.environment) { continue }
+      let all = s0.union(s)
+      let w = program.types.reify(thread.witness, applying: all, withVariables: .kept)
+      if w.type[.hasError] { continue }
+      let e = thread.environment.with(substitutions: all, givens: thread.environment.givens)
+      result.append(thread.copy(matching: w, to: thread.queried, in: e))
+      TyperCounters.bump("eqclass.instances")
+    }
+    return result
+  }
+
