//! stage:typing no-std
// Question 11. `T is P` for a nest of four pairs needs 9 givens: within the bound of ten.
trait P {}
struct A {}
struct Pair<X, Y> {}
given A is P {}
given <X, Y where X is P, Y is P> => Pair<X, Y> is P {}
fun need<T where T is P>() {}
public fun main() { need<Pair<A, Pair<A, Pair<A, Pair<A, A>>>>>() }
