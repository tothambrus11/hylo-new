//! stage:typing no-std
// Question 8. In `main`, the local conformance shadows the module's, so `A.X` is `C`, and `C` is
// not `Q`. Is `f<A>()` rejected (the requirement `T is P` gets the witness that resolving it
// alone gives), or accepted through the module's conformance, for which `T.X is Q` holds?
trait P { type X }
trait Q {}
struct A {}
struct B {}
struct C {}
given B is Q {}
given A is P { type X = B }
fun f<T where T is P, T.X is Q>() {}
public fun main() {
  given A is P { type X = C }
  f<A>()
}
