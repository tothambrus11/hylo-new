//! stage:typing no-std
// Question 5. How does a trait state an equality between its associated types?
// Swift: `associatedtype Iterator: IteratorProtocol where Iterator.Element == Element`.
trait IteratorProtocol { type Element }
trait Sequence {
  type Element
  type Iterator
  given Iterator is IteratorProtocol
  given Iterator.Element == Element
}
fun need<A, B where A == B>() {}
fun f<S where S is Sequence>() { need<S.Iterator.Element, S.Element>() }
