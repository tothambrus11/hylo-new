//! stage:typing no-std
// Follow-up to question 2. As r2b, with a value of the right type: accepted.
trait P {
  type X
  fun cast<T where T == Self>(x: T.X) -> X { x }
}
struct A { public memberwise init }
struct B { public memberwise init }
given A is P { type X = B }
fun top(a: A, b: B) -> B { a.cast<A>(b) }
