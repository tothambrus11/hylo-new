//! stage:typing no-std
// Follow-up to question 2. `A` has two conformances to `P`: the module's, where `A.X` is `B`,
// and one local to `h`, where `A.X` is `C`. In `h`, the receiver `s` carries the conformance
// chosen by the caller (the module's, in `top`), and `T is P` is satisfied by the local one.
// If `cast` is well typed, `top` returns as a `B` the `C` that it was given.
// Which line is the error?
trait P {
  type X
  fun cast<T where T == Self, T is P>(x: T.X) -> X { x }   // (1) a `T.X` returned as a `Self.X`
}
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
given A is P { type X = B }
fun h<S where S is P, S == A>(s: S, c: C) -> S.X {
  given A is P { type X = C }
  return s.cast<A>(c)                                      // (2) `T is P` is the local conformance
}
fun top(a: A, c: C) -> B { h<A>(a, c) }                    // (3) `S is P` is the module's
