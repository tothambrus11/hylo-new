//! stage:typing no-std
// Follow-up to question 2. The same program without the requirement `T is P`: the only proof of
// `T is P` is the trait's own witness, transported along `T == Self`, so `T.X` is `Self.X`.
// `cast` is accepted, and the call in `h` is rejected: a `C` is not an `S.X`.
trait P {
  type X
  fun cast<T where T == Self>(x: T.X) -> X { x }
}
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
given A is P { type X = B }
fun h<S where S is P, S == A>(s: S, c: C) -> S.X {
  given A is P { type X = C }
  return s.cast<A>(c)
}
fun top(a: A, c: C) -> B { h<A>(a, c) }
