//! c3 without the cycle (S<T> replaced by T): T := anything, accepted.
trait P { type X }
trait P3<B, C> {}
trait R {}
struct M {}
struct Z {}
given <U> => U is P3<U, M> {}
fun needR<T where T is R>() {}
fun f<A where A is P, A.X == M>() {
  given <T where T is P3<T, A.X>> => Z is R {}
  needR<Z>()
}
