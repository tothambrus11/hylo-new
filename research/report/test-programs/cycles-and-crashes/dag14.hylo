//! stage:typing no-std
// Doubling chain of tuple types: a_k == {a_(k-1), a_(k-1)} (DAG-shaped, size 2^n as a tree).
fun same<T>(x: T, y: T) {}
public fun main() {
  let f = fun[](a0: Void, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14) { same(a1, (a0, a0)); same(a2, (a1, a1)); same(a3, (a2, a2)); same(a4, (a3, a3)); same(a5, (a4, a4)); same(a6, (a5, a5)); same(a7, (a6, a6)); same(a8, (a7, a7)); same(a9, (a8, a8)); same(a10, (a9, a9)); same(a11, (a10, a10)); same(a12, (a11, a11)); same(a13, (a12, a12)); same(a14, (a13, a13)); }
}
