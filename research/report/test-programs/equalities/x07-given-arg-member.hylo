//! stage:typing no-std
trait Container { type Element }
struct Wrapper<T> { public memberwise init }
struct List { type Element = Bool }
given Wrapper<List.Element> is Container {
  type Element = List.Element
}
fun first<C where C is Container>(c: C) {}
public fun main() {
  let w = Wrapper<Bool>()
  first(w)
}
