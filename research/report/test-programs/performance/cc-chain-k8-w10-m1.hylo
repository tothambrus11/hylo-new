struct Box<T> {}
fun need<A, B where A == B>() {}
fun f<T, U, X1, Y1, X2, Y2, X3, Y3, X4, Y4, X5, Y5, X6, Y6, X7, Y7, X8, Y8 where
  T == U,
  X1 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<T>>>>>>>>>>, Y1 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<U>>>>>>>>>>,
  X2 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X1>>>>>>>>>>, Y2 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y1>>>>>>>>>>,
  X3 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X2>>>>>>>>>>, Y3 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y2>>>>>>>>>>,
  X4 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X3>>>>>>>>>>, Y4 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y3>>>>>>>>>>,
  X5 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X4>>>>>>>>>>, Y5 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y4>>>>>>>>>>,
  X6 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X5>>>>>>>>>>, Y6 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y5>>>>>>>>>>,
  X7 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X6>>>>>>>>>>, Y7 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y6>>>>>>>>>>,
  X8 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X7>>>>>>>>>>, Y8 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y7>>>>>>>>>>
>() {
  need<X8, Y8>()
}
