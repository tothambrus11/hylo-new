  X9 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X8>>>>>>>>>>, Y9 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y8>>>>>>>>>>,
  X10 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<X9>>>>>>>>>>, Y10 == Box<Box<Box<Box<Box<Box<Box<Box<Box<Box<Y9>>>>>>>>>>,
