// Tests: the projection is written on a parameter that is equal to the one the requirement is
// on (`T == U, T is P`, parameter `x: U.X`).
// Correct verdict: rejected (2 errors: `S1()` and `wantS1`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun eqp<T, U where T == U, T is P>(t: T, x: U.X) -> U.X { x }
fun q() {
  wantS0(eqp(A(), S0()))
  wantS0(eqp(A(), S1()))
  wantS1(eqp(A(), S0()))
}
