// Tests: associated types that never normalise (`A.X = Box<A>.X`, `Box<T>.X = Box<T.X>`), used
// on both sides of a call.
// Correct verdict: rejected (at the declarations, and whatever the uses are).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
type BA = Box<A>
type BB = Box<B>
struct B { public memberwise init }
given A is P { type X = BA.X
  fun get() -> BA.X { trap() }
  fun put(x: BA.X) {} }
given B is P { type X = BB.X
  fun get() -> BB.X { trap() }
  fun put(x: BB.X) {} }
given <T where T is P> => Box<T> is P { type X = Box<T.X>
  fun get() -> Box<T.X> { trap() }
  fun put(x: Box<T.X>) {} }
fun trap<T>() -> T { trap<T>() }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun take<T where T is P>(t: T, x: T.X) { t.put(x) }
fun q() { take(A(), pick(B())) }
