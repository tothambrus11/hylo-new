// Control of d01: the parameter is the projection itself. Correct verdict: accepted.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun take<T where T is P>(t: T, x: T.X) {}
fun g<U where U is P, U.X == S1>(u: U, b: S1) { take(u, b) }
