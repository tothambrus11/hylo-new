// Tests: the callee is a function bundle (`auto`) with a projection in its signature.
// Correct verdict: rejected (1 error, `wantS1`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun fwd<T where T is P>(t: T, x: auto T.X) auto -> T.X {
  sink  { (x, t.get()) }
  inout { t.get() }
}
fun q() {
  var s = S0()
  wantS0(fwd(A(), &s))
  wantS1(fwd(A(), &s))
}
