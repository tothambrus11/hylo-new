// Tests: the type argument occurs only under the projection; the nearest conformance decides
// it, whatever the argument is.
// Correct verdict: QUESTION. `only(S0())` has exactly one solution, `T = A` (global
// conformance, `X = S0`); the local conformance of `B` has `X = S1`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
struct B { public memberwise init }
fun only<T where T is P>(x: T.X) {}
fun q() {
  given B is P { type X = S1
    fun get() -> S1 { S1() }
    fun put(x: S1) {} }
  only(S0())
}
