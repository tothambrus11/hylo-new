// Tests: a generic function with a projection in its signature passed to a higher-order
// function; the result type of `apply` is then the projection.
// Correct verdict: rejected (1 error: the result is an `S0`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun apply<U, V>(f: [](let U) -> V, u: U) -> V { f(u) }
public fun main() {
  wantS0(apply(pick, A()))
  wantS1(apply(pick, A()))
}
