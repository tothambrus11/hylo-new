// Tests: calls from the body of a conditional conformance, with the requirement of the
// conformance and with the conformance itself as witnesses.
// Correct verdict: rejected (1 error: in `put`, `take(self.v, pick(self))` passes a
// `Box<T.X>` for a `T.X`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun take<T where T is P>(t: T, x: T.X) { t.put(x) }
given <T where T is P> => Box<T> is P { type X = Box<T.X>
  fun get() -> Box<T.X> { Box<T.X>(v: pick(self.v)) }
  fun put(x: Box<T.X>) {
    take(self.v, x.v)
    take(self, x)
    take(self, pick(self))
    take(self.v, pick(self))
  } }
