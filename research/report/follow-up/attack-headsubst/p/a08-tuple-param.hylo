// Tests: a projection in a tuple parameter.
// Correct verdict: rejected; `{S1, S0}` is passed for `{A.X, A.X}`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun tup<T where T is P>(t: T, x: {T.X, T.X}) { t.put(x.0) }
public fun main() { tup(A(), (S1(), S0())) }
