// Tests: the caller knows `U.X == S1`; the argument is a `Box<S1>` for a parameter `Box<T.X>`.
// The variable standing for `T.X` is bound to `S1` by the argument before the callee is
// elaborated, and is then equated, not coerced, with `U.X`.
// Correct verdict: accepted (`Box<S1>` is `Box<U.X>`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun wrap<T where T is P>(t: T, x: Box<T.X>) {}
fun g<U where U is P, U.X == S1>(u: U, b: Box<S1>) { wrap(u, b) }
