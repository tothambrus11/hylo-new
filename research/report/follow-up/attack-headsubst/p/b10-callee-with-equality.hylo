// Tests: the where clause of the callee has an equality next to the conformance; the witness
// list has one more element.
// Correct verdict: rejected (1 error, the call with `S1()`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun take<T, U where T == U, T is P>(t: T, u: U, x: T.X) -> U { u }
public fun main() {
  take(A(), A(), S0())
  take(A(), A(), S1())
}
