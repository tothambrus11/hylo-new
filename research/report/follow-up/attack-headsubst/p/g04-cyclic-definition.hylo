// Tests: an associated type defined through itself at another instance, which never
// normalises: `Box<T>.X = Box<Box<T>>.X`.
// Correct verdict: rejected (at the conformance, or at the uses).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
type BB<T> = Box<Box<T>>
given <T> => Box<T> is P { type X = BB<T>.X
  fun get() -> BB<T>.X { trap() }
  fun put(x: BB<T>.X) {} }
fun trap<T>() -> T { trap<T>() }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun take<T where T is P>(t: T, x: T.X) { t.put(x) }
fun q(b: Box<A>) {
  wantS1(pick(b))
  take(b, S0())
}
