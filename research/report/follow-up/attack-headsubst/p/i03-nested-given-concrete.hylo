// Tests: the projection through a given declared in the trait, at concrete types.
// Correct verdict: rejected (2 errors: `wantS1(far(A()))` and `feed(A(), S1())`).
trait Q { type Y; fun y() -> Y; fun eat(y: Y) }
trait P { type X
  given X is Q
  fun get() -> X }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct M0 { public memberwise init }
struct A { public memberwise init }
given M0 is Q { type Y = S0
  fun y() -> S0 { S0() }
  fun eat(y: S0) {} }
given A is P { type X = M0
  fun get() -> M0 { M0() } }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun far<T where T is P>(t: T) -> T.X.Y { t.get().y() }
fun feed<T where T is P>(t: T, y: T.X.Y) { t.get().eat(y) }
fun q() {
  wantS0(far(A()))
  feed(A(), S0())
  feed(A(), far(A()))
  wantS1(far(A()))
  feed(A(), S1())
}
