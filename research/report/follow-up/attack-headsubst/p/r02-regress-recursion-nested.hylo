// Tests: like r01 with the projection nested in the parameter type and no result.
// Correct verdict: accepted (the existing checker accepts it).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun rec<T where T is P, T.X == S1>(t: T, b: Box<T.X>) { rec<T>(t, Box<S1>(v: S1())) }
