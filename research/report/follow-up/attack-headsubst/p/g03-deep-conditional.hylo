// Tests: a conditional conformance whose associated type is defined through the one of its
// premise, at depth 9: reading `X` takes more rounds of normalisation than the checker allows.
// Correct verdict: rejected (`pick(b)` is a `Box^9<S0>`, not an `S1`), or rejected with a
// message saying that the limit is reached.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
given <T where T is P> => Box<T> is P { type X = Box<T.X>
  fun get() -> Box<T.X> { Box<T.X>(v: self.v.get()) }
  fun put(x: Box<T.X>) { self.v.put(x.v) } }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun take<T where T is P>(t: T, x: T.X) { t.put(x) }
type B9 = Box<Box<Box<Box<Box<Box<Box<Box<Box<A>>>>>>>>>
fun q(b: B9) {
  wantS1(pick(b))
  take(b, S1())
}
