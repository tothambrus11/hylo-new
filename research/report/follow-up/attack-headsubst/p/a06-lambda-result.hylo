// Tests: a lambda argument whose result type is the projection.
// Correct verdict: rejected; the lambda returns an `S1` where `A.X` = `S0` is expected, and
// `fill` passes it to `A.put(x: S0)`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun fill<T where T is P>(t: T, f: []() -> T.X) { t.put(f()) }
public fun main() { fill(A(), fun[]() { S1() }) }
