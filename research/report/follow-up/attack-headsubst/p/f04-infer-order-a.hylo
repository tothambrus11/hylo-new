// Tests: the type argument occurs only under the projection and two conformances are declared
// in the same scope; declaration order 1.
// Correct verdict: the same as f04-infer-order-b (rejected: the type argument is ambiguous).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
struct B { public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
given B is P { type X = S1
  fun get() -> S1 { S1() }
  fun put(x: S1) {} }
fun only<T where T is P>(x: T.X) {}
fun q() { only(S0()) }
