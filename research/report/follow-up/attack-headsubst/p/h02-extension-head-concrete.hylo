// Tests: h01 at a concrete type: `Wrap<A, S0>` is a `Wrap<T, T.X>` for `T = A`, and
// `Wrap<A, S1>` is not.
// Correct verdict: rejected (1 error, `bad.feed()`), which would give the `S1` to `A.put`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
struct Wrap<T, Y> { public var t: T; public var y: Y; public memberwise init }
extension <T where T is P> Wrap<T, T.X> {
  fun feed() { self.t.put(self.y) }
}
fun q(good: Wrap<A, S0>, bad: Wrap<A, S1>) {
  good.feed()
  bad.feed()
}
