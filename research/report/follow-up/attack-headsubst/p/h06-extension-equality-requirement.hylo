// Tests: an extension with an equality requirement next to the conformance, and one on a
// partially applied type.
// Correct verdict: rejected (2 errors, the calls with `S1()`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
struct Pair<T, U> { public var a: T; public var b: U; public memberwise init }
extension <T, U where T == U, T is P> Pair<T, U> {
  fun eq(x: T.X, y: U.X) { self.a.put(x) }
}
extension <T where T is P> Pair<T, S1> {
  fun half(x: T.X) { self.a.put(x) }
}
fun q(p: Pair<A, A>, h: Pair<A, S1>) {
  p.eq(S0(), S0())
  p.eq(S0(), S1())
  h.half(S0())
  h.half(S1())
}
