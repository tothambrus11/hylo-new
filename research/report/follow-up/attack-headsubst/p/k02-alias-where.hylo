// Tests: a generic alias with a requirement (if the syntax exists), a type-level use of the
// projection that is not a call.
// Correct verdict: rejected (1 error: `XOf<A>` is `S0`), or a syntax error.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
type XOf<T where T is P> = T.X
fun q(x: XOf<A>) {
  wantS0(x)
  wantS1(x)
}
