// Tests: the where clause of the callee equates the projection with a parameter.
// Correct verdict: rejected (2 errors: `S1()` for `U` = `A.X`, and the result to `wantS1`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun take<T, U where T is P, T.X == U>(t: T, u: U) -> T.X { u }
public fun main() {
  wantS0(take(A(), S0()))
  take(A(), S1())
  wantS1(take(A(), S0()))
}
