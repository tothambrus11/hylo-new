// Tests: the leaked projection type of one function meets that of another function: `mk` and
// `use` have different requirement declarations, so their projections must stay distinct.
// Correct verdict: rejected (the types `(A::r_mk).X` and `(A::r_use).X` are unrelated), or
// accepted only if both are resolved to `S0`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun mk<T where T is P>(t: T) -> T.X { t.get() }
fun use<T where T is P>(t: T, x: T.X) { t.put(x) }
fun apply1<U, W>(f: [](let U) -> W, u: U) -> W { f(u) }
fun apply2<U, V>(f: [](let U, let V) -> Void, u: U, v: V) { f(u, v) }
fun q() {
  let v = apply1(mk, A())
  apply2(use, A(), v)
}
