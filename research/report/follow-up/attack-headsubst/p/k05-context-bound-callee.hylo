// Tests: the requirement of the callee is written as a context bound (`<T is P>`).
// Correct verdict: rejected (2 errors, `wantS1` and `S1()`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun pick<T is P>(t: T) -> T.X { t.get() }
fun take<T is P>(t: T, x: T.X) { t.put(x) }
fun q() {
  wantS0(pick(A()))
  take(A(), pick(A()))
  wantS1(pick(A()))
  take(A(), S1())
}
