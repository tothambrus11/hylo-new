// currently: base out of time; FULL rejected (summon.subgoals=20 summon.matches=176 summon.depthExhausted=1 eqsolve.proved=16 index.fallback=2); stage 1 as first implemented (binary eq15, FULL,eqindex,eqeager) rejected (summon.subgoals=20 summon.matches=176 summon.depthExhausted=1 eqsolve.proved=16 index.fallback=2). FULL says: no coercion from 'P<W<U0, U1, U2, U3, U4, U5, U6, U7>> ==> [Void]() let -> R' to '[Void]() let -> R'. With selfcheck: no violation.
trait P {}
struct R { public memberwise init }
struct W<X0, X1, X2, X3, X4, X5, X6, X7> {}
fun need<V where V is P>() -> R { R() }
fun f<T0, T1, T2, T3, T4, T5, T6, T7, U0, U1, U2, U3, U4, U5, U6, U7 where T0 == U0, T1 == U1, T2 == U2, T3 == U3, T4 == U4, T5 == U5, T6 == U6, T7 == U7, W<T0, T1, T2, T3, T4, T5, T6, T7> is P>() {
  let r = need<W<U0, U1, U2, U3, U4, U5, U6, U7>>()
}
