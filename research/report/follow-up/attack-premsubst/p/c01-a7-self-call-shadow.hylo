// Assumption A7. f calls itself with T inferred as A.X selected through its OWN requirement
// `A is P`, while a nearer local given `A is P` (X = C) is in scope. The call needs
// `(A.X of f's requirement) is R`, which f does not know: ILL TYPED.
// If the reference inside the type argument is bound to the callee's premise and that premise is
// discharged by the local given, the requirement becomes `C is R`, which holds: wrong acceptance,
// and the callee would use the R-witness of C on a value of type B.
trait P { type X }
trait Q {}
trait R { fun show() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
given B is Q {}
given C is Q {}
given B is R { fun show() {} }
given C is R { fun show() {} }
given A is P { type X = B }
fun f<T where A is P, A.X is Q, T is R>(x: T, y: A.X) {
  x.show()
  given A is P { type X = C }
  f(y, y)
}
