// Control of t04, ILL TYPED twice: g does not know U.X is Q; A.X = B is not Q.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
given A is Q {}
given A is P { type X = B }
extension <T where T is P, T.X is Q> T { fun deep() {} }
fun g<U where U is P>(u: U) { u.deep() }
public fun main() { A().deep() }
