// Control of a09, ILL TYPED: A.X = B is not Q, so Box<A> is not P.
trait P { type X }
trait Q {}
trait R {}
struct A {}
struct B {}
struct Box<T> {}
given A is R {}
given A is P { type X = B }
given <T where T is P, T.X is Q> => Box<T> is P { type X = T }
fun f<T where T is P, T.X is R>() {}
public fun main() { f<Box<A>>() }
