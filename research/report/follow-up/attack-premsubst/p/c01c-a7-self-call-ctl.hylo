// Control of c01 without the local given: ILL TYPED for the same reason (A.X is not known to be R),
// and nothing can make it look satisfied.
trait P { type X }
trait Q {}
trait R { fun show() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
given B is Q {}
given C is Q {}
given B is R { fun show() {} }
given C is R { fun show() {} }
given A is P { type X = B }
fun f<T where A is P, A.X is Q, T is R>(x: T, y: A.X) {
  x.show()
  f(y, y)
}
