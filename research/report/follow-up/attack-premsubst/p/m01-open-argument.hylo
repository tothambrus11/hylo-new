// T is inferred from the argument. Well typed: Box<B> is P with X = B, B is Q. A second
// conformance (A is P, A.X = B) also satisfies the requirements at T = A; resolution must not
// commit to it before T is known.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
given B is Q {}
given A is P { type X = B }
given <Y> => Box<Y> is P { type X = Y }
fun f<T where T is P, T.X is Q>(x: T) {}
public fun main() { f(Box<B>()) }
