// The requirement of the callee is written through an alias of the parameter's projection.
// Well typed.
trait P { type X }
trait Q {}
struct A {}
struct B {}
given B is Q {}
given A is P { type X = B }
struct W<T> {}
given <T where T is Q> => W<T> is Q {}
fun f<T where T is P, W<T.X> is Q>() {}
fun g<U where U is P, U.X is Q>() { f<U>() }
public fun main() { f<A>() }
