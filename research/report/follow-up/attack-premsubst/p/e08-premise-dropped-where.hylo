// As e07 where the nearer witness of `A is P` is a requirement of h (no local conformance).
// In h, Box<A> is P through h's own requirement on A, so Box<A>.X is the X of that requirement,
// about which nothing is known. ILL TYPED: f<Box<A>> needs that X to be Q. The program only
// states that Box<A>.X is Q for the DECLARED conformance of A (BX is B).
trait P { type X
  fun get() -> X }
trait Q { fun use() }
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { var t: T
  public memberwise init }
given A is P { type X = B
  fun get() -> B { B() } }
given <T where T is P> => Box<T> is P { type X = T.X
  fun get() -> T.X { self.t.get() } }
type BA = Box<A>
type BX = BA.X
given BX is Q { fun use() {} }
fun f<T where T is P, T.X is Q>(t: T) { t.get().use() }
fun h<where A is P>(b: Box<A>) { f<Box<A>>(b) }
