// A conditional extension with a dependent requirement, concrete receiver. Well typed.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
given B is Q {}
given A is P { type X = B }
extension <T where T is P, T.X is Q> Box<T> { fun first() {} }
public fun main() { Box<A>().first() }
