// A method declared in an extension, with dependent requirements on its own generic parameter.
// Well typed.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
given B is Q {}
given A is P { type X = B }
struct K { public memberwise init }
extension K { fun m<T where T is P, T.X is Q>(x: T) {} }
fun g<U where U is P, U.X is Q>(k: K, u: U) { k.m(u) }
public fun main() { K().m(A()) }
