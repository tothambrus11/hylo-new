// Control of v03b: the extension has no dependent requirement (`T is P` only). ILL TYPED for
// the same reason. Shows whether the wrong acceptance of v03b exists without premsubst.
trait P { type X
  fun get() -> X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct Box<T> { var t: T
  public memberwise init }
given B is Q {}
given C is Q {}
given A is P { type X = B
  fun get() -> B { B() } }
extension <T where T is P> Box<T> { fun first() -> T.X { self.t.get() } }
fun h(b: Box<A>) {
  var v = b.first()
  if true {
    given A is P { type X = C
      fun get() -> C { C() } }
    v = b.first()
  }
}
