// Assumption A7, reached through a nested function. `inner` has its own requirement `T is P`
// (nearer than f's) and calls f with V inferred as the type of `w`, which is T.X selected through
// F's requirement. The call needs `(T.X of f's requirement) is R`: ILL TYPED, nothing states it.
// If the reference to f's requirement inside the type argument V is bound to the callee's premise,
// and the premise is discharged with inner's requirement, the goal becomes
// `(T.X of inner's requirement) is R`, which inner states: wrong acceptance. f then applies the
// R-witness of one type to a value of another (main: C's `show` on a B).
trait P { type X
  fun get() -> X }
trait Q {}
trait R { fun show() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct D { public memberwise init }
given B is Q {}
given C is Q {}
given C is R { fun show() {} }
given D is R { fun show() {} }
given A is P { type X = B
  fun get() -> B { B() } }
given <Z> => Z is P { type X = C
  fun get() -> C { C() } }
fun f<T, V where T is P, T.X is Q, V is R>(t: T, v: V) {
  v.show()
  let w = t.get()
  fun inner<where T is P, T.X is Q, T.X is R>() {
    f(t, w)
  }
  inner()
}
public fun main() { f<A, D>(A(), D()) }
