// As q01 for a projection through a NON-dependent requirement with a dependent one in the clause:
// the result T.X is a B with the declared conformance and a C1 with the local one.
// ILL TYPED: a C1 is assigned to the variable that holds a B.
trait P { type X
  fun get() -> X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct C1 { public memberwise init }
given B is Q {}
given C1 is Q {}
given A is P { type X = B
  fun get() -> B { B() } }
fun f<T where T is P, T.X is Q>(t: T) -> T.X { t.get() }
fun h(a: A) {
  var v = f<A>(a)
  if true {
    given A is P { type X = C1
      fun get() -> C1 { C1() } }
    v = f<A>(a)
  }
}
