// Control of s01 with one conformance per level. ILL TYPED (A is not Q); cheap.
trait P { type X }
trait Q {}
struct A {}
given A is P { type X = A }
fun f<T where T is P, T.X is P, T.X.X is P, T.X.X.X is P, T.X.X.X.X is P, T.X.X.X.X.X is P, T.X.X.X.X.X.X is P, T.X.X.X.X.X.X.X is P, T.X.X.X.X.X.X.X.X is Q>() {}
public fun main() { f<A>() }
