// As b01 but both B and C are Q: two complete derivations of equal rank. Must be rejected as
// ambiguous (accepting would pick a witness arbitrarily).
trait P { type X
  fun get() -> X }
trait Q { fun use() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
given B is Q { fun use() {} }
given C is Q { fun use() {} }
given A is P { type X = B
  fun get() -> B { B() } }
given A is P { type X = C
  fun get() -> C { C() } }
fun f<T where T is P, T.X is Q>(t: T) { t.get().use() }
public fun main() { f<A>(A()) }
