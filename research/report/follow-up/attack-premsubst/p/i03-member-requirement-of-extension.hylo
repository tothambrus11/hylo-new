// The dependent requirement belongs to a member, the mentioned one to the enclosing extension
// (two clauses; DESIGN 3.8 says this stays opaque). Well typed; reported as INCOMPLETE if rejected.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
given B is Q {}
given A is P { type X = B }
extension <T where T is P> Box<T> { fun m<where T.X is Q>() {} }
fun g<U where U is P, U.X is Q>(b: Box<U>) { b.m() }
public fun main() { Box<A>().m() }
