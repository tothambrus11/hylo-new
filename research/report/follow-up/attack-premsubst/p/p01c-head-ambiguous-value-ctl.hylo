// Control of p01, well typed under design question 4: the argument is a B.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
given B is Q {}
given A is P { type X = B }
given A is P { type X = C }
fun f<T where T is P, T.X is Q>(t: T, x: T.X) {}
public fun main() { f<A>(A(), B()) }
