// The premise that the dependent one mentions (S<A> is P) is discharged through a conditional
// given whose own premise (A is P) is matched by the pending hypothesis `A is P`. Well typed:
// S<A>.X is A, and A is Q.
trait P { type X }
trait Q {}
struct A {}
struct B {}
struct S<T> {}
given A is P { type X = B }
given <T where T is P> => S<T> is P { type X = T }
given A is Q {}
type SA = S<A>
fun f<where A is P, SA is P, SA.X is Q>() {}
public fun main() { f() }
