// A conditional extension of every conforming type with a dependent requirement, used on a
// generic value and on a concrete one. Well typed.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
given B is Q {}
given A is P { type X = B }
extension <T where T is P, T.X is Q> T { fun deep() {} }
fun g<U where U is P, U.X is Q>(u: U) { u.deep() }
public fun main() { A().deep() }
