// A function over two types with a requirement on each associated type and an equality between
// them, called with the SAME type for both. WELL TYPED: A.X = B, B is Q, B is R2, B == B.
// `U is P` can be proved by the declared conformance or by the pending hypothesis `T is P`
// (same type P<A>); both derivations build the same witness f<A, A>(c)(c)(..). Must be accepted.
trait P { type X }
trait Q {}
trait R2 {}
struct A {}
struct A2 {}
struct B {}
given A is P { type X = B }
given A2 is P { type X = B }
given B is Q {}
given B is R2 {}
fun f<T, U where T is P, U is P, T.X is Q, U.X is R2, T.X == U.X>() {}
public fun main() { f<A, A>() }
