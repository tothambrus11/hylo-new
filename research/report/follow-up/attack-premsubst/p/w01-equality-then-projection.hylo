// U is equated with T.X, then required to be P, then U.X is required to be Q: three dependent
// requirements of different kinds. Well typed from the generic and from the concrete caller.
trait P { type X }
trait Q {}
struct A {}
struct B {}
struct C {}
given A is P { type X = B }
given B is P { type X = C }
given C is Q {}
fun f<T, U where T is P, U == T.X, U is P, U.X is Q>() {}
fun g<V where V is P, V.X is P, V.X.X is Q>() { f<V, V.X>() }
public fun main() { f<A, B>() }
