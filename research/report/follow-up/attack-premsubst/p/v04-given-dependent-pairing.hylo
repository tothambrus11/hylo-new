// A conditional given with a dependent requirement and two conformances of A (X = B, B is Q;
// X = C, C is not Q). The conformance `Box<A> is S` must be built with the first conformance and
// `B is Q` (its method calls `use` on the result of `get`). Acceptable: accepted with that pairing
// (check by trace) or rejected as ambiguous.
trait P { type X
  fun get() -> X }
trait Q { fun use() }
trait S { fun go() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct Box<T> { var t: T
  public memberwise init }
given B is Q { fun use() {} }
given A is P { type X = B
  fun get() -> B { B() } }
given A is P { type X = C
  fun get() -> C { C() } }
given <T where T is P, T.X is Q> => Box<T> is S { fun go() { self.t.get().use() } }
fun need<T where T is S>(x: T) { x.go() }
public fun main() { need(Box<A>(t: A())) }
