// Control of d03, ILL TYPED twice: A.X = B is not Q (main); g knows U.X is S, not Q.
trait P { type X }
trait Q {}
trait R {}
trait S {}
struct A {}
struct B {}
struct Box<T> {}
given B is S {}
given A is P { type X = B }
given <T where T is P, T.X is Q> => Box<T> is R {}
fun need<T where T is R>() {}
fun g<U where U is P, U.X is S>() { need<Box<U>>() }
public fun main() { need<Box<A>>() }
