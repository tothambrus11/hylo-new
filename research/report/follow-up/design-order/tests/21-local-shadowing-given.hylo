// Expected after the change: accepted, in every order of the top-level declarations.
// Reason: A given in a function body shadows a top-level one. Must not change.
// Currently: base accepts it in all 6 orders tried; FULL accepts it in all 6 orders tried.
trait P { type E }
struct A {}
given A is P { type E = Int }
fun need(x: Bool) {}
fun h(y: Bool) {
  given A is P { type E = Bool }
  let z: A.E = y
  need(z)
}
