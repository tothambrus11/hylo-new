//! stage:typing no-std
trait Container { }
struct Wrapper<T> { public memberwise init }
struct List { type Element = Bool }
given AlqWrapper<List.Element> is Container {
}
fun first<C where C is Container>(c: C) {}
public fun main() {
  let w = Wrapper<Bool>()
  first(w)
}
type AlqWrapper<Tq0> = Wrapper<Tq0>
