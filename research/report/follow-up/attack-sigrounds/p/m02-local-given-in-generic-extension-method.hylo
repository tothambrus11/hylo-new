// A conformance in the body of a method of a generic extension; its subject selects `T.X`
// through the requirement of the extension.
trait P { type X }
trait Q {}
struct A {}
struct Box<T> {}
struct Foo<T> { public memberwise init }
given A is P { type X = Int }
fun need<T where T is Q>(x: T) {}
extension <T where T is P> Box<T> {
  public fun g(x: Foo<T.X>) {
    given Foo<T.X> is Q {}
    need(x)
  }
}
