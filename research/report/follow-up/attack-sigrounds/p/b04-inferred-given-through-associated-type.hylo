// The type of the given is inferred from a call whose result is an associated type selected
// through a conformance of the module.
trait P { type X; fun get() -> X }
struct A { public memberwise init }
struct C { public memberwise init }
given A is P { type X = C; fun get() -> C { C() } }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
given let w = pick(A())
fun need<where let u: C>() {}
public fun main() { need() }
