// a02 with its last two declarations swapped.
trait P { type X }
trait Q {}
trait R {}
trait S { type Y }
struct A {}
struct Box<T> {}
struct Foo<T> {}
given A is P { type X = Int }
given <U> => Foo<U> is Q {}
type BA = Box<A>
given BA.Y is R {}
given <T where T is P, Foo<Y> is Q> => Box<T> is S { type Y = T.X }
