// Three independent requirements, one of which uses an alias defined through a conformance
// (requirement order [1, 2, 3], generic parameters U, T). Every permutation must be accepted.
trait P { type X }
trait P2 {}
trait Q {}
trait R {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Foo<T> {}
struct Pair<T, U> { public memberwise init }
given A is P { type X = Int }
given B is P2 {}
type K = A.X
given Foo<K> is Q {}
given <U, T where T is P, U is P2, Foo<K> is Q> => Pair<T, U> is R {}
fun need<T where T is R>(x: T) {}
public fun main() { need(Pair<A, B>()) }
