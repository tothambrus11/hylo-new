// As b05 in a program that needs three rounds (the alias `K` goes through a conformance).
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
given A is P { type X = Int }
type K = A.X
given K is Q {}
given let a: A = B()
fun need<where let u: A>() {}
public fun main() { need() }
