// Control of a03: the where clause does not name `LA`; `T.X` is ambiguous.
trait P { type X }
trait P2 { type X }
trait Q {}
trait R {}
struct A {}
struct Box<T> {}
struct Foo<T> {}
given A is P { type X = Int }
given A is P2 { type X = Bool }
given <U> => Foo<U> is Q {}
type BA = Box<A>
extension <T where T is P, T is P2> Box<T> { type LA = T.X }
fun f(x: BA.LA) {}
