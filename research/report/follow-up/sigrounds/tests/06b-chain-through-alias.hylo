// Expected: accepted, in every order of the top-level declarations.
// Reason: the chain of 06 with the member selected on an alias, because `Foo<X>.F` is not
// accepted as a type expression by the existing implementation in any program.
trait P { type E }
trait Q { type F }
struct A {}
struct Foo<T> {}
struct Bar<T> {}
given A is P { type E = Int }
type X = A.E
type FX = Foo<X>
given FX is Q { type F = Bool }
type Y = FX.F
given Bar<Y> is P { type E = A }
type Z = Bar<Y>
type W = Z.E
fun g(y: Y, w: W) {}
