// e02 with the requirements and parameters permuted: <W, V where V is P, V == W, W is P>
trait P { type X
  fun get() -> X
  fun put(x: X) }
extension <T where T is P> T {
  fun one() -> T.X { self.get() }
  fun two(x: T.X) { self.put(x) } }
fun f<W, V where V is P, V == W, W is P>(v: V, w: W) { v.two(w.one()) }
