// e02 with the requirements and parameters permuted: <V, W where V is P, W is P, V == W>
trait P { type X
  fun get() -> X
  fun put(x: X) }
extension <T where T is P> T {
  fun one() -> T.X { self.get() }
  fun two(x: T.X) { self.put(x) } }
fun f<V, W where V is P, W is P, V == W>(v: V, w: W) { v.two(w.one()) }
