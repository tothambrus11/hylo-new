// assocsubst: the definition is a tuple and a function type of the parameters.
trait P { type X
  type F
  fun get() -> X
  fun fn() -> F }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Pair<T, U> { public memberwise init }
given <T, U> => Pair<T, U> is P { type X = {U, T}
  type F = [Void](T) -> U
  fun get() -> {U, T} { self.get() }
  fun fn() -> [Void](T) -> U { self.fn() } }
fun check<T>(x: T) {}
fun ok(p: Pair<S0, S1>) { check<{S1, S0}>(p.get())
  check<[Void](S0) -> S1>(p.fn()) }
fun bad1(p: Pair<S0, S1>) { check<{S0, S1}>(p.get()) }
fun bad2(p: Pair<S0, S1>) { check<[Void](S1) -> S0>(p.fn()) }
