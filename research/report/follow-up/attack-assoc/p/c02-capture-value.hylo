// c01 with concrete types: main calls m<S1>; inside, b is a Box<S1> and b.m<S0>(...) returns
// b.get(), an S1, which is passed to takeS0.
trait P { type X
  fun get() -> X
  fun m<U>(u: U, b: Box<U>) -> X {
    takeS0(b.m<S0>(S0(), Box<S0>(t: S0())))
    return self.get() } }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var t: T
  public memberwise init }
given <T> => Box<T> is P { type X = T
  fun get() -> T { self.t } }
fun takeS0(x: S0) {}
public fun main() {
  let a = Box<S1>(t: S1())
  let r: S1 = a.m<S1>(S1(), Box<S1>(t: S1()))
}
