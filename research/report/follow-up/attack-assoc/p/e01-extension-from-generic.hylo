// A method of an extension of the conforming types, called from a generic function. Valid.
trait P { type X
  fun get() -> X
  fun put(x: X) }
extension <T where T is P> T {
  fun one() -> T.X { self.get() }
  fun two(x: T.X) { self.put(x) } }
fun f<V where V is P>(v: V, x: V.X) { v.two(x)
  v.two(v.one())
  v.put(v.one()) }
