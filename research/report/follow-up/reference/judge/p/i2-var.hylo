struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1 where T0 == St1, T1 == St2<T0>>(x: T1) { check<St2<St1>>(x) }
fun q1<T0, T1 where T0 == St1, T1 == St2<T0>>() { needEq<T1, St2<St1>>() }
fun q2<T0, T1 where T0 == St1, T1 == St2<T0>>(x: St2<T0>) { check<St2<St1>>(x) }
fun q3<T0, T1 where T0 == St1, T1 == St2<T0>>(x: T1) { check<St2<T0>>(x) }
fun q4<T0, T1 where T0 == St1, T1 == St2<T0>>(x: St2<St1>) { check<T1>(x) }
fun q5<T0, T1 where T0 == St1, T1 == St2<T0>>(x: T1) { let y: St2<T0> = x
  check<St2<St1>>(y) }
