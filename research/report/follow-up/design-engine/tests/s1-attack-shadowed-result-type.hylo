//! stage:typing no-std
// attack (review): the joint reading is visible in types once heads are bound (headsubst). In main,
// A.X is C, but f<A>() has type W<B>: this program is accepted under NEW, and the same program with
// 'let x: W<A.X>' or 'let x: W<C>' is rejected (s1-attack-shadowed-result-type-own).
// expected (premsubst + commit rule): rejected. expected (joint reading, with headsubst): accepted.
// observed: (eq25, premsubst as first designed) FULL+premsubst rejected (bound=1 released=2 normalized=2); +selfcheck same; +assocsubst rejected; NEW accepted
// currently: base rejected (subgoals=15 matches=1124): no coercion from '(P<A>, Q<(A::P).X>) ==> [Void]() let -> W<(A::P).X>' to '[Void]() let -> W<(A::P).X>'; FULL rejected (subgoals=7 matches=298 refuted=2): no coercion from '(P<A>, Q<(A::P).X>) ==> [Void]() let -> W<(A::P).X>' to '[Void]() let -> W<(A::P).X>'
trait P { type X }
trait Q {}
struct A {}
struct B { public memberwise init }
struct C { public memberwise init }
struct W<T> { public memberwise init }
given B is Q {}
given A is P { type X = B }
fun f<T where T is P, T.X is Q>() -> W<T.X> { W<T.X>() }
public fun main() {
  given A is P { type X = C }
  let x: W<B> = f<A>()
}
