+  /// Returns `true` if `t` is an equality `a ~ b` that implicit resolution provably cannot derive
+  /// from the givens visible from `scopeOfUse` and those assumed in `environment`.
+  ///
+  /// Requires `fixsubst`: without it, resolution derives equalities that do not hold.
+  ///
+  /// The test computes the classes of the equivalence relation generated by the ground equality
+  /// givens in scope (and by unifiability between their sides) and refutes `a ~ b` when `a` and `b`
+  /// fall into different classes. It only applies when every side is an atom (a generic parameter,
+  /// an associated type, or a nominal or machine type without arguments), so that congruence cannot
+  /// relate two classes, and gives up if a given may derive an equality from its parameters (a
+  /// quantified equality or a bare-variable head) or if `t` has open variables.
+  private mutating func equalityIsRefuted(
+    _ t: AnyTypeIdentity, in scopeOfUse: ScopeIdentity,
+    where environment: ResolutionThread.Environment
+  ) -> Bool {
+    let u = program.types.reify(t, applying: environment.substitutions, withVariables: .kept)
+    guard !u[.hasVariable], let e = program.types.cast(u, to: EqualityWitness.self) else {
+      return false
+    }
+
+    func atom(_ x: AnyTypeIdentity) -> AnyTypeIdentity? {
+      let y = program.types.dealiased(x)
+      if y[.hasVariable] || y[.hasError] { return nil }
+      switch program.types[y] {
+      case is GenericParameter, is AssociatedType, is Struct, is Enum, is Trait, is MachineType:
+        return y
+      default:
+        return nil
+      }
+    }
+    guard let a = atom(program.types[e].lhs), let b = atom(program.types[e].rhs) else {
+      return false
+    }
+    if a == b { return false }
+
+    // Collect the ground equality facts.
+    var facts: [(AnyTypeIdentity, AnyTypeIdentity)] = []
+    let gs = environment.givens + Array(givens(visibleFrom: scopeOfUse).joined())
+    for g in gs {
+      let w = declaredType(of: g)
+      if w[.hasError] { continue }
+      let (c, h) = program.types.contextAndHead(w)
+      if c.parameters.contains(where: { (p) in p.erased == h }) { return false }
+      guard let f = program.types.cast(h, to: EqualityWitness.self) else { continue }
+      if !c.parameters.isEmpty || !c.usings.isEmpty { return false }
+      guard let l = atom(program.types[f].lhs), let r = atom(program.types[f].rhs) else {
+        return false
+      }
+      facts.append((l, r))
+    }
+
+    // Union-find over atoms, merging the sides of facts and unifiable atoms.
+    var atoms = [a, b]
+    for (l, r) in facts { atoms.append(l); atoms.append(r) }
+    var parent: [AnyTypeIdentity: AnyTypeIdentity] = [:]
+    func find(_ x: AnyTypeIdentity) -> AnyTypeIdentity {
+      var x = x
+      while let p = parent[x], p != x { x = p }
+      return x
+    }
+    func union(_ x: AnyTypeIdentity, _ y: AnyTypeIdentity) {
+      let (i, j) = (find(x), find(y))
+      if i != j { parent[i] = j }
+    }
+    for (l, r) in facts { union(l, r) }
+    let distinct = Array(Set(atoms))
+    for i in distinct.indices {
+      for j in distinct.indices where j > i {
+        if program.types.unifiable(distinct[i], distinct[j]) != nil { union(distinct[i], distinct[j]) }
+      }
+    }
+    return find(a) != find(b)
+  }
+
