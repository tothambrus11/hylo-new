+  /// Returns `true` iff the type variable `v` occurs in `t` once `ss` is applied.
+  internal func occurs(
+    _ v: AnyTypeIdentity, in t: AnyTypeIdentity, under ss: SubstitutionTable
+  ) -> Bool {
+    let u = ss[t]
+    if u.isVariable { return u == v }
+    if !u[.hasVariable] { return false }
+    let o: (AnyTypeIdentity) -> Bool = { (x) in self.occurs(v, in: x, under: ss) }
+    switch self[u] {
+    case let x as TypeApplication: return o(x.abstraction) || x.arguments.values.contains(where: o)
+    case let x as Tuple:
+      if case .cons(let h, let r) = x { return o(h) || o(r) } else { return false }
+    case let x as Metatype: return o(x.inhabitant)
+    case let x as EqualityWitness: return o(x.lhs) || o(x.rhs)
+    case let x as AssociatedType: return o(x.qualification.type)
+    case let x as Arrow:
+      return o(x.environment) || o(x.output) || x.inputs.contains(where: { (p) in o(p.type) })
+    case let x as Implication: return o(x.head) || x.usings.contains(where: o)
+    case let x as UniversalType: return o(x.head)
+    case let x as RemoteType: return o(x.projectee)
+    case let x as FunctionPointer: return o(x.output) || x.inputs.contains(where: o)
+    case let x as TypeAlias: return o(x.aliasee)
+    default: return false
+    }
+  }
+
