+  /// Returns the outcome of exploring a candidate of the same type as `choice`, if exploring
+  /// `choice` now would give the same outcome up to the declaration bound to the name (`twins`).
+  private func twin(of choice: NameResolutionCandidate, in explored: [Explored]) -> Explored? {
+    guard TyperExperiments.twins && !plain,
+      let e = explored.last(where: { (x) in x.type == choice.type })
+    else { return nil }
+    if optimistic { return e }
+    if let b = e.bound { return (b == best) ? e : nil }
+    return (e.pure && best == .zero) ? e : nil
+  }
+
+  /// Returns the solution that the existing algorithm computes for the rest of the system, `g`
+  /// being its first overload constraint, if the system has a candidate of `g` with a solution
+  /// free of diagnostics; returns `nil` otherwise, leaving `self` unchanged (`cleanfirst`).
+  ///
+  /// Before a first complete solution exists the existing search cancels nothing, so a candidate
+  /// that fails at its own argument is explored to the end. The attempt made here is the existing
+  /// search with the bound "no error" from the start; each overload set discards the solutions
+  /// that have a diagnostic until it finds a clean one, and runs the unchanged code after that.
+  private mutating func cleanFirstSolution(overload g: GoalIdentity) -> Solution? {
+    assert(best == .worst)
+    TyperCounters.bump("solver.cleanfirstAttempts")
+
+    var attempt = Self(forking: self)
+    attempt.optimistic = true
+    attempt.best = .zero
+    attempt.typer = self.typer.sink()
+    defer { self.typer = attempt.typer.sink() }
+
+    if TyperExperiments.lookahead && !TyperExperiments.selfcheck && attempt.hasCertainFailure() {
+      TyperCounters.bump("solver.cleanfirstFallbacks")
+      return nil
+    }
+    let s = attempt.solve(overload: g)
+    if s == nil { TyperCounters.bump("solver.cleanfirstFallbacks") }
+    return s
+  }
+
+  /// Returns `true` iff some goal in `fresh` fails, and is counted in `current.errors`, in every
+  /// run of the solver that starts from `self` and is not cancelled before it pops that goal
+  /// (`lookahead`).
+  private mutating func hasCertainFailure() -> Bool {
+    TyperCounters.bump("solver.lookaheadScans")
+    for g in fresh {
+      let k = goals[g].updated { (t) in
+        self.typer.program.types.reify(t, applying: substitutions, withVariables: .kept)
+      }
+      if certainlyFails(k) { return true }
+    }
+    return false
+  }
+
+  /// Returns `true` iff `k`, which has been reified, fails whatever is assigned to the variables
+  /// that are still open.
+  private mutating func certainlyFails(_ k: any Constraint) -> Bool {
+    switch k {
+    case let k as EqualityConstraint:
+      return isClosed(k.lhs, k.rhs) && (program.types.unifiable(k.lhs, k.rhs) == nil)
+
+    case let k as WideningConstraint:
+      // `solve(widening:)` turns `k` into the equality of its operands.
+      return isClosed(k.lhs, k.rhs) && (program.types.unifiable(k.lhs, k.rhs) == nil)
+
+    case let k as CoercionConstraint:
+      // The tests of `solve(coercion:)` on closed operands, in the same order.
+      if !isClosed(k.lhs, k.rhs) || k.isTrivial { return false }
+      return typer.coerced(k.origin, withType: k.lhs, toMatch: k.rhs).uniqueElement == nil
+
+    case let k as CallConstraint:
+      // Only callees that `solve(call:)` decomposes without opening a context clause.
+      let (context, head) = program.types.contextAndHead(k.callee)
+      guard context.isEmpty, program.types.tag(of: head) == Arrow.self else { return false }
+      if !program.types.isCallable(head, program[k.origin].style) { return true }
+      let w = program.types.seenAsTermAbstraction(head)!
+      guard let (_, ss, _) = matches(k, w) else { return true }
+      return ss.contains(where: { (s) in certainlyFails(s) })
+
+    default:
+      return false
+    }
+  }
+
+  /// Returns `true` iff neither `a` nor `b` contains a unification variable.
+  private func isClosed(_ a: AnyTypeIdentity, _ b: AnyTypeIdentity) -> Bool {
+    !a[.hasVariable] && !b[.hasVariable]
+  }
+
   /// Creates a solution with the current state.
   private mutating func formSolution() -> Solution? {
     if current > best { return nil }
+    if expectsError && (current.errors == 0) {
+      TyperCounters.bump("selfcheck.violations")
+      print("[selfcheck] VIOLATION: lookahead: a goal found certain to fail did not fail")
+    }
 
     let ss = substitutions.optimized()
     var ds = DiagnosticSet()
diff --git a/Sources/FrontEnd/Typer/Typer.swift b/Sources/FrontEnd/Typer/Typer.swift
index d4b98b3..7e16d92 100644
--- a/Sources/FrontEnd/Typer/Typer.swift
+++ b/Sources/FrontEnd/Typer/Typer.swift
@@ -3495,6 +3495,25 @@ public struct Typer {
 
       var solver = Solver(o, withLoggingEnabled: loggingIsEnabled)
       let s = solver.solution(using: &self)
+
+      // Self-check (`twins`, `cleanfirst`, `lookahead`): the existing search gives the same
+      // diagnostics and the same name bindings.
+      if TyperExperiments.selfcheck && solver.sawOverload
+        && (TyperExperiments.twins || TyperExperiments.cleanfirst || TyperExperiments.lookahead)
+      {
+        var reference = Solver(o, withLoggingEnabled: false)
+        reference.plain = true
+        let r = reference.solution(using: &self)
+        let same =
+          (r.diagnostics.elements.map(\.description) == s.diagnostics.elements.map(\.description))
+          && (r.bindings.count == s.bindings.count)
+          && r.bindings.elements.allSatisfy({ (n, d) in s.bindings[n] == d })
+        if same {
+          TyperCounters.bump("selfcheck.overload.confirmed")
+        } else {
+          selfCheckViolation("overload resolution differs from the existing search")
+        }
+      }
       commit(s, to: o)
       return s
     }
