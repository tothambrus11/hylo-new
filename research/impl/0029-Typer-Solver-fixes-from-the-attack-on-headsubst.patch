+  private mutating func mentionsUnresolvedProjection(_ t: AnyTypeIdentity) -> Bool {
+    let u = typer.program.types.reify(t, applying: substitutions, withVariables: .kept)
+    if !u[.hasVariable] { return false }
+    var pending: Set<AnyTypeIdentity> = []
+    for x in unresolvedProjections {
+      let r = typer.program.types.reify(x.erased, applying: substitutions, withVariables: .kept)
+      if r.isVariable { pending.insert(r) }
+    }
+    if pending.isEmpty { return false }
+    var work = [u]
+    while let n = work.popLast() {
+      if pending.contains(n) { return true }
+      if n[.hasVariable] { work.append(contentsOf: typer.program.types.parts(of: n)) }
+    }
+    return false
+  }
