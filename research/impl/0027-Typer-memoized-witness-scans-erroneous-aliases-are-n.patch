@@ -1230,6 +1230,37 @@ public struct TypeStore: Sendable {
     return found
   }
 
+  /// Returns the types that are immediate parts of `t`, not looking into the aliasee of a type
+  /// alias (as `map(_:_:)`). The qualification of an associated type contributes its type only.
+  public func parts(of t: AnyTypeIdentity) -> [AnyTypeIdentity] {
+    switch self[t] {
+    case let x as TypeApplication:
+      return [x.abstraction] + Array(x.arguments.values)
+    case let x as Tuple:
+      if case .cons(let h, let r) = x { return [h, r] } else { return [] }
+    case let x as Metatype:
+      return [x.inhabitant]
+    case let x as EqualityWitness:
+      return [x.lhs, x.rhs]
+    case let x as AssociatedType:
+      return [x.qualification.type]
+    case let x as Arrow:
+      return [x.environment, x.output] + x.inputs.map(\.type)
+    case let x as Bundle:
+      return [x.shape.erased]
+    case let x as Implication:
+      return [x.head] + x.usings
+    case let x as UniversalType:
+      return [x.head]
+    case let x as RemoteType:
+      return [x.projectee]
+    case let x as FunctionPointer:
+      return [x.output] + x.inputs
+    default:
+      return []
+    }
+  }
+
