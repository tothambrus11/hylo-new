+  /// Schedules, for each projection in `p`, an equality between the variable standing for it and
+  /// the associated type selected through the witness that `w` passes for the requirement that
+  /// the projection mentions, where `w` is the elaboration of the callee (`headsubst`).
+  private mutating func resolve(
+    _ p: PendingProjections, elaboratedBy w: WitnessExpression, at site: SourceSpan
+  ) {
+    // `w` applies the callee to one witness per requirement, possibly under coercions.
+    var f = typer.program.types.reify(w, applying: substitutions, withVariables: .kept)
+    var arguments: [WitnessExpression] = []
+    while case .termApplication(let a, let b) = f.value {
+      if program.types[a.type] is EqualityWitness {
+        f = b
+      } else {
+        arguments.append(b)
+        f = a
