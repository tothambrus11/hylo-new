+  /// Returns `t` with each witness `w` occurring in the qualification of an associated type
+  /// replaced by `replacement(w)` where that is not `nil`. A witness is visited after its parts
+  /// and after the types it contains, so `replacement` sees them already rewritten.
+  private mutating func rewritingWitnesses(
+    in t: AnyTypeIdentity, _ replacement: (WitnessExpression) -> WitnessExpression?
+  ) -> AnyTypeIdentity {
+    withoutActuallyEscaping(replacement) { (f) in
+      Self.rewritingWitnesses(in: t, of: &program.types, f)
+    }
+  }
+
+  /// Returns `w` with each witness occurring in it or in the qualification of an associated type
+  /// of one of its types replaced by `replacement` of it where that is not `nil`.
+  private mutating func rewritingWitnesses(
+    in w: WitnessExpression, _ replacement: (WitnessExpression) -> WitnessExpression?
+  ) -> WitnessExpression {
+    withoutActuallyEscaping(replacement) { (f) in
+      Self.rewritingWitnesses(in: w, of: &program.types, f)
+    }
+  }
+
+  /// Implements `rewritingWitnesses(in:_:)` for types.
+  private static func rewritingWitnesses(
+    in t: AnyTypeIdentity, of s: inout TypeStore,
+    _ replacement: @escaping (WitnessExpression) -> WitnessExpression?
+  ) -> AnyTypeIdentity {
+    s.map(t) { (s, n) in
+      guard let a = s[n] as? AssociatedType else { return .stepInto(n) }
+      let q = rewritingWitnesses(in: a.qualification, of: &s, replacement)
+      return .stepOver(s.demand(AssociatedType(declaration: a.declaration, qualification: q)).erased)
+    }
+  }
+
+  /// Implements `rewritingWitnesses(in:_:)` for witnesses.
+  private static func rewritingWitnesses(
+    in w: WitnessExpression, of s: inout TypeStore,
+    _ replacement: @escaping (WitnessExpression) -> WitnessExpression?
+  ) -> WitnessExpression {
+    let u = rewritingWitnesses(in: w.type, of: &s, replacement)
+    let v: WitnessExpression.Value
+    switch w.value {
+    case .termApplication(let a, let b):
+      v = .termApplication(
+        rewritingWitnesses(in: a, of: &s, replacement),
+        rewritingWitnesses(in: b, of: &s, replacement))
+    case .typeApplication(let a, let ts):
+      let x = rewritingWitnesses(in: a, of: &s, replacement)
+      v = .typeApplication(
+        x, ts.mapValues({ (y) in rewritingWitnesses(in: y, of: &s, replacement) }))
+    case .nested(let a):
+      v = .nested(rewritingWitnesses(in: a, of: &s, replacement))
+    default:
+      v = w.value
+    }
+    let r = WitnessExpression(value: v, type: u)
+    return replacement(r) ?? r
+  }
+
+  /// Returns `t` with each outermost associated type whose qualification mentions one of
+  /// `targets` replaced by a fresh variable, appending each variable and the type it stands for
+  /// to `projections` (`headsubst`).
+  internal mutating func abstractingProjections(
+    in t: AnyTypeIdentity, through targets: [WitnessExpression],
+    into projections: inout [(TypeVariable.ID, AnyTypeIdentity)]
+  ) -> AnyTypeIdentity {
+    var found: [AnyTypeIdentity] = []
+    _ = program.types.map(t) { (s, n) in
+      guard s[n] is AssociatedType else { return .stepInto(n) }
+      var mentioned = false
+      _ = Self.rewritingWitnesses(in: n, of: &s, { (w) in
+        if targets.contains(w) { mentioned = true }
+        return nil
+      })
+      if !mentioned { return .stepInto(n) }
+      if !found.contains(n) { found.append(n) }
+      return .stepOver(n)
+    }
+    if found.isEmpty { return t }
+
+    var replacements: [AnyTypeIdentity: AnyTypeIdentity] = [:]
+    for n in found {
+      let x = fresh()
+      replacements[n] = x.erased
+      projections.append((x, n))
+    }
+    return program.types.map(t) { (_, n) in
+      if let r = replacements[n] { .stepOver(r) } else { .stepInto(n) }
+    }
+  }
+
+  /// Returns `p` in which each of the witnesses `bindings[i].0` is replaced by `bindings[i].1`
+  /// and associated types selected through conformance declarations are replaced by their
+  /// definitions (`headsubst`).
+  internal mutating func projection(
+    _ p: AnyTypeIdentity, binding bindings: [(WitnessExpression, WitnessExpression)]
+  ) -> AnyTypeIdentity {
+    let r = rewritingWitnesses(in: p, { (w) in bindings.first(where: { (b) in b.0 == w })?.1 })
+    return normalizingProjections(in: r)
+  }
+
+  /// Returns `true` iff `target` occurs as a witness in `t`.
+  private mutating func mentions(_ target: WitnessExpression, in t: AnyTypeIdentity) -> Bool {
+    var found = false
+    _ = rewritingWitnesses(in: t, { (w) in if w == target { found = true }; return nil })
+    return found
+  }
+
+  /// Returns `true` iff a witness in `t` is an assumed given.
+  private mutating func mentionsAssumed(_ t: AnyTypeIdentity) -> Bool {
+    var found = false
+    _ = rewritingWitnesses(in: t, { (w) in if case .assumed = w.value { found = true }; return nil })
+    return found
+  }
+
+  /// Returns `true` iff a witness in `w` or in one of its types is an assumed given.
+  private mutating func mentionsAssumed(_ w: WitnessExpression) -> Bool {
+    var found = false
+    _ = rewritingWitnesses(in: w, { (x) in if case .assumed = x.value { found = true }; return nil })
+    return found
+  }
+
+  /// Returns `t` in which each associated type selected through a conformance declaration is
+  /// replaced by its definition, or `.error` if that does not terminate (`premsubst`).
+  ///
+  /// Name resolution never builds `(A::c).X` where `c` is a conformance declaration: it returns
+  /// the definition of `X` in `c`. Substituting the witness of a premise can build such a type.
+  private mutating func normalizingProjections(in t: AnyTypeIdentity) -> AnyTypeIdentity {
+    var t = t
+    for _ in 0 ..< 8 {
+      var found: [AnyTypeIdentity] = []
+      _ = program.types.map(t) { (s, n) in
+        if s[n] is AssociatedType { found.append(n) }
+        return .stepInto(n)
+      }
+      var replacements: [AnyTypeIdentity: AnyTypeIdentity] = [:]
+      for n in found {
+        let a = program.types[n] as! AssociatedType
+        var w = a.qualification
+        while let (_, b) = asCoercionApplication(w) { w = b }
+        guard
+          program.flatCast(w.declaration, to: ConformanceDeclaration.self) != nil,
+          !w.hasVariable, !w.type[.hasError], !mentionsAssumed(w)
+        else { continue }
+        if case .reference = w.value {} else if !TyperExperiments.assocsubst { continue }
+        let m = typeOfImplementation(satisfying: a.declaration, in: a.qualification)
+        replacements[n] = (program.types[m] as? Metatype)?.inhabitant ?? .error
+        TyperCounters.bump("premsubst.normalized")
+      }
+      if replacements.isEmpty { return t }
+      t = program.types.map(t) { (_, n) in
+        if let r = replacements[n] { .stepOver(r) } else { .stepInto(n) }
+      }
+      if t[.hasError] { return .error }
+    }
+    return .error
+  }
