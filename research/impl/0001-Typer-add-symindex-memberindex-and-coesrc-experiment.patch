+  }
+
+  /// Returns the traits visible from `scopeOfUse` indexed by the identifiers they declare.
+  private mutating func traitsByName(
+    visibleFrom scopeOfUse: ScopeIdentity
+  ) -> [String: [TraitDeclaration.ID]] {
+    if let m = cache.scopeToTraitsByName[scopeOfUse] {
+      return m
+    } else if let p = program.parent(containing: scopeOfUse) {
+      // Mirrors `traits(visibleFrom:)`: the traits of `p` followed by those declared here.
+      var m = traitsByName(visibleFrom: p)
+      let ds = program.declarations(lexicallyIn: scopeOfUse)
+      for d in program.collect(TraitDeclaration.self, in: ds) {
+        for k in declarations(lexicallyIn: .init(node: d)).keys { m[k, default: []].append(d) }
+      }
+      cache.scopeToTraitsByName[scopeOfUse] = m
+      return m
+    } else {
+      var m: [String: [TraitDeclaration.ID]] = [:]
+      for d in traits(visibleFrom: scopeOfUse) {
+        for k in declarations(lexicallyIn: .init(node: d)).keys { m[k, default: []].append(d) }
+      }
+      cache.scopeToTraitsByName[scopeOfUse] = m
+      return m
+    }
+  }
