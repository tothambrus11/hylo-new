   ///
   /// This method must be called before type checking the standard library.
   internal mutating func initializeStandardLibraryCaches() {
+    if TyperExperiments.symindex {
+      initializeStandardLibraryCachesInOnePass()
+      return
+    }
     for n in Program.StandardLibraryEntity.allCases {
       guard
         let a = identity(module: Module.standardLibraryName),
@@ -2017,6 +2021,31 @@ extension Program {
     }
   }
 
+  /// Fills `program.standardLibraryDeclarations` with a single scan of the standard library.
+  ///
+  /// The result is the same as one `select(from:_:)` scan per entity: nodes are visited in the
+  /// same order and matched with the same predicate (`symbol(annotating:)`).
+  private mutating func initializeStandardLibraryCachesInOnePass() {
+    var table: [String: [AnySyntaxIdentity]] = [:]
+    if let a = identity(module: Module.standardLibraryName) {
+      for n in modules.values[a].syntax {
+        if let s = symbol(annotating: n) { table[s, default: []].append(n) }
+      }
+    }
+    for n in Program.StandardLibraryEntity.allCases {
+      guard
+        let b = table[n.rawValue]?.uniqueElement,
+        let d = castToDeclaration(b)
+      else {
+        precondition(
+          allowPartialStandardLibrary,
+          "missing or corrupt standard library; missing \(n.rawValue)")
+        continue
+      }
+      standardLibraryDeclarations[n] = d
+    }
+  }
+
 }
 
