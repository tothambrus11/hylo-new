+  /// Returns the extensions that are visible from `scopeOfUse` and that lexically declare a
+  /// member with identifier `n`, in the order of `extensions(visibleFrom: scopeOfUse)`.
+  private mutating func extensions(
+    named n: String, visibleFrom scopeOfUse: ScopeIdentity
+  ) -> [ExtensionDeclaration.ID] {
+    extensionsByName(visibleFrom: scopeOfUse)[n] ?? []
+  }
+
+  /// Returns the extensions visible from `scopeOfUse` indexed by the identifiers they declare.
+  private mutating func extensionsByName(
+    visibleFrom scopeOfUse: ScopeIdentity
+  ) -> [String: [ExtensionDeclaration.ID]] {
+    if let m = cache.scopeToExtensionsByName[scopeOfUse] {
+      return m
+    } else if let p = program.parent(containing: scopeOfUse) {
+      var m = extensionsByName(visibleFrom: p)
+      for e in program.declarations(of: ExtensionDeclaration.self, lexicallyIn: scopeOfUse) {
+        for k in declarations(lexicallyIn: .init(node: e)).keys { m[k, default: []].append(e) }
+      }
+      cache.scopeToExtensionsByName[scopeOfUse] = m
+      return m
+    } else if let m = cache.sourceToExtensionsByName[scopeOfUse.file.offset] {
+      return m
+    } else {
+      var m: [String: [ExtensionDeclaration.ID]] = [:]
+      for e in extensions(visibleAtTopLevelOf: scopeOfUse.file) {
+        for k in declarations(lexicallyIn: .init(node: e)).keys { m[k, default: []].append(e) }
+      }
+      cache.sourceToExtensionsByName[scopeOfUse.file.offset] = m
+      return m
+    }
+  }
+
+  /// Returns the traits visible from `scopeOfUse` that lexically declare a member with
