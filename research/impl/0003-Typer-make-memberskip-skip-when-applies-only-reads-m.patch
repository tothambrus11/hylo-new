+  /// The classification of the head of a type used by `appliesTriviallyFails`.
+  internal struct HeadShape: Equatable {
+
+    /// The head.
+    let head: AnyTypeIdentity
+
+    /// The dynamic type of the head's tree.
+    let kind: ObjectIdentifier
+
+    /// `true` iff the head is a struct, enum, trait, or machine type.
+    let isAtom: Bool
+
+  }
+
+  /// Returns the shape of the head of `t` if it can be used to predict a unification failure, or
+  /// `nil` if `t` contains errors or its head is a variable, an alias, or a generic parameter.
+  ///
+  /// Unification may see through variables, aliases, and generic parameters (the latter once
+  /// opened in an extendee), so these heads give no prediction.
+  private func headShape(of t: AnyTypeIdentity) -> HeadShape? {
+    if t[.hasError] { return nil }
+    let h = program.types.contextAndHead(t).head
+    if h.isVariable { return nil }
+    let x = program.types[h]
+    if (x is TypeAlias) || (x is GenericParameter) { return nil }
+    let atom = (x is Struct) || (x is Enum) || (x is Trait) || (x is MachineType)
+    return .init(head: h, kind: ObjectIdentifier(type(of: x)), isAtom: atom)
+  }
+
+  /// Returns the head shape of the extendee of `e` if it is already memoized.
+  ///
+  /// This method never evaluates the extendee, so it has no side effect on the typer's state.
+  private mutating func memoizedExtendeeShape(_ e: ExtensionDeclaration.ID) -> HeadShape? {
+    if let s = cache.extendeeShape[e] { return s }
+    guard let u = program[e.module].type(assignedTo: e) else { return nil }
+    let s = headShape(of: u)
+    cache.extendeeShape[e] = .some(s)
+    return s
+  }
+
+  /// Returns `true` if `applies(e, to: q, in: scopeOfUse)` has no observable effect other than
+  /// allocating fresh type variables, inserting types in the type store, and filling caches with
+  /// values that any later computation would reproduce, given that `qs` is `headShape(of: q)`
+  /// and `settled` is either `nil` or `allGivensSettled(visibleFrom: scopeOfUse)`.
+  ///
+  /// That holds if the extendee of `e` is memoized and either the match fails at the root (see
+  /// `appliesTriviallyFails`) or the type of every given visible from `scopeOfUse` is memoized,
+  /// in which case implicit resolution only reads memoized types.
+  private mutating func appliesHasNoEffect(
+    _ e: ExtensionDeclaration.ID, to qs: HeadShape?, givensSettled settled: inout Bool?,
+    in scopeOfUse: ScopeIdentity
+  ) -> Bool {
+    if program[e.module].type(assignedTo: e) == nil { return false }
+    if let qs, appliesTriviallyFails(e, toTypeWithHead: qs) { return true }
+    if settled == nil { settled = allGivensSettled(visibleFrom: scopeOfUse) }
+    if settled! { TyperCounters.bump("memberskip.settled") }
+    return settled!
+  }
+
+  /// Returns `true` iff the types of all givens visible from `s`, including those that are on the
+  /// stack, are memoized. The result does not depend on which declarations are on the stack.
+  private mutating func allGivensSettled(visibleFrom s: ScopeIdentity) -> Bool {
+    if cache.scopesWithSettledGivens.contains(s) { return true }
+    for x in program.scopes(from: s) {
+      for g in givens(lexicallyIn: x) where !isSettled(g) { return false }
+    }
+    for f in program[s.module].sourceFileIdentities where f != s.file {
+      for g in givens(lexicallyIn: .init(file: f)) where !isSettled(g) { return false }
+    }
+    for i in imports(of: s.file) {
+      for g in givens(atTopLevelOf: i) where !isSettled(g) { return false }
+    }
+    // Memoized types are never overwritten, so the property is monotonic.
+    cache.scopesWithSettledGivens.insert(s)
+    return true
+  }
+
+  /// Returns `true` iff computing `declaredType(of: g)` only reads memoized results.
+  private func isSettled(_ g: Given) -> Bool {
+    switch g {
+    case .user(let d):
+      return program[d.module].type(assignedTo: d) != nil
+    case .nested(let t, let h):
+      return (cache.traitToTypeOfTraitSelf[t] != nil) && isSettled(h)
+    default:
+      return true
+    }
+  }
+
