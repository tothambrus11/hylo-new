+  /// Computes the signature of each of `nodes` in order, reading the signatures used by lookups
+  /// and resolutions from `signatureTable`, and returns the signatures that have no error.
+  private mutating func signatureRound(
+    _ nodes: [DeclarationIdentity]
+  ) -> [DeclarationIdentity: AnyTypeIdentity] {
+    hiddenCandidateSeen = false
+    var next: [DeclarationIdentity: AnyTypeIdentity] = [:]
+    for n in nodes {
+      let t = computedSignature(of: n)
+      if !t[.hasError] { next[n] = t }
+    }
+    TyperCounters.bump("sigrounds.rounds")
+    return next
+  }
+
+  /// Computes the signatures of the extensions and givens of `module` in rounds, each reading the
+  /// signatures of the previous one, until they are stable (`sigrounds`).
+  ///
+  /// The signature of an extension or given can depend on a lookup or resolution for which
+  /// another one, or itself, is a candidate. Evaluating signatures on demand makes the result
+  /// depend on which is requested first. Here, a round computes every signature from a pristine
+  /// state and the table of the previous round only, so each table is a function of the program.
+  private mutating func settleSignatures() {
+    let nodes = program[module].syntax
+      .compactMap({ (n) in program.castToDeclaration(n) }).filter(isSignatureNode(_:))
+    if nodes.isEmpty { return }
+    TyperCounters.bump("sigrounds.nodes", by: nodes.count)
+
+    let pristine = (program[module], cache)
+    settlingSignatures = true
+    defer { settlingSignatures = false }
+    signatureTable = [:]
+    var earlier: [[DeclarationIdentity: AnyTypeIdentity]] = []
+
+    for round in 1 ... (nodes.count + 2) {
+      let next = signatureRound(nodes)
+
+      if (next == signatureTable) || ((round == 1) && !hiddenCandidateSeen) {
+        if TyperExperiments.selfcheck { selfCheckSignatures(nodes, next, from: pristine) }
+        signatureTable = next
+        return
+      }
+      if earlier.contains(next) || (round == nodes.count + 2) {
+        reportUnstableSignatures(nodes, signatureTable, next)
+        signatureTable = next
+        return
+      }
+      earlier.append(signatureTable)
+      signatureTable = next
+      (program[module], cache) = pristine
+      reportedBudgetScopes = []
+      TyperCounters.bump("sigrounds.restores")
+    }
+  }
+
+  /// Checks that the round that computed `stable` from `signatureTable` computes the same table
+  /// and the same diagnostics when it is run again from `pristine` with the nodes in reverse
+  /// order (`selfcheck`).
+  private mutating func selfCheckSignatures(
+    _ nodes: [DeclarationIdentity], _ stable: [DeclarationIdentity: AnyTypeIdentity],
+    from pristine: (Module, Memos)
+  ) {
+    let final = (program[module], cache, reportedBudgetScopes, hiddenCandidateSeen)
+    let expected = Set(program[module].diagnostics.map(\.description))
+    (program[module], cache) = pristine
+    reportedBudgetScopes = []
+    let again = signatureRound(nodes.reversed())
+    let found = Set(program[module].diagnostics.map(\.description))
+    TyperCounters.bump("selfcheck.sigrounds")
+    if again != stable {
+      selfCheckViolation("sigrounds: the stable round computes another table in reverse order")
+    } else if found != expected {
+      selfCheckViolation("sigrounds: the stable round reports other diagnostics in reverse order")
+    }
+    (program[module], cache, reportedBudgetScopes, hiddenCandidateSeen) = final
+  }
+
+  /// Reports that the signatures of the declarations whose entries differ in `a` and `b` did not
+  /// stabilize.
+  private mutating func reportUnstableSignatures(
+    _ nodes: [DeclarationIdentity],
+    _ a: [DeclarationIdentity: AnyTypeIdentity], _ b: [DeclarationIdentity: AnyTypeIdentity]
+  ) {
+    TyperCounters.bump("sigrounds.unstable")
