+  /// Returns `n` with the keys in `substitutions` substituted with their corresponding values,
+  /// ignoring bound parameters and substituting in the aliasees of type aliases.
+  ///
+  /// `substitute(_:in:)` does not visit the aliasee of a type alias. A type alias whose aliasee
+  /// is changed by the substitution is replaced by its substituted aliasee.
+  public mutating func substituteThroughAliases(
+    _ substitutions: [AnyTypeIdentity: AnyTypeIdentity], in n: AnyTypeIdentity
+  ) -> AnyTypeIdentity {
+    if substitutions.isEmpty { return n }
+    return self.map(n) { (s, t) in
+      if let u = s[t] as? UniversalType {
+        let r = substitutions.removing(keys: u.parameters)
+        let h = s.substituteThroughAliases(r, in: u.head)
+        return .stepOver(s.demand(UniversalType(parameters: u.parameters, head: h)).erased)
+      } else if let u = substitutions[t] {
+        return .stepOver(u)
+      } else if let a = s[t] as? TypeAlias {
+        let x = s.substituteThroughAliases(substitutions, in: a.aliasee)
+        return .stepOver((x == a.aliasee) ? t : x)
+      } else {
+        return .stepInto(t)
+      }
+    }
+  }
