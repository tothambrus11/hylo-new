   nonisolated(unsafe) public static var absmodel: Bool = enabled.contains("absmodel")
 
-  /// Index visible extensions and traits by the identifiers of the members they declare.
-  nonisolated(unsafe) public static var memberindex: Bool = enabled.contains("memberindex")
+  /// Index visible traits by the identifiers of the members they declare.
+  nonisolated(unsafe) public static var traitindex: Bool = enabled.contains("traitindex")
+
+  /// Skip extensions that do not declare the looked-up name when their applicability check is
+  /// known to fail without observable effects.
+  nonisolated(unsafe) public static var memberskip: Bool = enabled.contains("memberskip")
 
   /// Remember which givens can never be used to derive a coercion.
   nonisolated(unsafe) public static var coesrc: Bool = enabled.contains("coesrc")
