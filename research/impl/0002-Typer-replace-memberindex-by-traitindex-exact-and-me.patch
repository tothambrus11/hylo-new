+  /// Returns `true` if `applies(e, to: q, in: s)` is known to return `nil` for any `s`, with no
+  /// effect other than allocating fresh type variables and filling caches with `nil`.
+  ///
+  /// That is the case if the type of `e`'s extendee is already memoized and if its head and the
+  /// head of `q` are such that the match judgement of implicit resolution fails at the root:
+  /// unification then reports only the coercion `(a, b)` between the two heads, which `match`
+  /// rejects without querying givens. It happens if the heads have different kinds, or if both
+  /// are distinct nominal or machine types. Variables, aliases and generic parameters are excluded
+  /// since unification may see through them, and so are other kinds having the same shape, since
+  /// they are unified structurally.
+  private func appliesTriviallyFails(
+    _ e: ExtensionDeclaration.ID, to q: AnyTypeIdentity
+  ) -> Bool {
+    guard
+      let u = program[e.module].type(assignedTo: e), !u[.hasError], !q[.hasError]
+    else { return false }
+
+    let a = program.types.contextAndHead(u).head
+    let b = program.types.contextAndHead(q).head
+    if (a == b) || a.isVariable || b.isVariable { return false }
+
+    let x = program.types[a]
+    let y = program.types[b]
+    if (x is TypeAlias) || (y is TypeAlias) || (x is GenericParameter) { return false }
+    if type(of: x) != type(of: y) { return true }
+    switch x {
+    case is Struct, is Enum, is Trait, is MachineType:
+      return true
+    default:
+      return false
     }
   }
 
