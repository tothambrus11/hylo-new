       if TyperExperiments.enabled.contains("trace") {
         e.log.append("  solved with \(program.show(operand.witness)); now prove $\(i): \(program.show(assumed)) [pending: " + e.givens.map({ (g) in if case .assumed(let j, let t) = g { "$\(j): \(program.show(t))" } else { "?" } }).joined(separator: ", ") + "]")
@@ -4083,15 +4179,72 @@ public struct Typer {
   /// - Requires: The types of the witnesses in `threads` have no context.
   private mutating func takeSummonResults(
     from threads: [ResolutionThread], in scopeOfUse: ScopeIdentity
+  ) -> [SummonResult] {
+    let eagerAtEntry = eagerDecisions
+    let result = takeSummonResultsUnchecked(from: threads, in: scopeOfUse)
+
+    // Self-check (`eqeager`): the resolution must give the same results when the equalities of
+    // matches are assumed and proved by search, unless search runs out of depth or work.
+    if TyperExperiments.selfcheck && (selfCheck == .none) && (eagerDecisions != eagerAtEntry) {
+      let saved = (selfCheck, selfCheckInconclusive)
+      (selfCheck, selfCheckInconclusive, eagerDecisionsDisabled) = (.replay, false, true)
+      let expected = takeSummonResultsUnchecked(from: threads, in: scopeOfUse)
+      let inconclusive = selfCheckInconclusive || lastResolutionExhaustedDepth
+      (selfCheck, selfCheckInconclusive, eagerDecisionsDisabled) = (saved.0, saved.1, false)
+      func key(_ r: SummonResult) -> String {
+        "\(r.penalties): " + erasingVariableNames(program.show(r.witness))
+      }
+      if result.map(key).sorted() == expected.map(key).sorted() {
+        TyperCounters.bump("selfcheck.eager.confirmed")
+      } else if inconclusive && expected.isEmpty {
+        TyperCounters.bump("selfcheck.eager.beyondSearch")
+      } else {
+        selfCheckViolation(
+          "deciding equalities in match changed the results of \(threads.first.map({ (t) in program.show(t.queried) }) ?? "?"): "
+            + "\(result.map(key).sorted()) instead of \(expected.map(key).sorted())")
+      }
+    }
+    return result
+  }
+
+  /// Returns `s` with the name of every unification variable replaced by a placeholder.
+  private func erasingVariableNames(_ s: String) -> String {
+    var r = ""
+    var i = s.startIndex
+    while i < s.endIndex {
+      if s[i] == "%" {
+        r.append("%_")
+        i = s.index(after: i)
+        while i < s.endIndex, s[i].isLetter || s[i].isNumber { i = s.index(after: i) }
+      } else {
+        r.append(s[i])
+        i = s.index(after: i)
+      }
+    }
+    return r
+  }
+
+  /// Implements `takeSummonResults(from:in:)`.
+  private mutating func takeSummonResultsUnchecked(
+    from threads: [ResolutionThread], in scopeOfUse: ScopeIdentity
   ) -> [SummonResult] {
     var work = threads
     var done: [SummonResult] = []
     var depth = 0
     let matchesAtEntry = matchCount
+    lastResolutionExhaustedDepth = false
+
+    // Layers spent waiting for equalities decided in `match` do not count against the bound.
+    func bound(_ ts: [ResolutionThread]) -> Int {
+      TyperExperiments.eqeager
+        ? maxImplicitDepth + (ts.lazy.map(\.environment.credit).max() ?? 0) : maxImplicitDepth
+    }
 
-    while done.isEmpty && !work.isEmpty && (depth < maxImplicitDepth) {
+    while done.isEmpty && !work.isEmpty && (depth < bound(work)) {
       var next: [ResolutionThread] = []
       for item in work {
+        if item.delay > 0 { next.append(item.waiting()); continue }
+        if depth - item.environment.credit >= maxImplicitDepth { continue }
         switch match(item, in: scopeOfUse) {
         case .done(let r): done.append(r)
         case .next(let s): next.append(contentsOf: s)
@@ -4119,6 +4272,7 @@ public struct Typer {
       }
       if depth == maxImplicitDepth && done.isEmpty && !work.isEmpty {
         TyperCounters.bump("summon.depthExhausted")
+        lastResolutionExhaustedDepth = true
       }
     }
 
