+  /// Returns the step following a match of `thread`, whose head mentions premises of the thread,
+  /// in which unification left the mismatching `parts` (`headsubst`).
+  ///
+  /// A part that pairs the associated type selected through a pending premise `$i` with the
+  /// same associated type selected through a witness `w` is solved by taking `w` for `$i`: `w`
+  /// is a term of the type of the premise, so the premise holds, and no other choice makes the
+  /// two types equal. The thread continues, in the next layer, with `w` substituted for `$i`.
+  /// Any other part that mentions a premise fails the match, as does a variable that would be
+  /// assigned a type mentioning one.
+  private mutating func matchBindingPremises(
+    _ thread: ResolutionThread, _ parts: [(AnyTypeIdentity, AnyTypeIdentity)],
+    keeping substitutions: SubstitutionTable, in scopeOfUse: ScopeIdentity
+  ) -> ResolutionThread.Advanced {
+    var substitutions = substitutions
+    var chosen: [Int: WitnessExpression] = [:]
+    let pending = Set(
+      (thread.environment.givens + thread.environment.deferred).compactMap({ (g) -> Int? in
+        if case .assumed(let i, _) = g { i } else { nil }
+      }))
+
+    for (x, y) in parts {
+      guard
+        let a = program.types[x] as? AssociatedType, let b = program.types[y] as? AssociatedType,
+        a.declaration == b.declaration
+      else {
+        if mentionsAssumed(x) || mentionsAssumed(y) { return .next([]) }
+        continue
+      }
+      let (premise, known): (WitnessExpression, WitnessExpression)
+      if case .assumed = a.qualification.value {
+        (premise, known) = (a.qualification, b.qualification)
+      } else if case .assumed = b.qualification.value {
+        (premise, known) = (b.qualification, a.qualification)
+      } else {
+        if mentionsAssumed(x) || mentionsAssumed(y) { return .next([]) }
+        continue
+      }
+      guard case .assumed(let i) = premise.value, pending.contains(i), !mentionsAssumed(known)
+      else { return .next([]) }
+
+      var s = substitutions
+      let unified = program.types.unifiable(premise.type, known.type, extending: &s) { (_, _) in
+        false
+      }
+      if !unified { return .next([]) }
+      if let w = chosen[i], w != known { return .next([]) }
+      substitutions = s
+      chosen[i] = known
+    }
+
+    let all = thread.environment.substitutions.union(substitutions)
+    if chosen.isEmpty {
+      // Nothing to decide; the head must not leak a premise into the assignments.
+      for (_, u) in substitutions.assignments where mentionsAssumed(u) { return .next([]) }
+      var e = thread.environment
+      e.headBound = false
+      let w = program.types.reify(thread.witness, applying: all, withVariables: .kept)
+      return match(thread.copy(matching: w, to: thread.queried, in: e), in: scopeOfUse)
+    }
+
+    // Substitute the chosen witnesses for the premises, everywhere in the thread.
+    TyperCounters.bump("headsubst.premisesDecided", by: chosen.count)
+    func resolved(_ t: AnyTypeIdentity) -> AnyTypeIdentity {
+      let u = program.types.reify(t, applying: all, withVariables: .kept)
+      return rewritingWitnesses(in: u, { (w) in
+        if case .assumed(let j) = w.value { chosen[j] } else { nil }
+      })
+    }
+    func kept(_ gs: [Given]) -> [Given] {
+      gs.compactMap({ (g) -> Given? in
+        guard case .assumed(let j, let t) = g else { return g }
+        return (chosen[j] != nil) ? nil : .assumed(j, resolved(t))
+      })
+    }
+    var e = thread.environment.with(substitutions: all, givens: kept(thread.environment.givens))
+    e.deferred = kept(thread.environment.deferred)
+    e.headBound = false
+    let r = program.types.reify(thread.witness, applying: all, withVariables: .kept)
+    let w = rewritingWitnesses(in: r, { (x) in
+      if case .assumed(let j) = x.value { chosen[j] } else { nil }
+    })
+    if mentionsAssumed(w.type) || w.type[.hasError] { return .next([]) }
+    return .next([thread.copy(matching: w, to: thread.queried, in: e)])
+  }
