trait P {}
struct S0 {}
trait R0 { given S0 is P }
struct S1 {}
trait R1 { given S1 is P }
struct S2 {}
trait R2 { given S2 is P }
struct S3 {}
trait R3 { given S3 is P }
struct S4 {}
trait R4 { given S4 is P }
struct S5 {}
trait R5 { given S5 is P }
struct S6 {}
trait R6 { given S6 is P }
struct S7 {}
trait R7 { given S7 is P }
fun use<T>(x: T) {}
fun f<T is R0 & R1 & R2 & R3 & R4 & R5 & R6 & R7>() {
  use(summon[P<S0>])
  use(summon[P<S1>])
  use(summon[P<S2>])
  use(summon[P<S3>])
  use(summon[P<S4>])
  use(summon[P<S5>])
  use(summon[P<S6>])
  use(summon[P<S7>])
}
