public fun main() { f<A, A>() }
fun f<T, U where T is P, U is P, T.X == U.X, T.X is Q, W<U.X> is R>() {}
given <V where V is Q> => W<V> is R {}
given Pair<B, D> is S0 {}
given D is R {}
given B is Q {}
given C is P2 { type Y = D }
given A is P { type X = B }
struct W<X> {}
struct Pair<X, Y> {}
struct D {}
struct C {}
struct B {}
struct A {}
trait S0 {}
trait R {}
trait Q {}
trait P2 { type Y }
trait P { type X }
