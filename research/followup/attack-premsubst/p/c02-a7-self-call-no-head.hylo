// As c01 but the value of type A.X does not come from a parameter typed A.X (which the call
// would check): it is the T-typed parameter of a first call. h<T where A is P, A.X is Q, T is R>
// calls itself with T := T (fine), and k calls h with T := A.X explicitly.
// ILL TYPED: in k, `A.X is R` is not known for the X of k's requirement.
trait P { type X }
trait Q {}
trait R { fun show() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
given B is Q {}
given C is Q {}
given C is R { fun show() {} }
fun k<T where A is P, A.X is Q, T is R>(x: T, y: A.X) {
  given A is P { type X = C }
  k<A.X>(y, y)
}
