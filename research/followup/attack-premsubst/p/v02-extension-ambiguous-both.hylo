// A conditional extension with a dependent requirement; A has two conformances and both satisfy it
// (B is Q, C is Q). The member returns T.X: a B or a C depending on the witness.
// ILL TYPED (ambiguous): must be rejected; in particular the result must not be usable as a B.
trait P { type X
  fun get() -> X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct Box<T> { var t: T
  public memberwise init }
given B is Q {}
given C is Q {}
given A is P { type X = B
  fun get() -> B { B() } }
given A is P { type X = C
  fun get() -> C { C() } }
extension <T where T is P, T.X is Q> Box<T> { fun first() -> T.X { self.t.get() } }
public fun main() { let x: B = Box<A>(t: A()).first() }
