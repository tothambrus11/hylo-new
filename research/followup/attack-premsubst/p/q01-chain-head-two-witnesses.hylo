// The result type is a projection through a DEPENDENT requirement (T.X.X). The two calls of f<A>
// are discharged with different witnesses of `B is P` (declared: X = C0; local: X = C1), so the
// first returns a C0 and the second a C1. ILL TYPED: the second result is assigned to the
// variable that holds the first.
trait P { type X
  fun get() -> X }
struct A { public memberwise init }
struct B { public memberwise init }
struct C0 { public memberwise init }
struct C1 { public memberwise init }
given A is P { type X = B
  fun get() -> B { B() } }
given B is P { type X = C0
  fun get() -> C0 { C0() } }
fun f<T where T is P, T.X is P>(t: T) -> T.X.X { t.get().get() }
fun h(a: A) {
  var v = f<A>(a)
  if true {
    given B is P { type X = C1
      fun get() -> C1 { C1() } }
    v = f<A>(a)
  }
}
