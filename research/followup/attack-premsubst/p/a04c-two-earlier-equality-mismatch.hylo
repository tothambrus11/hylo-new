// T.X == U.Y, concrete caller: A.X = B but C.Y = D. ILL TYPED: B == D does not hold.
trait P { type X }
trait R { type Y }
struct A {}
struct B {}
struct C {}
struct D {}
given A is P { type X = B }
given C is R { type Y = D }
fun f<T, U where T is P, U is R, T.X == U.Y>() {}
public fun main() { f<A, C>() }
