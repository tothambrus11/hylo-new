// A dependent requirement and a parameter typed by the projection, with two conformances of A
// (X = B, B is Q; X = C, C is not Q). The only consistent instantiation has X = B.
// ILL TYPED: the argument is a C.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
given B is Q {}
given A is P { type X = B }
given A is P { type X = C }
fun f<T where T is P, T.X is Q>(t: T, x: T.X) {}
public fun main() { f<A>(A(), C()) }
