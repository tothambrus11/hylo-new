// Closed form of e06. At top level, BX = Box<A>.X is A.X through the declared conformance, i.e. B
// (the program states `BX is Q`). In h, a nearer conformance `A is P` has X = C, and C is not Q.
// f<Box<A>> in h is discharged with `Box<A> is P` built on the LOCAL conformance, whose X is C.
// ILL TYPED: f needs `C is Q`. If accepted, f runs the `use` declared for Box<A>.X = B on a C.
trait P { type X
  fun get() -> X }
trait Q { fun use() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct Box<T> { var t: T
  public memberwise init }
given A is P { type X = B
  fun get() -> B { B() } }
given <T where T is P> => Box<T> is P { type X = T.X
  fun get() -> T.X { self.t.get() } }
type BA = Box<A>
type BX = BA.X
given BX is Q { fun use() {} }
fun f<T where T is P, T.X is Q>(t: T) { t.get().use() }
fun h(b: Box<A>) {
  if true {
    given A is P { type X = C
      fun get() -> C { C() } }
    f<Box<A>>(b)
  }
}
public fun main() { h(Box<A>(t: A())) }
