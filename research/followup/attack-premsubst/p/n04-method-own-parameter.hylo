// A method with dependent requirements on its OWN generic parameter (one clause). Well typed.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
given B is Q {}
given A is P { type X = B }
struct K {
  public memberwise init
  fun m<T where T is P, T.X is Q>(x: T) {}
}
fun g<U where U is P, U.X is Q>(k: K, u: U) { k.m(u) }
public fun main() { K().m(A()) }
