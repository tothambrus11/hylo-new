// Control of d01, ILL TYPED: A.X = B is not Q, so `first` is not a member of Box<A>.
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
given A is Q {}
given A is P { type X = B }
extension <T where T is P, T.X is Q> Box<T> { fun first() {} }
public fun main() { Box<A>().first() }
