// Control of w01, ILL TYPED: U = C is not A.X (= B), although C is P and C.X is Q.
trait P { type X }
trait Q {}
struct A {}
struct B {}
struct C {}
given A is P { type X = B }
given B is P { type X = C }
given C is P { type X = C }
given C is Q {}
fun f<T, U where T is P, U == T.X, U is P, U.X is Q>() {}
public fun main() { f<A, C>() }
