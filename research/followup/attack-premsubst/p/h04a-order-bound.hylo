// Where-clause order and the depth bound, dependent requirements. WELL TYPED: A.X = B, B is Q
// (5 steps), S<B> is R (1 step + B is Q). With `T.X is Q` before `S<T.X> is R`, the former is a
// hypothesis for the latter. ORDER: same verdict as h04b expected.
trait P { type X }
trait Q {}
trait R {}
struct A {}
struct B {}
struct A0 {}
struct A1 {}
struct A2 {}
struct A3 {}
struct S<T> {}
given A0 is Q {}
given A1 is Q {}
given A2 is Q {}
given A3 is Q {}
given <where A0 is Q, A1 is Q, A2 is Q, A3 is Q> => B is Q {}
given A is P { type X = B }
given <V where V is Q> => S<V> is R {}
fun f<T where T is P, T.X is Q, S<T.X> is R>() {}
public fun main() { f<A>() }
