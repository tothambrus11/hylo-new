// Control of c08 without the local conformance: ILL TYPED for the same reason, must be rejected.
trait P { type X
  fun get() -> X }
trait Q {}
trait R { fun show() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct D { public memberwise init }
given B is Q {}
given C is Q {}
given C is R { fun show() {} }
given D is R { fun show() {} }
given A is P { type X = B
  fun get() -> B { B() } }
fun f<T, V where T is P, T.X is Q, V is R>(t: T, v: V) {
  v.show()
  type TX = T.X
  let w = t.get()
  if true {
    f<T, TX>(t, w)
  }
}
public fun main() { f<A, D>(A(), D()) }
