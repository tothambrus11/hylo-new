// As v03 with a nearer conformance of A (X = C, C is Q) in the scope of a second call. The first
// call returns a B, the second a C. ILL TYPED: the second result is assigned to the variable that
// holds the first.
trait P { type X
  fun get() -> X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct Box<T> { var t: T
  public memberwise init }
given B is Q {}
given C is Q {}
given A is P { type X = B
  fun get() -> B { B() } }
extension <T where T is P, T.X is Q> Box<T> { fun first() -> T.X { self.t.get() } }
fun h(b: Box<A>) {
  var v = b.first()
  if true {
    given A is P { type X = C
      fun get() -> C { C() } }
    v = b.first()
  }
}
