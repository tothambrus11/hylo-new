// Control of b02: the result is used as a B. Well typed if f<A> is accepted through the declared
// conformance although g's own requirement is nearer (design question 4).
trait P { type X
  fun get() -> X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
given B is Q {}
given A is P { type X = B
  fun get() -> B { B() } }
fun f<T where T is P, T.X is Q>(t: T) -> T.X { t.get() }
fun g<where A is P>(a: A) {
  let x: B = f<A>(a)
}
