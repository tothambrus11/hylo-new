// Control of c04, ILL TYPED for the same reason, with no second witness of `T is P` in scope of
// the call: the nested function has no requirement of its own. Must be rejected.
trait P { type X
  fun get() -> X }
trait Q {}
trait R { fun show() }
struct A { public memberwise init }
struct B { public memberwise init }
struct D { public memberwise init }
given B is Q {}
given D is R { fun show() {} }
given A is P { type X = B
  fun get() -> B { B() } }
fun f<T, V where T is P, T.X is Q, V is R>(t: T, v: V) {
  v.show()
  let w = t.get()
  fun inner() {
    f(t, w)
  }
  inner()
}
public fun main() { f<A, D>(A(), D()) }
