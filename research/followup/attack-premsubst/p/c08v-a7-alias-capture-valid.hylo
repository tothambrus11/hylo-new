// Valid twin of c08: f also requires `T.X is R`, so the call is WELL TYPED through f's own
// requirements. Must be accepted, and the elaboration must pass f's own requirements (trace).
trait P { type X
  fun get() -> X }
trait Q {}
trait R { fun show() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct D { public memberwise init }
given B is Q {}
given C is Q {}
given C is R { fun show() {} }
given D is R { fun show() {} }
given A is P { type X = B
  fun get() -> B { B() } }
given B is R { fun show() {} }
fun f<T, V where T is P, T.X is Q, T.X is R, V is R>(t: T, v: V) {
  v.show()
  type TX = T.X
  let w = t.get()
  if true {
    given T is P { type X = C
      fun get() -> C { C() } }
    f<T, TX>(t, w)
  }
}
public fun main() { f<A, D>(A(), D()) }
