// As h01 with a concrete caller: A.X = B, B is Q, S<B> is R through the given. Well typed.
trait P { type X }
trait Q {}
trait R {}
struct A {}
struct B {}
struct S<T> {}
given B is Q {}
given A is P { type X = B }
given <V where V is Q> => S<V> is R {}
fun f<T where T is P, T.X is Q, S<T.X> is R>() {}
public fun main() { f<A>() }
