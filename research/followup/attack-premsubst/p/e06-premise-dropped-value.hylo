// The X of a conditional conformance, Box<T>.X = T.X, read with the premise of the conformance
// dropped. `h` states `Box<A>.X is Q` in its signature, where `A is P` is the declared conformance
// (X = B). In the body, a nearer local conformance `A is P` has X = C, and C is not Q.
// f<Box<A>> in the body is discharged with Box<A> is P built on the LOCAL conformance; its X is C.
// ILL TYPED: f needs `C is Q`. If accepted, `t.get().use()` in f calls B's `use` on a C.
trait P { type X
  fun get() -> X }
trait Q { fun use() }
struct A { public memberwise init }
struct B { public memberwise init }
struct C { public memberwise init }
struct Box<T> { public memberwise init }
given B is Q { fun use() {} }
given A is P { type X = B
  fun get() -> B { B() } }
given <T where T is P> => Box<T> is P { type X = T.X
  fun get() -> T.X { T.X() } }
fun f<T where T is P, T.X is Q>(t: T) { t.get().use() }
type BA = Box<A>
fun h<where BA.X is Q>(b: Box<A>) {
  given A is P { type X = C
    fun get() -> C { C() } }
  f<Box<A>>(b)
}
