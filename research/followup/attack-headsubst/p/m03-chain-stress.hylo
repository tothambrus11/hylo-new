// Tests: 24 nested calls, each of which waits for the result of the one inside it.
// Correct verdict: accepted (cost: the counters should grow linearly with the depth).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = A
  fun get() -> A { A() }
  fun put(x: A) {} }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun wantA(a: A) {}
fun q() {
  wantA(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(pick(A())))))))))))))))))))))))))
}
