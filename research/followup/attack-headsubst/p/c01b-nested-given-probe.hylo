// Probe: a given declared in a nested block shadows the one of the function.
// Correct verdict: rejected (1 error: in the block `A.X` is `S1`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
enum Opt<Z> { case none
  case some(v: Z) }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun outer() {
  given A is P { type X = S0
    fun get() -> S0 { S0() }
    fun put(x: S0) {} }
  wantS0(pick(A()))
  if true {
    given A is P { type X = S1
      fun get() -> S1 { S1() }
      fun put(x: S1) {} }
    wantS1(pick(A()))
    wantS0(pick(A()))
  }
}
