// Tests: the callee is a generic method declared in an extension with its own requirement; both
// requirements occur in the parameters.
// Correct verdict: rejected (2 errors, lines 3 and 4 of main).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
struct B { public memberwise init }
given B is P { type X = S1
  fun get() -> S1 { S1() }
  fun put(x: S1) {} }
extension <T where T is P> Box<T> {
  public fun m<U where U is P>(u: U, x: T.X, y: U.X) -> U.X { u.get() } }
public fun main() {
  let b = Box<A>(v: A())
  wantS1(b.m(B(), S0(), S1()))
  b.m(B(), S1(), S1())
  b.m(B(), S0(), S0())
}
