// Tests: an explicit type application stored in a variable and called later.
// Correct verdict: rejected (1 error, the call with `S1()`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun take<T where T is P>(t: T, x: T.X) -> T.X { x }
public fun main() {
  let f = take<A>
  wantS0(f(A(), S0()))
  f(A(), S1())
}
