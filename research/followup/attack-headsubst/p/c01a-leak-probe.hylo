// Tests: the type of the result when a generic function with a projection is passed to a
// higher-order function (probe for c01).
// Correct verdict: rejected (1 error: `v` is an `S0`, not an `S1`); the last call is valid.
// Every configuration reports both: `v` has the type `(A::r).X`, and `io` is not coerced to a
// function of `Opt<S0>`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
enum Opt<Z> { case none
  case some(v: Z) }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun io<T where T is P>(t: T, x: Opt<T.X>) -> T.X { t.get() }
fun apply2<U, V, W>(f: [](let U, let V) -> W, u: U, v: V) -> W { f(u, v) }
fun outer() {
  given A is P { type X = S0
    fun get() -> S0 { S0() }
    fun put(x: S0) {} }
  let v = apply2(io, A(), Opt.none)
  wantS1(v)
  let o: Opt<S0> = .some(S0())
  let v2 = apply2(io, A(), o)
}
