// Tests: the result of the call is used as a receiver, and as the argument of another call
// with a projection.
// Correct verdict: rejected (2 errors: `only1` is not a member of `S0`; `pick(pick(A()))` needs
// `S0 is P`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
extension S0 { fun only0() {} }
extension S1 { fun only1() {} }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun q() {
  pick(A()).only0()
  pick(A()).only1()
  let y = pick(pick(A()))
}
