// Tests: the callee is a static generic method, selected on a type.
// Correct verdict: rejected (1 error, the second call).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
struct K { public memberwise init
  public static fun m<U where U is P>(u: U, x: U.X) -> U.X { u.get() } }
public fun main() {
  wantS0(K.m(A(), S0()))
  wantS1(K.m(A(), S0()))
}
