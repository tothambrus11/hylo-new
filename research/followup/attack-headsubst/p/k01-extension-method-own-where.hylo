// Tests: a method of a conditional extension whose own where clause relates its projection to
// the one of the extension.
// Correct verdict: rejected (2 errors: `b.m(B())`, because `B.X` is not `A.X`; `wantS1`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
struct B { public memberwise init }
given B is P { type X = S1
  fun get() -> S1 { S1() }
  fun put(x: S1) {} }
struct C { public memberwise init }
given C is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
extension <T where T is P> Box<T> {
  fun m<U where U is P, U.X == T.X>(u: U) -> U.X { self.v.get() }
}
fun q(b: Box<A>) {
  wantS0(b.m(C()))
  wantS0(b.m(B()))
  wantS1(b.m(C()))
}
