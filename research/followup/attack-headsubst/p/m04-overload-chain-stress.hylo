// Tests: 8 nested calls of an overloaded function, one candidate of which has a projection.
// Correct verdict: accepted (cost: forks should not grow exponentially).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = A
  fun get() -> A { A() }
  fun put(x: A) {} }
fun o<T where T is P>(t: T) -> T.X { t.get() }
fun o(t: S1) -> S1 { t }
fun wantA(a: A) {}
fun q() {
  wantA(o(o(o(o(o(o(o(o(A())))))))))
}
