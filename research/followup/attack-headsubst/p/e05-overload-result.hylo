// Tests: overloads that differ by the trait whose projection they return.
// Correct verdict: rejected (the last call only): `A` is only `P`, so `h(A())` is an `S0`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
trait Q { type X; fun other() -> X }
struct B { public memberwise init }
given B is Q { type X = S1
  fun other() -> S1 { S1() } }
fun h<T where T is P>(t: T) -> T.X { t.get() }
fun h<T where T is Q>(t: T) -> T.X { t.other() }
fun q() {
  wantS0(h(A()))
  wantS1(h(B()))
  wantS1(h(A()))
}
