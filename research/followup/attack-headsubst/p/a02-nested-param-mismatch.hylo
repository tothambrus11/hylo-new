// Tests: a projection nested in a parameter type (`Box<T.X>`); the argument coercion is not
// postponed, because the parameter is not itself the variable standing for the projection.
// Correct verdict: rejected; `x` is a `Box<D>` and the parameter is a `Box<A.X>` = `Box<C>`.
trait P { type X }
struct A { public memberwise init }
struct C { public memberwise init }
struct D { public memberwise init }
struct Box<T> { public memberwise init }
given A is P { type X = C }
fun wrap<T where T is P>(t: T, x: Box<T.X>) {}
fun q(x: Box<D>) { wrap(A(), x) }
