// Control of g03 at depth 3. Correct verdict: rejected (2 errors).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
given <T where T is P> => Box<T> is P { type X = Box<T.X>
  fun get() -> Box<T.X> { Box<T.X>(v: self.v.get()) }
  fun put(x: Box<T.X>) { self.v.put(x.v) } }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun take<T where T is P>(t: T, x: T.X) { t.put(x) }
type B3 = Box<Box<Box<A>>>
fun q(b: B3) {
  wantS1(pick(b))
  take(b, S1())
}
