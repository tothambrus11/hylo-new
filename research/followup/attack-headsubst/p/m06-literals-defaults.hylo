// Tests: literal arguments for a projection parameter, and a defaulted parameter after it.
// Correct verdict: rejected (the calls with `true` and with `S0()`, and no other).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = Int
  fun get() -> Int { 0 }
  fun put(x: Int) {} }
fun take<T where T is P>(t: T, x: T.X, flag: Bool = true) -> T.X { x }
fun wantInt(x: Int) {}
fun q() {
  wantInt(take(A(), 1))
  wantInt(take(A(), 2, false))
  wantInt(take(A(), true))
  wantInt(take(A(), S0()))
}
