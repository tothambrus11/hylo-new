// Tests: the requirement of the callee is a refinement of the trait that declares the
// associated type.
// Correct verdict: accepted.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
trait R refines P {}
given A is R {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun pickR<T where T is R>(t: T) -> T.X { t.get() }
fun q() { wantS0(pickR(A())) }
fun g<U where U is R>(u: U) { u.put(pickR(u)) }
