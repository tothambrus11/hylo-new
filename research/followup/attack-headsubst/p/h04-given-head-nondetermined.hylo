// Tests: a conformance whose head mentions only the projection: the parameter is decided by
// the witness through which the argument type was written.
// Correct verdict: QUESTION. `Only<U.X>` and `Only<V.X>` are one type when `U.X == V.X`, but
// `who` gives `U` for one spelling and `V` for the other: `id2` is accepted only if the two
// are confused.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
trait Q { type Y }
struct Only<Z> { public memberwise init }
given <T where T is P> => Only<T.X> is Q { type Y = T }
fun who<Z where Z is Q>(z: Z, y: Z.Y) -> Z.Y { y }
fun id1<U where U is P>(o: Only<U.X>, u: U) -> U { who(o, u) }
fun id2<U, V where U is P, V is P, U.X == V.X>(o: Only<U.X>, p: Only<V.X>, u: U) -> V { who(p, who(o, u)) }
