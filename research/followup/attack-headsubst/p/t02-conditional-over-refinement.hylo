// Tests: a conditional conformance whose premise is a refinement (`T is R`) and whose associated
// type is the one of the premise; everything at the call is concrete.
// Correct verdict: rejected; `pick(Box<B>)` is a `B.X` = `S1`, and `take(Box<A>, _)` expects an
// `A.X` = `S0`: the `S1` reaches `A.put(x: S0)`.
trait P { type X; fun get() -> X; fun put(x: X) }
trait R refines P {}
struct A { public memberwise init }
struct B { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is R {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
given B is R {}
given B is P { type X = S1
  fun get() -> S1 { S1() }
  fun put(x: S1) {} }
given <T where T is R> => Box<T> is P { type X = T.X
  fun get() -> T.X { self.v.get() }
  fun put(x: T.X) { self.v.put(x) } }
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun take<T where T is P>(t: T, x: T.X) { t.put(x) }
public fun main() { take(Box<A>(v: A()), pick(Box<B>(v: B()))) }
