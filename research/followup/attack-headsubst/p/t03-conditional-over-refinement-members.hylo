// Tests: t02 without generic functions: the requirements `get` and `put` are called on the
// boxes directly.
// Correct verdict: rejected (`Box<B>.get()` is an `S1`, `Box<A>.put` expects an `S0`).
trait P { type X; fun get() -> X; fun put(x: X) }
trait R refines P {}
struct A { public memberwise init }
struct B { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is R {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
given B is R {}
given B is P { type X = S1
  fun get() -> S1 { S1() }
  fun put(x: S1) {} }
given <T where T is R> => Box<T> is P { type X = T.X
  fun get() -> T.X { self.v.get() }
  fun put(x: T.X) { self.v.put(x) } }
public fun main() { Box<A>(v: A()).put(Box<B>(v: B()).get()) }
