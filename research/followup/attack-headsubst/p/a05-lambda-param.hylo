// Tests: a lambda argument whose parameter type is the projection.
// Correct verdict: rejected; the lambda takes an `S1`, the parameter of `each` wants a function
// of `A.X` = `S0`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun each<T where T is P>(t: T, f: [](let T.X) -> Void) { f(t.get()) }
public fun main() { each(A(), fun[](x: S1) { wantS1(x) }) }
