// Tests: i01 as a complete program. `A.X = M0` with `M0.Y = S0`; `B.X = M1` with `M1.Y = S1`.
// Correct verdict: rejected; in `g`, `far(v)` is a `V.X.Y` (an `S1` in `main`) and is given to
// `feed(u, _)`, which passes it to `M0.eat(y: S0)`.
trait Q { type Y; fun y() -> Y; fun eat(y: Y) }
trait P { type X
  given X is Q
  fun get() -> X }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct M0 { public memberwise init }
struct M1 { public memberwise init }
struct A { public memberwise init }
struct B { public memberwise init }
given M0 is Q { type Y = S0
  fun y() -> S0 { S0() }
  fun eat(y: S0) {} }
given M1 is Q { type Y = S1
  fun y() -> S1 { S1() }
  fun eat(y: S1) {} }
given A is P { type X = M0
  fun get() -> M0 { M0() } }
given B is P { type X = M1
  fun get() -> M1 { M1() } }
fun far<T where T is P>(t: T) -> T.X.Y { t.get().y() }
fun feed<T where T is P>(t: T, y: T.X.Y) { t.get().eat(y) }
fun g<U, V where U is P, V is P>(u: U, v: V) { feed(u, far(v)) }
public fun main() { g(A(), B()) }
