// Tests: the callee is a generic method of a generic struct (substituted type arguments of the
// receiver, then its own where clause).
// Correct verdict: rejected (2 errors): `S1()` for `A.X`, and the result `S0` to `wantS1`.
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
struct K<Z> { public memberwise init
  public fun m<U where U is P>(u: U, x: U.X) -> U.X { u.get() } }
public fun main() {
  let k = K<S1>()
  wantS0(k.m(A(), S0()))
  k.m(A(), S1())
  wantS1(k.m(A(), S0()))
}
