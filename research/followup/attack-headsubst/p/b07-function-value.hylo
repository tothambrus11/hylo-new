// Tests: a generic function with a projection in its signature used as a value of a
// monomorphic function type.
// Correct verdict: rejected (1 error: `g` takes an `S1`, `take<A>` takes an `S0`).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun take<T where T is P>(t: T, x: T.X) {}
public fun main() {
  let f: [](let A, let S0) -> Void = take<A>
  let g: [](let A, let S1) -> Void = take<A>
}
