// Tests: the callee is a generic initializer.
// Correct verdict: rejected (1 error, the second construction).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
struct K { 
  public init<U where U is P>(u: U, x: U.X) { }
}
public fun main() {
  let k0 = K(A(), S0())
  let k1 = K(A(), S1())
}
