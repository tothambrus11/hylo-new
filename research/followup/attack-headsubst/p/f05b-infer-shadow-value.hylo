// Tests: f05 the other way round: is `only(S1())` accepted with `T = B`, although the callee
// could as well be meant for `A`? Correct verdict: QUESTION (accepted if the nearest conformance
// decides the type argument).
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
struct B { public memberwise init }
fun only<T where T is P>(x: T.X) {}
fun q() {
  given B is P { type X = S1
    fun get() -> S1 { S1() }
    fun put(x: S1) {} }
  only(S1())
}
