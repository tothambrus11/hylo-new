fun q() {
  wantS0(h(A()))
  wantS1(h(B()))
  wantS1(h(A()))
}
fun h<T where T is Q>(t: T) -> T.X { t.other() }
fun h<T where T is P>(t: T) -> T.X { t.get() }
given B is Q { type X = S1
  fun other() -> S1 { S1() } }
struct B { public memberwise init }
trait Q { type X; fun other() -> X }
given A is P { type X = S0
  fun get() -> S0 { S0() }
  fun put(x: S0) {} }
fun wantS1(x: S1) {}
fun wantS0(x: S0) {}
struct Box<T> { public var v: T; public memberwise init }
struct S1 { public memberwise init }
struct S0 { public memberwise init }
struct A { public memberwise init }
trait P { type X; fun get() -> X; fun put(x: X) }
