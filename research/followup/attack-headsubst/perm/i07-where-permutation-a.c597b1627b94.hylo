fun q() {
  wantS1(deep(A(), M(), M(), S1(), S1()))
  wantS1(deep(A(), A(), M(), S1(), M()))
  wantS1(deep(A(), A(), M(), S1(), S1()))
}
fun deep<T, U where T is P, T.X is P, U is P>(t: T, u: U, x: T.X, y: T.X.X, z: U.X) -> T.X.X { y }
given M is P { type X = S1
  fun get() -> S1 { S1() }
  fun put(x: S1) {} }
given A is P { type X = M
  fun get() -> M { M() }
  fun put(x: M) {} }
struct M { public memberwise init }
fun wantS1(x: S1) {}
fun wantS0(x: S0) {}
struct Box<T> { public var v: T; public memberwise init }
struct S1 { public memberwise init }
struct S0 { public memberwise init }
struct A { public memberwise init }
trait P { type X; fun get() -> X; fun put(x: X) }
