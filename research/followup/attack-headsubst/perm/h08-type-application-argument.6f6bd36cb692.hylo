fun wantS0(x: S0) {}
fun wantS1(x: S1) {}
fun check<T>(x: T) {}
fun pick<T where T is P>(t: T) -> T.X { t.get() }
fun same<T, U where T is P, U is P, T.X == U.X>(t: T, u: U) -> U.X { t.get() }
fun g<U where U is P>(u: U) { check<U.X>(pick(u)) ; check<U.X>(pick<U>(u)) }
fun k<U, V where U is P, V is P, U.X == V.X>(u: U, v: V) { v.put(same(u, v)) ; v.put(pick(u)) }
fun h<U, V where U is P, V is P>(u: U, v: V) { check<V.X>(pick(u)) }
trait P { type X; fun get() -> X; fun put(x: X) }
struct A { public memberwise init }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var v: T; public memberwise init }
