struct M0 { public memberwise init }
struct M1 { public memberwise init }
struct A { public memberwise init }
struct B { public memberwise init }
given M0 is Q { type Y = S0
  fun y() -> S0 { S0() }
  fun eat(y: S0) {} }
given M1 is Q { type Y = S1
  fun y() -> S1 { S1() }
  fun eat(y: S1) {} }
given A is P { type X = M0
  fun get() -> M0 { M0() } }
given B is P { type X = M1
  fun get() -> M1 { M1() } }
fun far<Z where Z is Q>(z: Z) -> Z.Y { z.y() }
fun feed<Z where Z is Q>(z: Z, y: Z.Y) { z.eat(y) }
fun g<U, V where U is P, V is P>(u: U, v: V) { feed(u.get(), far(v.get())) }
public fun main() { g(A(), B()) }
trait Q { type Y; fun y() -> Y; fun eat(y: Y) }
trait P { type X
  given X is Q
  fun get() -> X }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
