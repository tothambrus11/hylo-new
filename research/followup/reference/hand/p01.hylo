trait P {}
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
given A is P {}
given <T where T is P> => Box<T> is P {}
given <T, U where T is P, U is Q> => Pair<T, U> is P {}
fun needP<W where W is P>() {}
fun needQ<W where W is Q>() {}
fun needEq<X, Y where X == Y>() {}
fun check<T>(x: T) {}
fun q0() { needP<Box<Box<A>>>() }
fun q1() { needP<Box<B>>() }
fun q2<T where T is Q>() { needP<Pair<A, T>>() }
fun q3<T, U where T == U, T is Q>() { needP<Pair<A, U>>() }
fun q4<T, U where T == U>(x: Box<T>) { check<Box<U>>(x) }
fun q5<T, U>(x: Box<T>) { check<Box<U>>(x) }
fun q6<T, U where T == U>() { needEq<Pair<T, U>, Pair<U, T>>() }
fun q7<T, U>() { needEq<Pair<T, U>, Pair<U, T>>() }
fun q8<T, U where Box<T> == U, T is P>() { needP<U>() }
fun q9<T, U where T == U>(x: {T, A}) { check<{U, A}>(x) }
fun q10<T, U, V where Box<T> == V, T == U>(x: V) { check<Box<U>>(x) }
fun q11<T, U, V where Box<T> == V, T == U>() { needEq<V, Box<U>>() }
fun q12<T, U where Box<T> == Box<U>, Box<T> is P>() { needP<Box<U>>() }
fun q13<T, U where Box<T> == Box<U>>() { needEq<T, U>() }
