trait Tr0 {}
trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St2<E0> { public memberwise init }
given <A where A is Tr0> => A is Tr1 { type X1 = A }
given St0 is Tr0 {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T, U where T is Tr0, U is Tr0>() { needEq<T.X1, U.X1>() }
fun q1<T, U where T is Tr0, U is Tr0>(x: T.X1) { check<U.X1>(x) }
fun q2<T where T is Tr0>(x: T.X1) { check<St0.X1>(x) }
fun q3<T where T is Tr0>(x: St2<T.X1>) { check<St2<St0.X1>>(x) }
fun q4() { needEq<St0.X1, St0>() }
fun q5<T where T is Tr0>(x: St0) { check<T.X1>(x) }
fun q6<T where T is Tr0>(x: St0.X1) { check<T.X1>(x) }
