trait P {}
struct Box<E0> { public memberwise init }
given <T> => Box<T> is P {}
fun needP<W where W is P>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T, U, V where T == U, U == V>() { needP<Box<V>>() }
fun q1<T, U, V where T == U, U == V>() { needEq<Box<T>, Box<V>>() }
fun q2<T, U, V where T == U, U == V>() { needEq<V, T>() }
