trait P { type X }
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
given A is P { type X = B }
given <T> => Box<T> is P { type X = T }
given B is Q {}
fun needP<W where W is P>() {}
fun needQ<W where W is Q>() {}
fun needEq<X, Y where X == Y>() {}
fun check<T>(x: T) {}
fun q0() { needEq<A.X, B>() }
fun q1() { needEq<Box<A>.X, A>() }
fun q2<T>() { needEq<Box<T>.X, T>() }
fun q3<T where T is P>() { needEq<Box<T.X>.X, T.X>() }
fun q4() { needQ<A.X>() }
fun q5<T where T is P, T.X is Q>() { needQ<T.X>() }
fun q6<T, U where T is P, U is P, T.X == U.X, T.X is Q>() { needQ<U.X>() }
fun q7<T, U where T is P, T == U>() { needEq<T.X, U.X>() }
fun q8<T, U where T is P, U is P, T == U>() { needEq<T.X, U.X>() }
fun q9<T where T == A>() { needEq<T.X, B>() }
fun q10<T where T == A, T is P>() { needEq<T.X, B>() }
fun q11<T where T is P>(x: T.X) { check<T.X>(x) }
fun q12<T, U where T is P, U is P>(x: T.X) { check<U.X>(x) }
fun q13<T, U where T is P, Box<T> == U>() { needEq<U.X, T>() }
fun q14<T, U where T is P, U is P, T == U>() { needP<T>() }
fun q15<T, U, V where T is P, U is P, T == V, U == V>() { needP<V>() }
fun q16<T, U, V where T is P, U is P, T == V, V == U>() { needP<V>() }
fun q17<T, U, V where T is P, U is P, V == T, V == U>() { needP<V>() }
fun q18<T, U, V where T is P, U is P, T == V, U == V>() { needEq<V.X, T.X>() }
