trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A where A is Tr0> => A is Tr1 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T1 == T0, T1 is Tr1, St2<T0> is Tr1>() { needEq<St2<St2<T1>>, St2<St2<T0>>>() }
fun q1<T0, T1, T2 where T1 is Tr1, St2<T0> is Tr1>() { needEq<St2<St2<T1>>, St2<St2<T0>>>() }
fun q2<T0, T1, T2 where T1 == T0>() { needEq<St2<T0>, St2<T1>>() }
fun q3<T0, T1, T2>() { needEq<St2<T0>, St2<T1>>() }
fun q4<T0, T1, T2, T3, T4 where T3 == T1, T3 == T4>() { needEq<St2<T1>, St2<T4>>() }
fun q5<T0, T1, T2, T3, T4 where T3 == T4>() { needEq<St2<T1>, St2<T4>>() }
