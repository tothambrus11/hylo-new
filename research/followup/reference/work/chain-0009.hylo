trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St2<St0> is Tr0 {}
given <A> => St3<St1, A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1 where T1 == T0>() { needEq<St3<St3<T0, T1>, St3<T1, T1>>, St3<St3<T0, T0>, St3<T1, T1>>>() }
fun q1<T0, T1>() { needEq<St3<St3<T0, T1>, St3<T1, T1>>, St3<St3<T0, T0>, St3<T1, T1>>>() }
fun q2<T0, T1 where T1 is Tr1, T1 == T0>(x: St2<T0>) { check<St2<T1>>(x) }
fun q3<T0, T1 where T1 is Tr1>(x: St2<T0>) { check<St2<T1>>(x) }
fun q4<T0, T1, T2, T3, T4 where T1 == T4, T3 == St2<T0>, T1 == T0>() { needEq<T4, T0>() }
fun q5<T0, T1, T2, T3, T4 where T3 == St2<T0>, T1 == T0>() { needEq<T4, T0>() }
