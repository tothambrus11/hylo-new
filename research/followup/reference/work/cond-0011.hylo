trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A where A == St1, A is Tr0> => St3<A, St0> is Tr0 {}
given <A where A is Tr1, A == St1> => St3<A, St0> is Tr1 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T0 is Tr1, T1 == T3, T1 is Tr0>() { needEq<St3<St2<St1>, St3<T3, St1>>, St3<St2<St1>, St3<T1, St1>>>() }
fun q1<T0, T1, T2, T3, T4 where T0 is Tr1, T1 == T3, T1 is Tr0>() { needTr0<St1>() }
fun q2<T0, T1, T2, T3, T4 where T3 is Tr0, T4 is Tr1, T3 == T0>() { needEq<St3<St3<St1, T0>, St3<T0, T1>>, St3<St3<St1, T0>, St3<T3, T1>>>() }
fun q3<T0, T1, T2, T3, T4 where T3 is Tr0, T4 is Tr1, T3 == T0>() { needTr1<St2<St1>>() }
fun q4<T0, T1, T2, T3, T4 where T4 == T0, T3 is Tr0, T0 == T3, T4 == T1>(x: St2<T1>) { check<St2<T3>>(x) }
fun q5<T0, T1, T2, T3, T4 where T4 == T0, T3 is Tr0, T0 == T3, T4 == T1>() { needTr1<T2>() }
