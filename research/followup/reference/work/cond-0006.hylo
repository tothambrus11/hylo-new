trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St0 is Tr2 {}
given <A, B where B is Tr2> => St3<A, B> is Tr2 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T1 is Tr2, T2 is Tr2, T3 == T2, T3 is Tr1, T0 is Tr0>() { needTr2<T3>() }
fun q1<T0, T1, T2, T3 where T1 is Tr2, T2 is Tr2, T3 is Tr1, T0 is Tr0>() { needTr2<T3>() }
fun q2<T0, T1, T2, T3 where T0 == T2, T0 is Tr2, T0 is Tr0, T2 == T3, St4<T1> is Tr2>() { needTr2<St3<T1, T3>>() }
fun q3<T0, T1, T2, T3 where T0 == T2, T0 is Tr0, T2 == T3, St4<T1> is Tr2>() { needTr2<St3<T1, T3>>() }
fun q4<T0, T1, T2, T3 where T0 == T2, T0 is Tr2, T0 is Tr0, T2 == T3, St4<T1> is Tr2>() { needTr0<St4<T0>>() }
fun q5<T0, T1, T2, T3, T4 where T0 is Tr2, T2 == T0, T1 is Tr0, T2 is Tr1, T1 is Tr2>() { needTr2<St3<T1, T2>>() }
