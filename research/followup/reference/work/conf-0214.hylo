trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0 where T0 is Tr0, T0 is Tr1>() { needTr1<T0>() }
fun q1<T0 where T0 is Tr0, T0 is Tr1>() { needTr0<St2<St2<St0>>>() }
fun q2() { needTr0<St1>() }
fun q3() { needTr1<St2<St1>>() }
fun q4() { needTr1<St1>() }
fun q5<T0 where T0 is Tr0, T0 is Tr1, St2<T0> is Tr0>() { needTr0<St1>() }
