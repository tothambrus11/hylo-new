trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where {T1, T2} == T0>(x: St3<St1, {T1, T2}>) { check<St3<St1, T0>>(x) }
fun q1<T0, T1, T2>(x: St3<St1, {T1, T2}>) { check<St3<St1, T0>>(x) }
fun q2<T0, T1 where {T1, T0} == {T0, T0}, T1 is Tr0>() { needEq<St3<St1, {T0, T0}>, St3<St1, {T1, T0}>>() }
fun q3<T0, T1 where {T1, T0} == {T0, T0}, T1 is Tr0>() { needTr0<{T1, St1}>() }
fun q4<T0, T1, T2, T3 where St4<T2> is Tr0, T0 is Tr0, St4<T0> == T3, {T1, T0} == {T2, T1}>(x: St3<{T2, T1}, T2>) { check<St3<{T1, T0}, T2>>(x) }
fun q5<T0, T1, T2, T3 where St4<T2> is Tr0, T0 is Tr0, St4<T0> == T3, {T1, T0} == {T2, T1}>() { needTr0<T3>() }
