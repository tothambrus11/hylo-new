trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given St1 is Tr2 {}
given St0 is Tr0 {}
given St0 is Tr2 {}
given <A where A is Tr1> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T1 == T2>(x: St2<T2>) { check<St2<T1>>(x) }
fun q1<T0, T1, T2, T3>(x: St2<T2>) { check<St2<T1>>(x) }
fun q2<T0, T1, T2, T3, T4 where T4 == T1, T2 is Tr1>(x: T1) { check<T4>(x) }
fun q3<T0, T1, T2, T3, T4 where T4 == T1, T2 is Tr1>() { needTr0<St2<T0>>() }
fun q4<T0, T1, T2, T3, T4 where T2 is Tr1, T2 == T4>() { needTr1<T4>() }
fun q5<T0, T1, T2, T3, T4 where T2 == T4>() { needTr1<T4>() }
