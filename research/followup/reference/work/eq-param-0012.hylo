trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A> => St2<A> is Tr0 {}
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T2 == T1, T2 == T3, T2 is Tr0, T3 is Tr0>() { needEq<St3<T2, T0>, St3<T1, T0>>() }
fun q1<T0, T1, T2, T3 where T2 == T1, T2 == T3, T2 is Tr0, T3 is Tr0>() { needEq<St3<T0, St1>, St3<T1, St1>>() }
fun q2<T0, T1, T2, T3 where T0 == T3, T3 is Tr0>() { needTr0<T0>() }
fun q3<T0, T1, T2, T3 where T0 == T3>() { needTr0<T0>() }
fun q4<T0, T1, T2, T3 where T0 == T3, T3 is Tr0>() { needTr0<T1>() }
fun q5<T0, T1, T2, T3 where T3 is Tr0, T0 == T3>(x: St4<T3>) { check<St4<T0>>(x) }
