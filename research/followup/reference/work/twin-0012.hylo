struct St3<E0, E1> { public memberwise init }
given <A where A is Tr1> => St3<A, St1> is Tr0 {}
given <A> => St3<A, St1> is Tr1 {}
given St0 is Tr1 {}
given St1 is Tr1 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T1b, T2b where T1 is Tr1, T1b is Tr1, T2b == T0, T2 == T0, T2b == T1b, T0 == T1, T1b == T0, T2 == T1>() { needTr1<T0>() }
fun q1<T0, T1, T2, T3, T4, T0b, T1b, T2b, T4b where T3 == T1b, T3 == T1, T1b == T0b, T0 == T1, St2<T4b> is Tr1, St2<T1> is Tr0, St2<T1b> is Tr0, St2<T4> is Tr1>() { needTr0<St2<T3>>() }
fun q2<T0, T1, T0b where St2<T0> is Tr1, T0b == T1, T1 is Tr0, St2<T0b> is Tr1, St2<T0b> is Tr0, St2<T0> is Tr0, T0 == T1>() { needTr1<St2<T1>>() }
fun q3<T0, T1, T2, T0b, T1b where T2 == T0, St2<T1> is Tr1, T0b == T2, T2 is Tr0, St2<T1> is Tr0, T1 == T0, St2<T1b> is Tr1, St2<T1b> is Tr0, T0b == T1b>() { needTr0<St2<T2>>() }
