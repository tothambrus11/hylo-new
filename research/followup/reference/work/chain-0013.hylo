trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given St0 is Tr2 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1 where T1 == T0>(x: St2<T0>) { check<St2<T1>>(x) }
fun q1<T0, T1>(x: St2<T0>) { check<St2<T1>>(x) }
fun q2<T0, T1 where T1 == T0>() { needTr1<St1>() }
fun q3<T0, T1, T2, T3 where T3 is Tr0, T3 == T0, St2<T1> == St2<T3>, T2 == T1>() { needEq<St2<St2<T3>>, St2<St2<T1>>>() }
fun q4<T0, T1, T2, T3 where T3 is Tr0, T3 == T0, St2<T1> == St2<T3>, T2 == T1>() { needEq<St2<St2<T1>>, St2<St2<St1>>>() }
fun q5<T0, T1, T2, T3 where T2 == T0, T2 == T1, T0 is Tr1, T1 is Tr0, T1 == T3>() { needTr1<T1>() }
