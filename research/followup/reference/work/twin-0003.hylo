trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A> => St3<A, St0> is Tr1 {}
given <A> => St2<A> is Tr1 {}
given <A where A is Tr0> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T0b, T1b, T2b where T3 == T2, T2b == T3, T2 is Tr0, T2b is Tr0>() { needTr0<T3>() }
fun q1<T0, T1, T0b where St2<T0> is Tr0, T0b == T1, St2<T0b> is Tr0, T0 == T1>() { needTr0<St2<T1>>() }
fun q2<T0, T1, T2, T3, T1b, T2b, T3b where T3 == T0, St2<T1> is Tr1, T3b == T1b, T3 is Tr1, T3b is Tr1, St2<T1b> is Tr1, T1 == T3, T0 == T3b>() { needTr1<T0>() }
fun q3<T0, T1, T2, T3, T0b, T2b, T3b where T3b == T1, St4<T3b> is Tr0, T0b == T1, T0b == T3b, T1 == T3, T0 == T1, St4<T3> is Tr0, T0 == T3>() { needTr0<St4<T1>>() }
