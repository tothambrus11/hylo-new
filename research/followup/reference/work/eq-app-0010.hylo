trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St1 is Tr0 {}
given <A where A == St0> => St3<A, St0> is Tr0 {}
given <A where A is Tr0, A == St1> => St4<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T2 is Tr0, St2<T0> == T1>() { needEq<St2<St2<T0>>, St2<T1>>() }
fun q1<T0, T1, T2 where T2 is Tr0, St2<T0> == T1>() { needTr0<St4<T1>>() }
fun q2<T0, T1, T2, T3 where St4<T1> == St4<T3>, {T3, T3} == {T0, T3}>(x: St3<{St4<T1>, T2}, {St1, St4<T1>}>) { check<St3<{St4<T3>, T2}, {St1, St4<T1>}>>(x) }
fun q3<T0, T1, T2, T3 where St4<T1> == St4<T3>, {T3, T3} == {T0, T3}>() { needTr0<{T0, T3}>() }
fun q4<T0, T1, T2 where T0 is Tr0, {T0, T1} == {T2, T0}, St2<T1> == St2<T2>, T1 is Tr0>() { needTr0<St4<St1>>() }
fun q5<T0, T1, T2 where T0 is Tr0, {T0, T1} == {T2, T0}, St2<T1> == St2<T2>, T1 is Tr0>() { needTr0<St2<T0>>() }
