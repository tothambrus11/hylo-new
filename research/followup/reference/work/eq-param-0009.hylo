trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A> => St3<St1, A> is Tr1 {}
given <A where A is Tr1> => St3<A, St0> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T1 == T0, T2 == T0>() { needEq<St2<{T2, T3}>, St2<{T1, T3}>>() }
fun q1<T0, T1, T2, T3 where T2 == T0>() { needEq<St2<{T2, T3}>, St2<{T1, T3}>>() }
fun q2<T0, T1, T2, T3 where T2 == T1, T2 == T0>(x: St2<T0>) { check<St2<T1>>(x) }
fun q3<T0, T1, T2, T3 where T2 == T0>(x: St2<T0>) { check<St2<T1>>(x) }
fun q4<T0, T1, T2 where T2 == T0, T1 == T0, T2 is Tr2, T2 is Tr1, T2 == T1>() { needEq<{T2, T2}, {T0, T2}>() }
fun q5<T0, T1, T2 where T2 == T0, T1 == T0, T2 is Tr2, T2 is Tr1, T2 == T1>() { needEq<T1, St3<St0, St0>>() }
