trait Tr0 { type X0 }
trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr1 { type X1 = St0 }
given <A, B where B is Tr0, A is Tr1> => St3<A, B> is Tr0 { type X0 = St0 }
given <A where A is Tr0> => St2<A> is Tr1 { type X1 = St2<A> }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T2 == T0>() { needEq<St3<T0, St1>, St3<T2, St1>>() }
fun q1<T0, T1, T2 where T2 == T0>() { needTr0<T2>() }
fun q2<T0, T1, T2>() { needEq<St3<T1, St0>, St3<T1, St1.X1>>() }
fun q3<T0, T1, T2>() { needTr1<St1.X1>() }
fun q4<T0, T1 where St2<T1> == St1.X1, T0 == T1, St1 == St1.X1>() { needTr1<St2<T0>>() }
fun q5<T0, T1 where St2<T1> == St1.X1, T0 == T1>() { needTr1<St2<T0>>() }
