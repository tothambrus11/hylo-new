trait Tr0 { type X0 }
trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr1 { type X1 = St0 }
given <A, B where B is Tr0, A is Tr1> => St3<A, B> is Tr0 { type X0 = St0 }
given <A where A is Tr0> => St2<A> is Tr1 { type X1 = St2<A> }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T2 == T0>() { needEq<St1.X1, St0>() }
fun q1<T0, T1, T2 where T2 == T0>() { needTr1<St2<T1>>() }
fun q2<T0, T1, T2, T3 where T3 is Tr0, T3 is Tr1, T3.X0 == T3, T1 is Tr0, T1.X0 == St2<T1>, T1.X0 == T3.X0>() { needTr1<St2<St2<T1>>>() }
fun q3<T0, T1, T2, T3 where T3 is Tr0, T3 is Tr1, T3.X0 == T3, T1 is Tr0, T1.X0 == St2<T1>, T1.X0 == T3.X0>() { needTr1<St2<St0.X0>>() }
fun q4<T0, T1, T2, T3 where T3 == T2, T2 is Tr1, T0 is Tr1>(x: St3<T2.X1, T2>) { check<St3<T2.X1, T3>>(x) }
fun q5<T0, T1, T2, T3 where T2 is Tr1, T0 is Tr1>(x: St3<T2.X1, T2>) { check<St3<T2.X1, T3>>(x) }
