trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St4<E0> { public memberwise init }
given St2<St0> is Tr0 {}
given <A> => St4<A> is Tr1 {}
given <A where A == St1, A is Tr0> => St4<A> is Tr0 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T0 == T1, T2 == T3, T3 == T0, T2 is Tr1>() { needEq<St2<T0>, St2<T2>>() }
fun q1<T0, T1, T2, T3 where T0 == T1, T2 == T3, T2 is Tr1>() { needEq<St2<T0>, St2<T2>>() }
fun q2<T0, T1, T2 where St4<T0> == St4<T2>, T0 is Tr0, T2 == T1, T0 is Tr1>() { needEq<St2<T1>, St2<T2>>() }
fun q3<T0, T1, T2 where St4<T0> == St4<T2>, T0 is Tr0, T0 is Tr1>() { needEq<St2<T1>, St2<T2>>() }
fun q4<T0, T1, T2, T3, T4 where T1 == St2<T4>, St2<T3> == St2<T0>, St4<T1> is Tr1, St4<T1> == T2, T0 == T2>() { needTr1<T0>() }
fun q5<T0, T1, T2, T3, T4 where T1 == St2<T4>, St2<T3> == St2<T0>, St4<T1> is Tr1, St4<T1> == T2, T0 == T2>() { needTr1<T1>() }
