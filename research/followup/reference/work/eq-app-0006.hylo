trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given <A where A is Tr0> => St2<A> is Tr1 {}
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1 where St2<T1> == St2<T0>, T0 == T1>() { needTr1<St2<St1>>() }
fun q1<T0, T1 where St2<T1> == St2<T0>, T0 == T1>() { needTr0<St2<T0>>() }
fun q2<T0, T1, T2, T3 where T2 == T1, T2 is Tr1, St2<T2> == T0, T1 is Tr1, T3 is Tr1>() { needEq<St2<T2>, St2<T1>>() }
fun q3<T0, T1, T2, T3 where T2 == T1, T2 is Tr1, St2<T2> == T0, T1 is Tr1, T3 is Tr1>() { needTr0<T2>() }
fun q4<T0, T1, T2, T3, T4 where T2 is Tr0, St2<T0> == St2<St0>>() { needTr0<T2>() }
fun q5<T0, T1, T2, T3, T4 where T2 is Tr0, St2<T0> == St2<St0>>() { needEq<T4, T3>() }
