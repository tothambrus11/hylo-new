trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr1 {}
given <A, B> => St3<A, B> is Tr1 {}
given St0 is Tr1 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T3 is Tr1, T0 == St2<T1>>() { needTr0<St0>() }
fun q1<T0, T1, T2, T3, T4 where T3 is Tr1, T0 == St2<T1>>() { needTr1<T4>() }
fun q2<T0, T1 where T1 == St1, {T1, T0} == T0, T0 == St2<T1>, T1 is Tr0>(x: St3<T1, T1>) { check<St3<T1, St1>>(x) }
fun q3<T0, T1 where T1 == St1, {T1, T0} == T0, T0 == St2<T1>, T1 is Tr0>() { needEq<St3<{St2<T1>, St0}, T0>, St3<{St2<T1>, St2<T1>}, T0>>() }
fun q4<T0, T1, T2 where T0 is Tr0, St2<T0> == T2, T0 is Tr1, {T0, T1} == {T1, T1}, T1 is Tr0>() { needEq<{T0, T1}, {T1, T1}>() }
fun q5<T0, T1, T2 where T0 is Tr0, St2<T0> == T2, T0 is Tr1, {T0, T1} == {T1, T1}, T1 is Tr0>() { needTr0<St2<T1>>() }
