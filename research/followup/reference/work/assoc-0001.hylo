trait Tr0 { type X0 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A> => St2<A> is Tr0 { type X0 = St0 }
given St1 is Tr0 { type X0 = St0 }
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T0 == T3, T3 is Tr0, T2 is Tr0>() { needEq<T3.X0, T3.X0>() }
fun q1<T0, T1, T2, T3 where T0 == T3, T3 is Tr0, T2 is Tr0>(x: T3) { check<St1>(x) }
fun q2<T0, T1, T2, T3, T4 where T1.X0 is Tr0, T1 is Tr0, T4 is Tr0, St2<T3> is Tr0, T4.X0 is Tr0>() { needTr0<T1.X0>() }
fun q3<T0, T1, T2, T3, T4 where T1.X0 is Tr0, T1 is Tr0, T4 is Tr0, St2<T3> is Tr0, T4.X0 is Tr0>() { needEq<St2<T2>, St1>() }
fun q4<T0, T1 where T0 == T1, St2<T1> is Tr0, T1 is Tr0>() { needTr0<St2<St1.X0>>() }
fun q5<T0, T1 where T0 == T1, St2<T1> is Tr0, T1 is Tr0>(x: St3<T1, St3<St1.X0, St1.X0>>) { check<St1>(x) }
