trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A where A is Tr1> => St4<A> is Tr0 {}
given St1 is Tr0 {}
given <A> => St4<A> is Tr1 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1 where T0 == St0, T0 is Tr0, T1 is Tr0>() { needEq<St4<St0>, St4<T0>>() }
fun q1<T0, T1 where T0 == St0, T0 is Tr0, T1 is Tr0>() { needTr0<St2<T1>>() }
fun q2<T0, T1, T2, T3 where St2<T0> == T2, T0 == St4<T1>>() { needTr1<T0>() }
fun q3<T0, T1, T2, T3 where St2<T0> == T2, T0 == St4<T1>>() { needTr0<St4<T2>>() }
fun q4<T0, T1, T2, T3, T4 where St2<T1> is Tr0, St2<T1> == St2<T0>, T2 is Tr0, T2 == T4, T0 == T2>() { needEq<St2<T1>, St2<T4>>() }
fun q5<T0, T1, T2, T3, T4 where St2<T1> is Tr0, T2 is Tr0, T2 == T4, T0 == T2>() { needEq<St2<T1>, St2<T4>>() }
