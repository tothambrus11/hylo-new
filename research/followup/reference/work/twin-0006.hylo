trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St0 is Tr0 {}
given St4<St0> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T1b where T0 == T1b, T1b is Tr0, T1 is Tr0, T1 == T0>() { needTr0<T0>() }
fun q1<T0, T1, T2, T3, T4, T0b, T1b, T2b, T3b where T0b is Tr1, T4 == T0b, T0 is Tr0, T0b is Tr0, T3b == T0b, T0 is Tr1, T0 == T4, T3 == T0>() { needTr1<T4>() }
fun q2<T0, T1, T1b where T0 == T1b, T1 == T0, T1 is Tr1, T1b is Tr1, T0 is Tr0>() { needTr1<T0>() }
fun q3<T0, T1, T2, T3, T4, T0b, T2b, T3b, T4b where T3 == T2, St2<T0b> is Tr1, St4<T3> is Tr0, T2b == T3b, T3 == T1, St2<T0> is Tr1, T1 == T3b, St4<T3b> is Tr0>() { needTr0<St4<T1>>() }
