trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St0 is Tr1 {}
given <A> => St3<A, St0> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0() { needTr0<St3<St0, St0>>() }
fun q1() { needTr1<St1>() }
fun q2<T0 where T0 is Tr0>() { needTr1<St0>() }
fun q3<T0 where T0 is Tr0>() { needTr1<T0>() }
fun q4<T0, T1 where St2<T1> is Tr0, T1 is Tr1, T1 is Tr0>() { needTr1<St0>() }
fun q5<T0, T1 where St2<T1> is Tr0, T1 is Tr1, T1 is Tr0>() { needTr0<T0>() }
