trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr0 {}
given St0 is Tr1 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where St1 == T3, T3 is Tr0, T4 == St2<T3>, T1 is Tr1, T3 is Tr1>() { needTr1<St0>() }
fun q1<T0, T1, T2, T3, T4 where St1 == T3, T3 is Tr0, T4 == St2<T3>, T1 is Tr1, T3 is Tr1>() { needTr0<St3<St2<T3>, St3<St0, St0>>>() }
fun q2<T0, T1, T2, T3 where T3 is Tr0, St2<T3> == St2<T2>>() { needTr0<T3>() }
fun q3<T0, T1, T2, T3 where T3 is Tr0, St2<T3> == St2<T2>>() { needTr0<St2<T2>>() }
fun q4<T0, T1, T2 where T0 == T1, T0 is Tr1>(x: St2<T1>) { check<St2<T0>>(x) }
fun q5<T0, T1, T2 where T0 == T1, T0 is Tr1>() { needTr1<St2<T1>>() }
