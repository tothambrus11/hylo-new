trait Tr0 { type X0 }
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr0 { type X0 = St1 }
given St1 is Tr1 {}
given <A where A is Tr1> => St2<A> is Tr1 {}
given <A> => St2<A> is Tr0 { type X0 = St0 }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T0 is Tr0>() { needTr0<St2<T2>>() }
fun q1<T0, T1, T2, T3, T4 where T0 is Tr0>() { needTr1<St2<T4>>() }
fun q2<T0, T1 where T1 is Tr0>() { needTr0<St2<St1.X0>>() }
fun q3<T0, T1 where T1 is Tr0>() { needTr1<St3<St0.X0, T1>>() }
fun q4<T0, T1, T2, T3 where St1.X0 == T1>(x: St3<St2<St1>, St1>) { check<St3<St2<St1.X0>, T1>>(x) }
fun q5<T0, T1, T2, T3 where St1.X0 == T1>() { needTr0<St3<St3<T2, St1>, St1.X0>>() }
