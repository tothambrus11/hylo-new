trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St0 is Tr1 {}
given <A> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T0b, T1b, T2b where T3 == T2b, T2 == T3, T1b is Tr0, T1 is Tr0, T3 == T1b, T1 == T3>() { needTr0<T3>() }
fun q1<T0, T1, T2, T1b, T2b where T2b == T1b, T2 is Tr2, T0 == T1b, T1 == T2, T2b is Tr2, T1 == T0>() { needTr2<T0>() }
fun q2<T0, T1, T2, T0b, T2b where T0b == T1, T0b is Tr1, T1 == T2, T1 == T2b, T0 is Tr1, T1 == T0>() { needTr1<T1>() }
fun q3<T0, T1, T1b where T0 == T1b, St4<T1b> is Tr0, T1 == T0, St4<T1> is Tr0>() { needTr0<St4<T0>>() }
