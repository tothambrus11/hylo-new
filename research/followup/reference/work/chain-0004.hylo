trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr1 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where St2<T3> == T1, T2 == T4, T3 is Tr1, T1 == T2, T0 == T4, T0 is Tr0>() { needTr0<St2<T3>>() }
fun q1<T0, T1, T2, T3, T4 where St2<T3> == T1, T2 == T4, T3 is Tr1, T1 == T2, T0 == T4>() { needTr0<St2<T3>>() }
fun q2<T0, T1, T2, T3, T4 where St2<T3> == T1, T2 == T4, T3 is Tr1, T1 == T2, T0 == T4, T0 is Tr0>(x: St1) { check<St2<T3>>(x) }
fun q3<T0, T1, T2, T3 where T2 == T3, T1 == T0, T0 == T3>() { needEq<T2, T1>() }
fun q4<T0, T1, T2, T3 where T2 == T3, T1 == T0, T0 == T3>() { needTr0<T3>() }
fun q5<T0, T1, T2, T3, T4 where T4 == T0, T3 is Tr0, T1 is Tr1, T0 is Tr0, T2 == T0, T3 == T1, T1 == T4>(x: St3<St0, T1>) { check<St3<St0, T2>>(x) }
