trait Tr0 { type X0 }
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St0 is Tr1 {}
given St1 is Tr1 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T3 is Tr2, T1 == T0>(x: St3<St3<T2, T3>, St3<St1, T0>>) { check<St3<St3<T2, T3>, St3<St1, T1>>>(x) }
fun q1<T0, T1, T2, T3, T4 where T3 is Tr2, T1 == T0>() { needEq<St3<T3, T4>, St3<St1, T3>>() }
fun q2<T0, T1, T2, T3 where T0 == T1, T1 is Tr2>(x: St3<T2, T0>) { check<St3<T2, T1>>(x) }
fun q3<T0, T1, T2, T3 where T0 == T1, T1 is Tr2>() { needEq<St2<T3>, T3>() }
fun q4<T0, T1, T2, T3 where T3 is Tr1, T0 == T2>() { needEq<St2<T2>, St2<T0>>() }
fun q5<T0, T1, T2, T3 where T3 is Tr1, T0 == T2>(x: St2<T0.X0>) { check<St2<T0.X0>>(x) }
