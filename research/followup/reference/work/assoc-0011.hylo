trait Tr0 { type X0 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St0 is Tr0 { type X0 = St1 }
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where St0.X0 == St2<T0>, St2<T2> is Tr0>(x: St3<St3<T3, T1>, St1>) { check<St3<St3<T3, T1>, St2<T0>>>(x) }
fun q1<T0, T1, T2, T3 where St2<T2> is Tr0>(x: St3<St3<T3, T1>, St1>) { check<St3<St3<T3, T1>, St2<T0>>>(x) }
fun q2<T0, T1, T2 where T2 == T1, T2.X0 == St1, T2 is Tr0, T0 is Tr0, T0.X0 is Tr0>(x: St3<T2.X0, St3<St1, T2.X0>>) { check<St3<T2.X0, St3<St1, St1>>>(x) }
fun q3<T0, T1, T2 where T2 == T1, T2 is Tr0, T0 is Tr0, T0.X0 is Tr0>(x: St3<T2.X0, St3<St1, T2.X0>>) { check<St3<T2.X0, St3<St1, St1>>>(x) }
fun q4<T0, T1, T2, T3 where T1 == T0, T3 is Tr0, T2 is Tr0>() { needEq<St2<T2.X0>, St2<T2.X0>>() }
fun q5<T0, T1, T2, T3 where T1 == T0, T3 is Tr0, T2 is Tr0>() { needTr0<T2.X0>() }
