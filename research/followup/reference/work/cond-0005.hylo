trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St0 is Tr0 {}
given <A where A is Tr0> => St3<A, St1> is Tr0 {}
given <A> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T0 == T1, St2<T2> is Tr0, T2 is Tr0, T0 is Tr0, T1 == T4, T0 == T3>() { needEq<St3<T1, St1>, St3<T3, St1>>() }
fun q1<T0, T1, T2, T3, T4 where T0 == T1, St2<T2> is Tr0, T2 is Tr0, T0 is Tr0, T1 == T4, T0 == T3>(x: St2<St3<St1, T1>>) { check<St2<St2<St2<T2>>>>(x) }
fun q2<T0, T1 where T1 == T0, T1 is Tr0>(x: St2<T1>) { check<St2<T0>>(x) }
fun q3<T0, T1 where T1 == T0, T1 is Tr0>() { needEq<St3<T0, St1>, St3<St0, St1>>() }
fun q4<T0, T1, T2 where T1 == T0, T0 is Tr0, St2<T0> is Tr0>() { needTr0<St3<T1, St1>>() }
fun q5<T0, T1, T2 where T1 == T0, St2<T0> is Tr0>() { needTr0<St3<T1, St1>>() }
