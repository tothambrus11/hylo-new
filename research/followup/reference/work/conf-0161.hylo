trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr0 {}
given St0 is Tr0 {}
given <A, B where A is Tr0, A == B> => St3<A, B> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0() { needTr0<St1>() }
fun q1() { needTr0<St2<St0>>() }
fun q2<T0, T1, T2>() { needTr0<St0>() }
fun q3<T0, T1, T2>() { needTr0<T2>() }
fun q4<T0 where St2<T0> is Tr0, T0 is Tr0>() { needTr0<St3<St1, St1>>() }
fun q5<T0 where St2<T0> is Tr0, T0 is Tr0>() { needTr0<St3<St1, T0>>() }
