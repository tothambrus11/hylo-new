trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A, B> => St3<A, B> is Tr2 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T3 == T0, T4 == T2, T3 is Tr2>() { needEq<St3<T0, T4>, St3<T3, T4>>() }
fun q1<T0, T1, T2, T3, T4 where T3 == T0, T4 == T2, T3 is Tr2>() { needEq<T1, T4>() }
fun q2<T0, T1 where T1 is Tr0, T1 == T0>(x: St2<T1>) { check<St2<T0>>(x) }
fun q3<T0, T1 where T1 is Tr0>(x: St2<T1>) { check<St2<T0>>(x) }
fun q4<T0, T1 where T0 == T1>() { needEq<{T1, T0}, {T0, T1}>() }
fun q5<T0, T1>() { needEq<{T1, T0}, {T0, T1}>() }
