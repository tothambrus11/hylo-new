trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A> => St2<A> is Tr1 {}
given <A, B where B is Tr2> => St3<A, B> is Tr0 {}
given <A where A is Tr2> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T0 is Tr1>() { needTr1<St2<St0>>() }
fun q1<T0, T1, T2 where T0 is Tr1>() { needTr1<St3<St2<T1>, T2>>() }
fun q2<T0, T1>() { needTr0<St2<T1>>() }
fun q3<T0, T1, T2 where T2 is Tr2>() { needTr2<T2>() }
fun q4<T0, T1, T2>() { needTr2<T2>() }
fun q5<T0, T1>() { needTr1<St2<T1>>() }
