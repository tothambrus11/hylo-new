trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St2<St0> is Tr1 {}
given St1 is Tr0 {}
given <A> => St2<A> is Tr2 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0 where T0 is Tr1>() { needTr0<St1>() }
fun q1<T0 where T0 is Tr1>() { needTr1<St2<T0>>() }
fun q2<T0, T1 where T0 is Tr1>() { needTr1<St2<St0>>() }
fun q3<T0, T1 where T0 is Tr1>() { needTr1<St2<T0>>() }
fun q4() { needTr2<St2<St0>>() }
fun q5() { needTr1<St0>() }
