trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A where A is Tr1> => St2<A> is Tr1 {}
given St0 is Tr1 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1 where T1 is Tr0, T1 is Tr1>() { needTr1<St2<T1>>() }
fun q1<T0, T1 where T1 is Tr0, T1 is Tr1>() { needTr1<St3<T1, T1>>() }
fun q2() { needTr0<St0>() }
fun q3() { needTr0<St3<St0, St1>>() }
fun q4() { needTr1<St0>() }
fun q5() { needTr0<St1>() }
