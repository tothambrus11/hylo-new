trait Tr0 { type X0 }
trait Tr1 {}
trait Tr2 { type X2 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr2 { type X2 = St1 }
given <A, B where A is Tr1> => St3<A, B> is Tr1 {}
given St0 is Tr2 { type X2 = St2<St0> }
given <A where A is Tr0> => St2<A> is Tr0 { type X0 = A }
given St1 is Tr0 { type X0 = St0 }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T1 is Tr0, T1 == T3, T1.X2 is Tr1, T1 is Tr2, T2 is Tr2>() { needTr1<T1.X2>() }
fun q1<T0, T1, T2, T3 where T1 is Tr0, T1 == T3, T1.X2 is Tr1, T1 is Tr2, T2 is Tr2>(x: St2<St2<T2.X2>>) { check<St0>(x) }
fun q2<T0, T1 where T1 is Tr1, T0 is Tr2, T0.X2 == St1, T0.X2 == St0.X2>() { needTr2<St0.X2>() }
fun q3<T0, T1 where T1 is Tr1, T0 is Tr2, T0.X2 == St1, T0.X2 == St0.X2>() { needTr1<St3<St3<St1.X0, St1.X0>, St1.X0>>() }
fun q4<T0, T1, T2, T3, T4 where T3 is Tr2>() { needTr2<T3>() }
fun q5<T0, T1, T2, T3, T4 where T3 is Tr2>() { needTr0<St2<T3>>() }
