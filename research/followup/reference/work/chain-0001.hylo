trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St0 is Tr2 {}
given <A, B where A == St0, A is Tr0> => St3<A, B> is Tr0 {}
given St0 is Tr0 {}
given St0 is Tr1 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where St2<T0> == St2<T1>, T2 == T3>(x: St3<St2<T1>, St1>) { check<St3<St2<T0>, St1>>(x) }
fun q1<T0, T1, T2, T3 where St2<T0> == St2<T1>, T2 == T3>() { needTr1<St2<T1>>() }
fun q2<T0, T1, T2 where T0 is Tr2, T2 == T1>() { needEq<St3<T2, T0>, St3<T1, T0>>() }
fun q3<T0, T1, T2 where T0 is Tr2, T2 == T1>() { needEq<St3<St1, St0>, St3<St1, T1>>() }
fun q4<T0, T1, T2, T3, T4 where T3 == T0, T3 == T4, T2 == T4, T0 is Tr1, T2 == T1, St2<T2> is Tr0, T2 is Tr1>(x: T1) { check<T0>(x) }
fun q5<T0, T1, T2, T3, T4 where T3 == T0, T3 == T4, T2 == T4, T0 is Tr1, T2 == T1, St2<T2> is Tr0, T2 is Tr1>() { needTr0<T0>() }
