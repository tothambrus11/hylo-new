trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T1b where T1 is Tr1, T1b is Tr1, T1 == T0, T1b == T0>() { needTr1<T0>() }
fun q1<T0, T1, T0b where St2<T0> is Tr1, St2<T0b> is Tr1, T1 == T0b, T0 == T1>() { needTr1<St2<T1>>() }
fun q2<T0, T1, T1b where St2<T1> is Tr1, St2<T1b> is Tr1, T1 == T0, T0 == T1b>() { needTr1<St2<T0>>() }
fun q3<T0, T1, T2, T3, T1b, T2b, T3b where T3 is Tr1, T3 == T0, T0 == T3b, T2 == T3, T3b is Tr1, T2b == T3b>() { needTr1<T0>() }
