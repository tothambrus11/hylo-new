trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A, B where A is Tr0, B is Tr0> => St3<A, B> is Tr0 {}
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T3 == T4, T3 == T2, T3 is Tr0, T3 == T0, T0 is Tr0>() { needTr0<St3<T4, T2>>() }
fun q1<T0, T1, T2, T3, T4 where T3 == T4, T3 is Tr0, T3 == T0, T0 is Tr0>() { needTr0<St3<T4, T2>>() }
fun q2<T0, T1, T2, T3, T4 where T3 == T4, T3 == T2, T3 is Tr0, T3 == T0, T0 is Tr0>() { needTr0<St3<T1, St0>>() }
fun q3<T0, T1, T2, T3, T4 where T1 == T3, T0 == T4, T3 == T4, T2 is Tr0, T0 is Tr0>() { needTr0<St3<T1, T0>>() }
fun q4<T0, T1, T2, T3, T4 where T1 == T3, T3 == T4, T2 is Tr0, T0 is Tr0>() { needTr0<St3<T1, T0>>() }
fun q5<T0, T1 where T1 is Tr0, T0 is Tr0, T1 == T0>() { needTr0<St3<St0, St0>>() }
