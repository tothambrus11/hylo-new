trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St0 is Tr1 {}
given <A, B where B is Tr0> => St3<A, B> is Tr2 {}
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T0b where T0b == T1, T0 == T1, T0b is Tr1, St2<T1> is Tr2, T0 is Tr0, T0b is Tr0, T0 is Tr1>() { needTr0<T1>() }
fun q1<T0, T1, T1b where T1 is Tr2, T1 == T0, T0 == T1b, T1b is Tr1, T1 is Tr1, T1b is Tr2>() { needTr2<T0>() }
fun q2<T0, T1, T1b where T1 is Tr1, T0 is Tr2, T0 == T1, St2<T0> is Tr0, T1b is Tr1, T1b == T0>() { needTr1<T0>() }
fun q3<T0, T1, T2, T3, T4, T1b, T2b, T3b, T4b where T3 is Tr1, T4 is Tr1, T3 == T1, T0 == T3b, T4b is Tr1, T3b == T1b, T3 == T0, T3b is Tr1>() { needTr1<T0>() }
