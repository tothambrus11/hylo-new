trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr1 {}
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0 where St2<T0> is Tr0, T0 is Tr0>() { needTr0<St2<T0>>() }
fun q1<T0 where St2<T0> is Tr0, T0 is Tr0>() { needTr0<St3<St3<T0, T0>, St2<St1>>>() }
fun q2<T0, T1>() { needTr1<St1>() }
fun q3<T0, T1>() { needTr1<St3<St2<St0>, T1>>() }
fun q4<T0 where T0 is Tr0, St2<T0> is Tr0>() { needTr1<St1>() }
fun q5<T0 where T0 is Tr0, St2<T0> is Tr0>() { needTr1<St2<St0>>() }
