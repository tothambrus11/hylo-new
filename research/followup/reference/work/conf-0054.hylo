trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St2<St0> is Tr1 {}
given St0 is Tr0 {}
given <A, B where B is Tr0> => St3<A, B> is Tr0 {}
given <A> => St4<A> is Tr1 {}
given St4<St0> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T2 is Tr1>() { needTr0<St4<St0>>() }
fun q1<T0, T1, T2 where T2 is Tr1>() { needTr1<St0>() }
fun q2<T0, T1, T2 where T0 is Tr1, St4<T2> is Tr0>() { needTr0<St4<St0>>() }
fun q3<T0, T1, T2 where T0 is Tr1, St4<T2> is Tr0>() { needTr0<St3<T1, T2>>() }
fun q4<T0, T1, T2 where T2 is Tr1, St4<T1> is Tr0, T1 is Tr1>() { needTr0<St4<St0>>() }
fun q5<T0, T1, T2 where T2 is Tr1, St4<T1> is Tr0, T1 is Tr1>() { needTr0<St2<St4<T1>>>() }
