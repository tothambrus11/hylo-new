trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A where A is Tr0> => St3<A, St0> is Tr0 {}
given St0 is Tr0 {}
given <A where A == St0> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T1 is Tr0, T2 is Tr0>() { needTr0<St0>() }
fun q1<T0, T1, T2 where T1 is Tr0, T2 is Tr0>() { needTr0<St1>() }
fun q2<T0, T1, T2 where T0 is Tr0>() { needTr0<St3<St0, St0>>() }
fun q3<T0, T1, T2 where T0 is Tr0>() { needTr0<St3<T0, St1>>() }
fun q4() { needTr0<St3<St0, St0>>() }
fun q5() { needTr0<St1>() }
