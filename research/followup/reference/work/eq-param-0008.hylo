trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St2<St1> is Tr0 {}
given <A where A == St1> => St4<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T2 is Tr1, T1 == T0>() { needTr1<T2>() }
fun q1<T0, T1, T2 where T1 == T0>() { needTr1<T2>() }
fun q2<T0, T1, T2, T3, T4 where T4 is Tr1, T0 == T3, T1 == T3, T0 is Tr0>(x: St4<St3<T0, T0>>) { check<St4<St3<T0, T1>>>(x) }
fun q3<T0, T1, T2, T3, T4 where T4 is Tr1, T0 == T3, T1 == T3, T0 is Tr0>(x: {St0, T4}) { check<{St1, T4}>(x) }
fun q4<T0, T1 where St2<T1> is Tr1, T1 == T0, T1 is Tr1>(x: St4<T1>) { check<St4<T0>>(x) }
fun q5<T0, T1 where St2<T1> is Tr1, T1 == T0, T1 is Tr1>() { needTr1<St2<St3<St0, St0>>>() }
