trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St1 is Tr0 {}
given <A where A == St0, A is Tr0> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T0b where T1 == T0b, T0 is Tr0, T0b is Tr0, T1 == T0>() { needTr0<T1>() }
fun q1<T0, T1, T2, T1b, T2b where St4<T1b> is Tr0, St4<T1> is Tr0, T1b is Tr0, T2 == T1, T1 is Tr0, T0 == T2b, T0 == T2, T1b == T2b>() { needTr0<T0>() }
fun q2<T0, T1, T0b where T0 is Tr0, St2<T1> is Tr0, T1 == T0b, T0b is Tr0, T1 == T0>() { needTr0<T1>() }
fun q3<T0, T1, T1b where T1 == T0, T1 is Tr0, T1b is Tr0, T1b == T0>() { needTr0<T0>() }
