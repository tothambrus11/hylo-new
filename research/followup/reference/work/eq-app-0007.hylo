trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St1 is Tr0 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where St3<T1, T2> == T0, St2<T2> == St2<St1>>(x: St4<St2<St1>>) { check<St4<St2<T2>>>(x) }
fun q1<T0, T1, T2 where St3<T1, T2> == T0>(x: St4<St2<St1>>) { check<St4<St2<T2>>>(x) }
fun q2<T0, T1, T2, T3 where T1 is Tr1, T2 is Tr1, T3 == St1, St4<T0> is Tr1>() { needTr0<T3>() }
fun q3<T0, T1, T2, T3 where T1 is Tr1, T2 is Tr1, T3 == St1, St4<T0> is Tr1>(x: T2) { check<St1>(x) }
fun q4<T0, T1, T2 where {T2, T1} == {T1, T1}, {T0, T1} == {T2, T0}>(x: St3<{T1, T1}, T1>) { check<St3<{T2, T1}, T1>>(x) }
fun q5<T0, T1, T2 where {T2, T1} == {T1, T1}, {T0, T1} == {T2, T0}>(x: T0) { check<T2>(x) }
