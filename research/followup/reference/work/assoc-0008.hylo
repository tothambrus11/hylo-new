trait Tr0 { type X0 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given <A where A is Tr0, A == St0> => St2<A> is Tr0 { type X0 = A }
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T4 is Tr0, T2 is Tr0, St2<T3> is Tr0>(x: T2.X0) { check<T2.X0>(x) }
fun q1<T0, T1, T2, T3, T4 where T4 is Tr0, T2 is Tr0, St2<T3> is Tr0>() { needTr0<St2<T4.X0>>() }
fun q2<T0, T1, T2 where T1 == T0>(x: St2<T0>) { check<St2<T0>>(x) }
fun q3<T0, T1, T2 where T1 == T0>() { needTr0<T1>() }
fun q4<T0, T1, T2, T3 where T3 == T1>() { needEq<St2<T3>, St2<T1>>() }
fun q5<T0, T1, T2, T3>() { needEq<St2<T3>, St2<T1>>() }
