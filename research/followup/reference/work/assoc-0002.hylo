trait Tr0 { type X0 }
trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A> => St4<A> is Tr0 { type X0 = St0 }
given St0 is Tr0 { type X0 = St0 }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where St2<T4> is Tr1, T0 == T2, T1 is Tr0, T1.X0 == St2<T3>, St1 == T1.X0>(x: St4<St1>) { check<St4<T1.X0>>(x) }
fun q1<T0, T1, T2, T3, T4 where St2<T4> is Tr1, T0 == T2, T1 is Tr0, T1.X0 == St2<T3>>(x: St4<St1>) { check<St4<T1.X0>>(x) }
fun q2<T0, T1 where T0 == T1>() { needTr0<St4<St2<St0.X0>>>() }
fun q3<T0, T1 where T0 == T1>() { needTr1<St2<T0>>() }
fun q4<T0, T1, T2, T3, T4 where T3 is Tr0, T1 is Tr0, T0 is Tr0>(x: T0.X0) { check<T0.X0>(x) }
fun q5<T0, T1, T2, T3, T4 where T3 is Tr0, T1 is Tr0, T0 is Tr0>(x: St2<T4.X0>) { check<St2<T4.X0>>(x) }
