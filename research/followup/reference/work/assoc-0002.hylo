trait Tr0 { type X0 }
trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A> => St4<A> is Tr0 { type X0 = St0 }
given St0 is Tr0 { type X0 = St0 }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T1.X0 == St2<T3>, St1 == T1.X0, St2<T4> is Tr1, T0 == T2, T1 is Tr0>(x: St2<T3>) { check<T1.X0>(x) }
fun q1<T0, T1, T2, T3, T4 where St1 == T1.X0, St2<T4> is Tr1, T0 == T2, T1 is Tr0>(x: St2<T3>) { check<T1.X0>(x) }
fun q2<T0, T1, T2, T3 where T1 == T2, T2 is Tr0, T1 is Tr1, T2.X0 is Tr0>(x: St3<T2.X1, T1>) { check<St3<T2.X1, T2>>(x) }
fun q3<T0, T1, T2, T3 where T1 == T2, T2 is Tr0, T1 is Tr1, T2.X0 is Tr0>() { needTr0<St2<St0.X0>>() }
fun q4<T0, T1, T2, T3 where T2 == T0>() { needEq<St2<St3<T3, St0>>, St2<St3<T3, St0.X0>>>() }
fun q5<T0, T1, T2, T3 where T2 == T0>() { needTr0<St2<St4<St0>>>() }
