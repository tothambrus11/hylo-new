trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given <A where A is Tr1> => A is Tr2 {}
given <A> => St2<A> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T1 is Tr1, T4 == T3, T0 is Tr1, T2 is Tr1>() { needTr2<T1>() }
fun q1<T0, T1, T2, T3, T4 where T1 is Tr1, T4 == T3, T0 is Tr1, T2 is Tr1>() { needTr2<T4>() }
fun q2<T0, T1 where T1 == T0, T0 is Tr1>() { needTr2<T1>() }
fun q3<T0, T1 where T1 == T0>() { needTr2<T1>() }
fun q4<T0, T1 where T0 == T1>(x: St2<T1>) { check<St2<T0>>(x) }
fun q5<T0, T1>(x: St2<T1>) { check<St2<T0>>(x) }
