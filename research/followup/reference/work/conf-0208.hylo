trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1 where T1 is Tr0>() { needTr0<T1>() }
fun q1<T0, T1>() { needTr0<T1>() }
fun q2<T0, T1 where T1 is Tr0>() { needTr0<St0>() }
fun q3<T0, T1 where T1 is Tr0>() { needTr0<St4<St3<T0, St0>>>() }
fun q4<T0 where T0 is Tr0, St2<T0> is Tr0>() { needTr0<St0>() }
fun q5<T0 where T0 is Tr0, St2<T0> is Tr0>() { needTr0<St2<St2<T0>>>() }
