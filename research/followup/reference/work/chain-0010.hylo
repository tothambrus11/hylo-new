trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A> => St2<A> is Tr0 {}
given <A, B where A == St0> => St3<A, B> is Tr0 {}
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T3 == T2, T0 == T3, T0 == T1>(x: St3<T2, T2>) { check<St3<T1, T2>>(x) }
fun q1<T0, T1, T2, T3 where T0 == T3, T0 == T1>(x: St3<T2, T2>) { check<St3<T1, T2>>(x) }
fun q2<T0, T1, T2, T3 where T3 == T2, T0 == T3, T0 == T1>() { needTr0<T2>() }
fun q3<T0, T1 where T1 == T0>(x: St2<St3<T0, St0>>) { check<St2<St3<T1, St0>>>(x) }
fun q4<T0, T1>(x: St2<St3<T0, St0>>) { check<St2<St3<T1, St0>>>(x) }
fun q5<T0, T1 where T1 is Tr0, T0 == T1>(x: St3<T1, T1>) { check<St3<T0, T0>>(x) }
