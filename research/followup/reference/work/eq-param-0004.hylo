trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A where A is Tr0> => St3<A, St1> is Tr1 {}
given St1 is Tr1 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T1 == T0, T2 is Tr1>() { needEq<St3<T1, T0>, St3<T0, T0>>() }
fun q1<T0, T1, T2 where T2 is Tr1>() { needEq<St3<T1, T0>, St3<T0, T0>>() }
fun q2<T0, T1 where T1 == T0>(x: St3<T0, St1>) { check<St3<T1, St1>>(x) }
fun q3<T0, T1>(x: St3<T0, St1>) { check<St3<T1, St1>>(x) }
fun q4<T0, T1, T2 where T1 is Tr0, T0 is Tr0, T2 == T0, T2 == T1>() { needEq<St3<St3<T1, T1>, St3<T0, St1>>, St3<St3<T0, T2>, St3<T2, St1>>>() }
fun q5<T0, T1, T2 where T1 is Tr0, T0 is Tr0, T2 == T0, T2 == T1>() { needTr1<St3<T2, T1>>() }
