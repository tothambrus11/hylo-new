trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St2<St1> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where St2<T1> == St2<T0>, St2<T2> == T1, T2 == St3<T2, T0>, T0 is Tr0, T2 is Tr2>(x: St2<T1>) { check<St2<St2<T2>>>(x) }
fun q1<T0, T1, T2 where St2<T1> == St2<T0>, St2<T2> == T1, T2 == St3<T2, T0>, T0 is Tr0, T2 is Tr2>(x: St2<T2>) { check<T2>(x) }
fun q2<T0, T1, T2 where {T1, T2} == {T0, T1}, T2 == T0, St2<St1> == St2<T0>, T1 is Tr1, T1 is Tr2>() { needTr0<St2<T0>>() }
fun q3<T0, T1, T2 where {T1, T2} == {T0, T1}, T2 == T0, St2<St1> == St2<T0>, T1 is Tr1, T1 is Tr2>() { needEq<St1, {T1, T2}>() }
fun q4<T0, T1, T2, T3, T4 where St2<T1> is Tr0, St2<T0> == St2<T4>, T4 == St2<T0>, T4 is Tr0, T2 is Tr2, St2<T3> == St2<T2>>() { needTr0<St2<St2<T0>>>() }
fun q5<T0, T1, T2, T3, T4 where St2<T1> is Tr0, St2<T0> == St2<T4>, T4 == St2<T0>, T4 is Tr0, T2 is Tr2, St2<T3> == St2<T2>>() { needEq<T4, St1>() }
