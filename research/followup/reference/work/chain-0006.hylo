trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St0 is Tr0 {}
given St0 is Tr1 {}
given St0 is Tr2 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where St2<T0> is Tr0, T1 == T2, T2 is Tr0, T2 is Tr2>() { needEq<St3<St2<T0>, St2<T1>>, St3<St2<T0>, St2<T2>>>() }
fun q1<T0, T1, T2 where St2<T0> is Tr0, T1 == T2, T2 is Tr0, T2 is Tr2>(x: St0) { check<St1>(x) }
fun q2<T0, T1, T2, T3 where St2<T2> == St2<T1>, T2 == T0>() { needTr1<St0>() }
fun q3<T0, T1, T2, T3 where St2<T2> == St2<T1>, T2 == T0>() { needTr0<T2>() }
fun q4<T0, T1, T2 where St2<T2> == St2<T1>, St2<T1> is Tr1>() { needTr1<St2<T2>>() }
fun q5<T0, T1, T2 where St2<T2> == St2<T1>, St2<T1> is Tr1>(x: St2<T1>) { check<St2<St2<St2<T2>>>>(x) }
