trait Tr0 {}
trait Tr1 {}
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St4<E0> { public memberwise init }
given St0 is Tr1 {}
given St2<St1> is Tr1 {}
given <A where A is Tr0> => St2<A> is Tr0 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3 where T3 == T0, T0 == T2>() { needEq<T0, T3>() }
fun q1<T0, T1, T2, T3 where T0 == T2>() { needEq<T0, T3>() }
fun q2<T0, T1, T2, T3, T4 where T1 is Tr0, T4 == T1, T2 == T4, T0 == T3>() { needTr0<T2>() }
fun q3<T0, T1, T2, T3, T4 where T1 is Tr0, T4 == T1, T2 == T4, T0 == T3>() { needTr0<St4<T2>>() }
fun q4<T0, T1, T2 where T1 == T2, T0 is Tr0, St4<T2> is Tr2, T2 is Tr0, T1 == T0>() { needTr0<St2<T1>>() }
fun q5<T0, T1, T2 where T1 == T2, T0 is Tr0, St4<T2> is Tr2, T2 is Tr0, T1 == T0>(x: St1) { check<T0>(x) }
