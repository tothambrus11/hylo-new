trait Tr0 { type X0 }
trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A where A is Tr0> => A is Tr1 { type X1 = St0 }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T2.X0 == St0, T4 == T2, T2 is Tr0>() { needTr1<T4>() }
fun q1<T0, T1, T2, T3, T4 where T2.X0 == St0, T4 == T2, T2 is Tr0>() { needTr1<St3<T2.X0, St2<T2>>>() }
fun q2<T0, T1, T2, T3 where T2 is Tr1, T3 is Tr0, T2.X1 == St2<T3>>(x: St3<T1, St2<T3>>) { check<St3<T1, T2.X1>>(x) }
fun q3<T0, T1, T2, T3 where T2 is Tr1, T3 is Tr0>(x: St3<T1, St2<T3>>) { check<St3<T1, T2.X1>>(x) }
fun q4<T0, T1, T2 where T2 is Tr0, T1 == T0>(x: St3<T2.X0, St0>) { check<St3<T2.X0, St0>>(x) }
fun q5<T0, T1, T2 where T2 is Tr0, T1 == T0>() { needEq<St0, St2<T1.X0>>() }
