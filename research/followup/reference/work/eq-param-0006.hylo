trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given <A, B where A is Tr1> => St3<A, B> is Tr1 {}
given St1 is Tr1 {}
given St0 is Tr1 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2 where T2 is Tr1, T0 is Tr0, St2<T1> is Tr1, T2 == T1>() { needTr1<St3<T2, T0>>() }
fun q1<T0, T1, T2 where T2 is Tr1, T0 is Tr0, St2<T1> is Tr1, T2 == T1>() { needTr0<St2<T1>>() }
fun q2<T0, T1, T2 where T1 is Tr1, T0 == T2, T1 is Tr0>() { needEq<St3<T2, T0>, St3<T2, T2>>() }
fun q3<T0, T1, T2 where T1 is Tr1, T0 == T2, T1 is Tr0>() { needTr1<{St2<T1>, St2<T0>}>() }
fun q4<T0, T1, T2, T3, T4 where T0 == T3, T2 == T1, T3 == T2>(x: St3<T3, T2>) { check<St3<T2, T1>>(x) }
fun q5<T0, T1, T2, T3, T4 where T0 == T3, T2 == T1, T3 == T2>() { needTr1<St3<T0, T2>>() }
