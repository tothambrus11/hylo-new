trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St0 is Tr0 {}
given <A where A is Tr1> => St2<A> is Tr1 {}
given St1 is Tr0 {}
given St1 is Tr1 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T1b where T1 is Tr1, T1 == T0, T1b == T0, T1b is Tr1>() { needTr1<T0>() }
fun q1<T0, T1, T2, T3, T4, T1b, T2b, T3b, T4b where T3b == T2b, T3b is Tr1, T1b == T2b, T1 == T2, T3 is Tr1, T3 == T0, T0 == T3b, T3 == T2>() { needTr1<St2<T0>>() }
fun q2<T0, T1, T0b where T0 is Tr1, T1 == T0b, T0b is Tr1, T0 == T1>() { needTr1<St2<T1>>() }
fun q3<T0, T1, T2, T3, T0b, T1b, T2b where T1 is Tr1, T1b is Tr1, T1 == T3, T3 == T1b>() { needTr1<T3>() }
