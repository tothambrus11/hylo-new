trait Tr0 { type X0 }
trait Tr1 { type X1 }
trait Tr2 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given St1 is Tr2 {}
given St0 is Tr2 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needTr2<W where W is Tr2>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4>() { needTr2<St0>() }
fun q1<T0, T1, T2, T3, T4>() { needEq<T3, T3.X0>() }
fun q2<T0, T1, T2, T3, T4 where T3 == T4, T0 is Tr1>(x: St2<T3>) { check<St2<T4>>(x) }
fun q3<T0, T1, T2, T3, T4 where T3 == T4, T0 is Tr1>() { needEq<St1, T1.X1>() }
fun q4<T0, T1, T2>() { needTr2<St0>() }
fun q5<T0, T1, T2>() { needEq<St2<St2<St0>>, St2<T2>>() }
