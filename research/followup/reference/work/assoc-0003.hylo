trait Tr0 { type X0 }
trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given <A> => St2<A> is Tr0 { type X0 = A }
given St2<St0> is Tr1 { type X1 = St1 }
given St1 is Tr1 { type X1 = St1 }
given St0 is Tr1 { type X1 = St1 }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3>() { needTr1<St0.X1>() }
fun q1<T0, T1, T2, T3>() { needTr1<St2<T0.X0>>() }
fun q2<T0, T1, T2 where T1 is Tr1, St2<T1> is Tr0>() { needTr1<St1.X1>() }
fun q3<T0, T1, T2 where T1 is Tr1, St2<T1> is Tr0>() { needTr1<T0>() }
fun q4<T0, T1, T2, T3 where T3 is Tr0, T3 is Tr1, St2<T1> == T3.X0, T3.X1 == St0.X1, T2 is Tr0, T3.X0 == T2.X0>() { needEq<St2<T1>, T2.X0>() }
fun q5<T0, T1, T2, T3 where T3 is Tr0, T3 is Tr1, T3.X1 == St0.X1, T2 is Tr0, T3.X0 == T2.X0>() { needEq<St2<T1>, T2.X0>() }
