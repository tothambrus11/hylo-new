trait Tr0 { type X0 }
trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
given <A> => St2<A> is Tr0 { type X0 = A }
given St2<St0> is Tr1 { type X1 = St1 }
given St1 is Tr1 { type X1 = St1 }
given St0 is Tr1 { type X1 = St1 }
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3>() { needTr0<St2<T3>>() }
fun q1<T0, T1, T2, T3>() { needEq<St1.X0, St1.X0>() }
fun q2<T0, T1, T2 where T1 is Tr0, T1.X0 is Tr0>() { needTr0<T1.X0>() }
fun q3<T0, T1, T2 where T1 is Tr0>() { needTr0<T1.X0>() }
fun q4<T0, T1, T2 where St0.X1 == St2<T2>, T1 is Tr1>(x: St2<St2<T2>>) { check<St2<St0.X1>>(x) }
fun q5<T0, T1, T2 where T1 is Tr1>(x: St2<St2<T2>>) { check<St2<St0.X1>>(x) }
