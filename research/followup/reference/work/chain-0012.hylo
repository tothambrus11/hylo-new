trait Tr0 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
struct St4<E0> { public memberwise init }
given St0 is Tr0 {}
given St4<St1> is Tr0 {}
given St1 is Tr0 {}
given St3<St1, St0> is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T0 == St4<T1>, T2 == T0, T4 == T1>() { needEq<St2<T0>, St2<St4<T4>>>() }
fun q1<T0, T1, T2, T3, T4 where T0 == St4<T1>, T2 == T0, T4 == T1>() { needTr0<St4<T1>>() }
fun q2<T0, T1, T2 where T0 is Tr0, T0 == St2<T2>, T0 == T1>() { needTr0<St2<T2>>() }
fun q3<T0, T1, T2 where T0 == St2<T2>, T0 == T1>() { needTr0<St2<T2>>() }
fun q4<T0, T1, T2 where T0 is Tr0, T0 == St2<T2>, T0 == T1>() { needEq<T2, T1>() }
fun q5<T0, T1, T2 where T2 == T0, T0 is Tr0, T0 == T1, T2 is Tr0>(x: St3<T1, T2>) { check<St3<T2, T0>>(x) }
