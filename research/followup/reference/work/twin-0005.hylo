struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St4<E0> { public memberwise init }
given <A where A is Tr1> => St4<A> is Tr1 {}
given St0 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T1b, T2b, T3b where T2 == T0, T3 is Tr0, T3b is Tr0, T1b == T2b, T3b == T1b, T2 == T1, T0 == T2b, T1 == T3>() { needTr0<T0>() }
fun q1<T0, T1, T2, T0b, T1b where T1 == T2, T0b is Tr1, T2 is Tr1, T1b == T2, T2 == T0, T0 is Tr1, T0b == T2, St2<T1> is Tr0, St2<T1b> is Tr0>() { needTr0<St2<T2>>() }
