trait Tr0 {}
trait Tr1 {}
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct St2<E0> { public memberwise init }
struct St3<E0, E1> { public memberwise init }
given St1 is Tr0 {}
fun needTr0<W where W is Tr0>() {}
fun needTr1<W where W is Tr1>() {}
fun needEq<X, Y where X == Y>() {}
fun check<X>(x: X) {}
fun q0<T0, T1, T2, T3, T4 where T1 == T2, T3 == T1, T2 == T4, T2 is Tr1, St2<T4> is Tr1>(x: St3<St2<T4>, T4>) { check<St3<St2<T4>, T3>>(x) }
fun q1<T0, T1, T2, T3, T4 where T1 == T2, T3 == T1, T2 == T4, T2 is Tr1, St2<T4> is Tr1>() { needTr1<St2<St2<T4>>>() }
fun q2<T0, T1, T2, T3 where T1 == T2, T3 is Tr0, T1 == T3, St2<T3> is Tr1, St2<T3> is Tr0>() { needTr0<St2<T2>>() }
fun q3<T0, T1, T2, T3 where T1 == T2, T3 is Tr0, T1 == T3, St2<T3> is Tr1, St2<T3> is Tr0>() { needEq<T0, St0>() }
fun q4<T0, T1 where T0 is Tr0, T1 == T0>() { needEq<St3<T0, St0>, St3<T1, St0>>() }
fun q5<T0, T1 where T0 is Tr0>() { needEq<St3<T0, St0>, St3<T1, St0>>() }
