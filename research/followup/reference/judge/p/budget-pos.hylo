trait P {}
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct S3<E0, E1> { public memberwise init }
given S0 is P {}
given <A where A == S0, A is P> => S3<S0, A> is P {}
fun needP<W where W is P>() {}
fun q0<T, U where U == T, T == S0>() { needP<S3<U, S0>>() }
fun q1<T, U where U == S0>() { needP<S3<U, S0>>() }
fun q2() { needP<S3<S0, S0>>() }
