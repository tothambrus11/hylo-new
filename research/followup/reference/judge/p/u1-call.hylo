trait Tr1 { type X1 }
struct St0 { public memberwise init }
struct St1 { public memberwise init }
struct Box<E> { public memberwise init }
given <A> => Box<A> is Tr1 { type X1 = A }
fun take<T where T is Tr1>(w: T, x: T.X1) {}
fun q0(b: Box<St0>, x: St0) { take<Box<St0>>(b, x) }
fun q1(b: Box<St0>, x: St1) { take<Box<St0>>(b, x) }
fun q2(b: Box<St0>, x: St0) { take(b, x) }
fun q3(b: Box<St0>, x: St1) { take(b, x) }
