trait T0 {}
trait T1 refines T0 {}
trait T2 refines T1 {}
struct X {}
struct Y {}
struct Z {}
given X is T0 {}
given Y is T0 {}
given X is T1 {}
given Y is T1 {}
given X is T2 {}
given Y is T2 {}
struct Opt<T> {}
given <T is T0> => Opt<T> is T0 {}
given <T is T1> => Opt<T> is T1 {}
given <T is T2> => Opt<T> is T2 {}
fun need<T is T0>() {}
public fun main() { need<Opt<Opt<Opt<Opt<Opt<Opt<Opt<Opt<Z>>>>>>>>>() }
