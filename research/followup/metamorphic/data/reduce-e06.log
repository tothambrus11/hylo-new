//! stage:typing no-std
trait P {}
trait Q {}
trait R {}
fun g<V where V == V, V is P>() {}
fun f<A, B where B == A>() {
  fun k() {
    given A is R {}
    fun h() {
      given B is P {}
      given <where A is Q> => A is P {}
      given <where A is R> => A is Q {}
      g<A>()
    }
  }
}

