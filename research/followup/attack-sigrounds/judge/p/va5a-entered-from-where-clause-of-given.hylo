// Judge, variant A4 (owner first): finding 1 with the member entered from the where clause of another
// conformance (not from a subject). Well-typed: A.LA is A and A is Q.
trait Q {}
trait R {}
struct A {}
struct B {}
given A is Q {}
extension <where LA is Q> A { type LA = Self }
given <where A.LA is Q> => B is R {}
