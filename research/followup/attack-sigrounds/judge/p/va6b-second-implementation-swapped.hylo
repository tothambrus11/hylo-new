// Judge, variant A6 (owner last): finding 2 (conformance form, a02) with the member entered through a second
// implementation of the same conformance, `Z = Y`. Well-typed in the sense of a02b: BA.Z is Int.
trait P { type X }
trait Q {}
trait R {}
trait S {
  type Y
  type Z
}
struct A {}
struct Box<T> {}
struct Foo<T> {}
given A is P { type X = Int }
given <U> => Foo<U> is Q {}
type BA = Box<A>
given BA.Z is R {}
given <T where T is P, Foo<Y> is Q> => Box<T> is S {
  type Y = T.X
  type Z = Y
}
