// Judge, variant A1 (extension before given): finding 1 with the member reached through a top-level alias instead of
// directly in the subject of the given. Well-typed: AL is A, A is Q holds, the given is A is R.
trait Q {}
trait R {}
struct A {}
given A is Q {}
type AL = A.LA
extension <where LA is Q> A { type LA = Self }
given AL is R {}
