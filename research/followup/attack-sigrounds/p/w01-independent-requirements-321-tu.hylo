// Three independent requirements, one of which uses an alias defined through a conformance
// (requirement order [3, 2, 1], generic parameters T, U). Every permutation must be accepted.
trait P { type X }
trait P2 {}
trait Q {}
trait R {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Foo<T> {}
struct Pair<T, U> { public memberwise init }
given A is P { type X = Int }
given B is P2 {}
type K = A.X
given Foo<K> is Q {}
given <T, U where Foo<K> is Q, U is P2, T is P> => Pair<T, U> is R {}
fun need<T where T is R>(x: T) {}
public fun main() { need(Pair<A, B>()) }
