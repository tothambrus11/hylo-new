// As a01 with a conformance as the owner: its where clause names its own implementation `Y`,
// which needs the first requirement. The last given reaches `Y` through `BA.Y`.
trait P { type X }
trait Q {}
trait R {}
trait S { type Y }
struct A {}
struct Box<T> {}
struct Foo<T> {}
given A is P { type X = Int }
given <U> => Foo<U> is Q {}
type BA = Box<A>
given <T where T is P, Foo<Y> is Q> => Box<T> is S { type Y = T.X }
given BA.Y is R {}
