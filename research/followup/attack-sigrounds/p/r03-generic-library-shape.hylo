// The ordinary shape of generic library code, with a refinement, a conditional conformance, a
// conditional extension, a member selected through a requirement, and uses.
trait Equatable { fun eq(_ other: Self) -> Bool }
trait Collection { type Element; fun first() -> Element }
trait Sorted refines Collection {}
struct IntArray { public memberwise init }
struct Wrapper<C> { public var base: C; public memberwise init }
given Int is Equatable { public fun eq(_ other: Int) -> Bool { true } }
given IntArray is Collection { type Element = Int; public fun first() -> Int { 0 } }
given IntArray is Sorted {}
given <C where C is Collection> => Wrapper<C> is Collection {
  type Element = C.Element
  public fun first() -> C.Element { self.base.first() }
}
given <C where C is Collection, C.Element is Equatable> => Wrapper<C> is Equatable {
  public fun eq(_ other: Wrapper<C>) -> Bool { true }
}
extension <C where C is Sorted, C.Element is Equatable> Wrapper<C> {
  public fun smallest() -> C.Element { self.base.first() }
}
fun same<T where T is Equatable>(_ a: T, _ b: T) -> Bool { a.eq(b) }
public fun main() {
  let w = Wrapper<IntArray>(base: IntArray())
  let x: Int = w.smallest()
  let y: Int = w.first()
  let _ = same(w, w)
  let _ = same(x, y)
}
