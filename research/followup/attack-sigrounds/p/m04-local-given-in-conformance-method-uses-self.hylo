// A conformance in the body of a method of a generic conformance; its subject is `Self`, and the
// conformance around it has a where clause that goes through another conformance.
trait P { type X; fun f() }
trait Q {}
trait R {}
struct A {}
struct Box<T> { public memberwise init }
given A is P { type X = Int; fun f() {} }
given Int is R {}
fun need<T where T is Q>(x: T) {}
given <T where T is P, T.X is R> => Box<T> is P {
  type X = T.X
  fun f() {
    given Self is Q {}
    need(self)
  }
}
