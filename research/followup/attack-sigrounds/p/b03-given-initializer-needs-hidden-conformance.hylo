// The initializer of an ascribed given calls a function whose requirement is satisfied by a
// conformance of the module (hidden in round 1).
trait P {}
struct A { public memberwise init }
struct B {}
given B is P {}
fun make<where B is P>() -> A { A() }
given let a: A = make()
fun need<where let u: A>() {}
public fun main() { need() }
