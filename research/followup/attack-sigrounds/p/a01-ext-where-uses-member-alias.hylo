// The where clause of the extension names the extension's own member alias `LA`, which needs the
// first requirement. Entered at the extension: fine. Entered at `LA` (through `BA.LA` in the
// last given, which finds the extension in the table): the hook types the where clause inside
// `LA`, which the where clause needs.
trait P { type X }
trait Q {}
trait R {}
struct A {}
struct Box<T> {}
struct Foo<T> {}
given A is P { type X = Int }
given <U> => Foo<U> is Q {}
type BA = Box<A>
extension <T where T is P, Foo<LA> is Q> Box<T> { type LA = T.X }
given BA.LA is R {}
