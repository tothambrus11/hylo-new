// The conformance of `A` to `P` is declared with the struct. The alias goes through a generic
// conformance that requires it.
trait P { type X }
trait P2 { type Z }
trait Q {}
struct A is P { type X = Int }
struct Wrap<T> {}
given <T where T is P> => Wrap<T> is P2 { type Z = T.X }
type WA = Wrap<A>
type K = WA.Z
given K is Q {}
fun need<T where T is Q>(x: T) {}
fun use(x: Int) { need(x) }
