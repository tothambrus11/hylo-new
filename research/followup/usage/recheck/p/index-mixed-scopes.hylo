//! stage:typing no-std
// One file with a function without equalities and a function with one: is the index lost only in the second?
trait P { type X }
trait Q {}
struct A { public memberwise init }
struct Box<T> { public memberwise init }
given A is Q {}
given <T where T is Q> => Box<T> is Q {}
fun needQ<T where T is Q>() {}
fun withoutEquality<T where T is P>() { needQ<Box<Box<A>>>() }
fun withEquality<T, U where T is P, T.X == U>() { needQ<Box<Box<A>>>() }
