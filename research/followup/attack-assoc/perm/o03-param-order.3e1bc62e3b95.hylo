fun ok2(x: P01.Z) { check<S0>(x) }
fun ok1(x: P01.X) { check<S1>(x) }
type P01 = Pair<S0, S1>
fun check<T>(x: T) {}
given <U, T> => Pair<T, U> is P { type X = U
  type Z = T }
struct Pair<T, U> { public memberwise init }
struct S1 { public memberwise init }
struct S0 { public memberwise init }
trait P { type X
  type Z }
