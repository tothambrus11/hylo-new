fun bad4(b: Box<S0>, c: Box<Box<S1>>) { give(c, b) }
fun bad3(b: Box<S0>, c: Box<S1>) { give(c, pick(b)) }
fun bad2(c: Box<Box<S0>>) { check<S0>(pick(c)) }
fun bad1(b: Box<S0>) { check<S1>(pick(b)) }
fun check<T>(x: T) {}
fun give<T where T is P>(t: T, x: T.X) {}
fun pick<T where T is P>(t: T) -> T.X { pick(t) }
given <T> => Box<T> is P { type X = T }
struct Box<T> { public memberwise init }
struct S1 { public memberwise init }
struct S0 { public memberwise init }
trait P { type X }
