// Judge, finding 2, variant C, valid twin: the call returns a Pair<U, W>.
trait P { type X
  fun get() -> X
  fun m<U, W>(b: Box<Pair<U, W>>, c: Box<Pair<W, U>>) -> X {
    let r: Pair<U, W> = b.m<W, U>(c, b)
    return self.get() } }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var t: T
  public memberwise init }
struct Pair<A, B> { public memberwise init }
given <T> => Box<T> is P { type X = T
  fun get() -> T { self.t } }
