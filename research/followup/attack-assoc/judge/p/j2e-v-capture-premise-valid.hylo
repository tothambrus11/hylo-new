// Judge, finding 2, variant E, valid twin: the call returns a U.Y.
trait Q { type Y }
trait P { type X
  fun get() -> X
  fun m<U where U is Q>(b: Box<U>, c: Box<S0>) -> X {
    let r: U.Y = b.m<S0>(c, c)
    return self.get() } }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var t: T
  public memberwise init }
given S0 is Q { type Y = S1 }
given <T where T is Q> => Box<T> is P { type X = T.Y
  fun get() -> T.Y { self.get() } }
