// Judge, finding 1, variant B. One generic parameter and a concrete type instead of two parameters:
// in `mid`, A conforms through the local given (X = S0) and T, which is A, through the requirement
// of `mid`, which `h` discharges with its own local given (X = S1). Invalid: w.one() is a T.X
// through the requirement, A().two expects an A.X through the local given, which is S0.
trait P { type X
  fun get() -> X
  fun put(x: X) }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct A { public memberwise init }
extension <T where T is P> T {
  fun one() -> T.X { self.get() }
  fun two(x: T.X) { self.put(x) } }
fun mid<T where T == A, T is P>(w: T) {
  given A is P { type X = S0
    fun get() -> S0 { S0() }
    fun put(x: S0) {} }
  A().two(w.one())
}
fun h() {
  given A is P { type X = S1
    fun get() -> S1 { S1() }
    fun put(x: S1) {} }
  mid<A>(A())
}
