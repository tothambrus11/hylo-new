// Judge, finding 2, variant B, valid twin: the call returns a Box<U>.
trait P { type X
  fun get() -> X
  fun m<U>(b: Box<Box<U>>, c: Box<Box<S0>>) -> X {
    let r: Box<U> = b.m<S0>(c, c)
    return self.get() } }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var t: T
  public memberwise init }
given <T> => Box<T> is P { type X = T
  fun get() -> T { self.t } }
