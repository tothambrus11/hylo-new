// Judge, finding 2, variant H. F reduced and made concrete, with a guarded recursion. No trait, no
// extension. In m, b is a Box<U>, so b.m<S0>(c, c, false) returns the T of b, which is U. main calls
// m<S1>: the S1 stored in b is returned by b.m<S0>(c, c, false) and passed to takeS0. Invalid.
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var t: T
  public memberwise init
  public fun first() -> T { self.first() }
  public fun m<U>(b: Box<U>, c: Box<S0>, again: Bool) -> T {
    if again { takeS0(b.m<S0>(c, c, false)) }
    return self.first() } }
fun takeS0(x: S0) {}
public fun main() {
  let a = Box<S0>(t: S0())
  let r: S0 = a.m<S1>(Box<S1>(t: S1()), Box<S0>(t: S0()), true)
}
