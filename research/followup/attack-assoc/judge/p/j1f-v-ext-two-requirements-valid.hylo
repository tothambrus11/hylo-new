// Judge, finding 1, variant F, valid twin: one parameter.
trait P { type X
  fun get() -> X
  fun put(x: X) }
extension <T where T is P, T.X is P> T {
  fun one() -> T.X.X { self.get().get() }
  fun two(x: T.X.X) { self.get().put(x) } }
fun f<V where V is P, V.X is P>(v: V, w: V) { v.two(w.one()) }
