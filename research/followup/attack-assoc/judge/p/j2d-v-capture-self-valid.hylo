// Judge, finding 2, variant D, valid twin: the call returns a Box<U>.
trait P {
  fun me() -> Self
  fun m<U>(b: Box<U>, c: Box<S0>) -> Self {
    let r: Box<U> = b.m<S0>(c, c)
    return self.me() } }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public var t: T
  public memberwise init }
given <T> => Box<T> is P {
  fun me() -> Box<T> { self.me() } }
