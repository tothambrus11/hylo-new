// assocsubst: Box<Box<S0>>.X is Box<S0>; each function is invalid (three errors expected).
trait P { type X }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Box<T> { public memberwise init }
given <T> => Box<T> is P { type X = T }
fun check<T>(x: T) {}
type BB0 = Box<Box<S0>>
type BB1 = Box<Box<S1>>
type BBX = BB0.X
fun bad1(x: BB0.X) { check<S0>(x) }
fun bad2(x: BB0.X) { check<BB1.X>(x) }
fun bad3(x: BBX.X) { check<S1>(x) }
