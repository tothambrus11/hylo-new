// assocsubst: conformance with an equality premise (T == U), X = U. ok valid; bad1 and bad2 invalid (2 errors expected).
trait P { type X
  fun get() -> X }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct Pair<T, U> { public memberwise init }
given <T, U where T == U> => Pair<T, U> is P { type X = U
  fun get() -> U { self.get() } }
fun check<T>(x: T) {}
fun ok(p: Pair<S0, S0>) { check<S0>(p.get()) }
fun bad1(p: Pair<S0, S0>) { check<S1>(p.get()) }
fun bad2(p: Pair<S0, S1>) { check<S1>(p.get()) }
