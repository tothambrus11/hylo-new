// b10 with concrete types: an S1 reaches a function that expects an S0.
// In `mid`, V = A conforms to R through the local givens (X = S0) and W = T through the
// requirement of `mid`, which `h` discharges with its own local givens (X = S1).
trait P { type X
  fun get() -> X
  fun put(x: X) }
trait R refines P {}
struct S0 { public memberwise init }
struct S1 { public memberwise init }
struct A { public memberwise init }
fun g<V, W where V == W, V is R, W is R>(v: V, w: W) { v.put(w.get()) }
fun mid<T where T == A, T is R>(w: T) {
  given A is P { type X = S0
    fun get() -> S0 { S0() }
    fun put(x: S0) {} }
  given A is R {}
  g<A, T>(A(), w)
}
fun h() {
  given A is P { type X = S1
    fun get() -> S1 { S1() }
    fun put(x: S1) {} }
  given A is R {}
  mid<A>(A())
}
