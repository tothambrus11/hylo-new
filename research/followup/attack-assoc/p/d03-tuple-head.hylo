// assocsubst: the head of the conformance is a tuple type. ok valid; bad invalid (1 error expected).
trait P { type X
  fun get() -> X }
struct S0 { public memberwise init }
struct S1 { public memberwise init }
given <T, U> => {T, U} is P { type X = U
  fun get() -> U { self.get() } }
fun check<T>(x: T) {}
fun ok(p: {S0, S1}) { check<S1>(p.get()) }
fun bad(p: {S0, S1}) { check<S0>(p.get()) }
