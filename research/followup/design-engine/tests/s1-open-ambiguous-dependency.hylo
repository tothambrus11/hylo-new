//! stage:typing no-std
// expected (premsubst, step 3): accepted as designed; whether it should be is a question for the
// language designers (DESIGN.md, section 7, question 4). `A is P` has two witnesses of equal rank.
// Each is tried; only the first makes `A.X is Q` hold, so the resolution as a whole has one result.
// The alternative rule ("each requirement must have a unique witness on its own") rejects it.
// currently: base rejected (subgoals=6 matches=447): no coercion from '(P<A>, Q<(A::P).X>) ==> [Void]() let -> Void' to '[Void]() let -> Void'; FULL rejected (subgoals=4 matches=80): no coercion from '(P<A>, Q<(A::P).X>) ==> [Void]() let -> Void' to '[Void]() let -> Void'
trait P { type X }
trait Q {}
struct A {}
struct B {}
struct C {}
given B is Q {}
given A is P { type X = B }
given A is P { type X = C }
fun f<T where T is P, T.X is Q>() {}
public fun main() { f<A>() }
