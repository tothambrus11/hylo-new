//! stage:typing no-std
// expected (premsubst): accepted, as today under FULL, with `eqsolve.premises=0`: the equality
// arrives with the caller's witness already in it.
// (research/report/test-programs/equalities/x10b-ext-where-assoc.hylo, the example of
// research/report/soundness/3-unsimplified-projections.md)
// currently: base accepted (subgoals=4860 matches=91425); FULL accepted (subgoals=7 matches=433 proved=1 premises=1)
trait Collection { type Element }
struct Box<T> { public memberwise init }
struct Flag { public memberwise init }
extension <T where T is Collection, T.Element == Flag> Box<T> {
  type Element = Flag
  fun first() -> Element { Flag() }
}
fun g<T where T is Collection, T.Element == Flag>(b: Box<T>) {
  let f: Flag = b.first()
}
