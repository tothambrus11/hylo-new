//! stage:typing no-std
// attack (review): the order of two dependent requirements still decides the verdict, through the
// bound. 'T.X is Q4' needs 5 steps. Written before 'S<T.X> is R' it is a hypothesis for it (released
// together, the later one is discharged first): 9 steps, accepted. See s1-attack-where-order-b.
// expected (premsubst): accepted; (premsubst + a height bound, section 9): accepted.
// observed: (eq25, premsubst as first designed) FULL+premsubst accepted (bound=1 released=2); +selfcheck same; +assocsubst accepted; NEW accepted
// currently: base rejected (subgoals=32 matches=2488): no coercion from '(P<U>, Q4<(U::P).X>, R<S<(U::P).X>>) ==> [Void]() let -> Void' to '[Void]() let -> Void'; FULL rejected (subgoals=26 matches=270): no coercion from '(P<U>, Q4<(U::P).X>, R<S<(U::P).X>>) ==> [Void]() let -> Void' to '[Void]() let -> Void'
trait P { type X }
trait Q0 {}
trait Q1 {}
trait Q2 {}
trait Q3 {}
trait Q4 {}
trait R {}
struct S<T> {}
given <V where V is Q0> => V is Q1 {}
given <V where V is Q1> => V is Q2 {}
given <V where V is Q2> => V is Q3 {}
given <V where V is Q3> => V is Q4 {}
given <V where V is Q4> => S<V> is R {}
fun f<T where T is P, T.X is Q4, S<T.X> is R>() {}
fun g<U where U is P, U.X is Q0>() { f<U>() }
