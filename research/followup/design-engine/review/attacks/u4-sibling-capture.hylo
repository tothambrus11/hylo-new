//! stage:typing no-std
trait P { type X }
trait Q {}
trait R {}
struct A {}
struct B {}
struct W<T> {}
struct S {
  public memberwise init
  public static fun a<V where A is P, A.X is Q, V is R>() {}
}
given A is P { type X = B }
given B is Q {}
given W<B> is R {}
fun f<where A is P, A.X is Q>() { S.a<W<A.X>>() }
