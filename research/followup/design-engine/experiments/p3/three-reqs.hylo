// Each requirement alone needs 5 steps (a pair is Copyable) and is accepted on its own; the bound
// applies to their sum: 1 + 3 * 5 = 16 steps. (The three types differ on purpose: an identical
// requirement would be proved in one step from the one that is still pending.)
fun one<A where A is Copyable>() {}
fun three<A, B, C where A is Copyable, B is Copyable, C is Copyable>() {}
public fun main() {
  one<{Bool, Int}>()
  one<{Int, Bool}>()
  one<{Int, Int}>()
  three<{Bool, Int}, {Int, Bool}, {Int, Int}>()
}
