//! stage:typing no-std
// A derivation that is a single branch of 10 givens: its size and its height are both over the
// bound, so a bound on the height keeps rejecting it.
trait P {}
struct S<T> {}
struct Z {}
given Z is P {}
given <T where T is P> => S<T> is P {}
fun need<where S<S<S<S<S<S<S<S<S<Z>>>>>>>>> is P>() {}
public fun main() { need() }
