// Expected after the change: accepted, in every order of the top-level declarations.
// Reason: The chain of 06 with every member selected on an alias (`FX.F`, not `Foo<X>.F`, which the existing implementation does not accept as a type expression in any program). No cycle: each given needs the previous one.
// Currently: base rejects it in all 60 orders tried; FULL rejects it in all 60 orders tried.
// Review: this program replaces 06 as the example of a chain. With the design as first written (binary eq17, FULL+sigrounds+selfcheck) it is accepted in all 60 orders tried.
trait P { type E }
trait Q { type F }
struct A {}
struct Foo<T> {}
struct Bar<T> {}
given A is P { type E = Int }
type X = A.E
type FX = Foo<X>
given FX is Q { type F = Bool }
type Y = FX.F
given Bar<Y> is P { type E = A }
type Z = Bar<Y>
type W = Z.E
fun g(y: Y, w: W) {}
