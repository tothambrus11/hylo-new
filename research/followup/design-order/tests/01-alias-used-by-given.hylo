// Expected after the change: accepted, in every order of the top-level declarations.
// Reason: No cycle. `X` needs `A is P`; `Foo<X> is P` needs `X` and can never match `P<A>`.
// Currently: base accepts it in 8 of 24 orders; FULL accepts it in 8 of 24 orders.
trait P { type E }
struct A {}
struct Foo<T> {}
given A is P { type E = Int }
type X = A.E
given Foo<X> is P { type E = Bool }
fun f(x: X) {}
