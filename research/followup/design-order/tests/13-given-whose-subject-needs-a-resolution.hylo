// Expected after the change: accepted, in every order of the top-level declarations.
// Reason: Both givens with subject `A.E` are givens for `Int`; neither can match `P<A>`.
// Currently: base accepts it in all 24 orders tried; FULL accepts it in all 120 orders tried.
trait P { type E }
trait Q {}
struct A {}
given A is P { type E = Int }
given A.E is Q {}
given A.E is P { type E = Bool }
fun need<T where T is Q>(x: T) {}
fun use(x: Int) { need(x) }
