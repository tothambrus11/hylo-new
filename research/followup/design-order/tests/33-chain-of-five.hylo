// Expected after the change: accepted, in every order of the top-level declarations, in 6 rounds (one more than the number of nodes).
// Reason: A chain without a cycle in which each given needs the previous one. Checks the bound on the number of rounds and shows the cost: every round recomputes every signature.
// Currently: base rejects it in all 24 orders tried; FULL rejects it in all 24 orders tried.
// Review: withstood. With the design as first written (binary eq17, FULL+sigrounds) it is accepted in all 24 orders; `sigrounds.rounds=6 sigrounds.restores=5`.
trait P { type E }
struct A {}
struct Foo<T> {}
given A is P { type E = A }
type X0 = A.E
type F0 = Foo<X0>
given F0 is P { type E = F0 }
type X1 = F0.E
type F1 = Foo<X1>
given F1 is P { type E = F1 }
type X2 = F1.E
type F2 = Foo<X2>
given F2 is P { type E = F2 }
type X3 = F2.E
type F3 = Foo<X3>
given F3 is P { type E = F3 }
type X4 = F3.E
fun f(x: X4) {}
