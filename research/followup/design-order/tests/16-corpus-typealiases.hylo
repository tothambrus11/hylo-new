//! stage:typing no-std
// Expected after the change: accepted, in every order of the top-level declarations.
// Reason: Copy of Tests/CompilerTests/positive/typealiases.hylo.
// Currently: base accepts it in all 24 orders tried; FULL accepts it in all 120 orders tried.
struct A {
  struct B {}
}

extension A.B {
  type C = A
}

type D = A.B.C.B

trait P {
  type X
}

given A is P {
  type X = A
}

type E = A.X
