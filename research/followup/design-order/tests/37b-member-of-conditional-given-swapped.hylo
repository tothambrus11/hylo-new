// Expected after the change: accepted, and the same verdict as 37.
// Reason: 37 with the two givens of the body swapped.
// Currently: base accepts it; FULL rejects it ("circular given").
// Review: withstood; see 37.
trait P { type E }
trait Q {}
trait R { type F }
struct A {}
struct B {}
struct Foo<T> {}
given A is P { type E = Int }
given B is R { type F = Int }
given Int is Q {}
fun h() {
  given <where A.E is Q> => A is P { type E = B.F }
  given Foo<A.E> is Q {}
}
