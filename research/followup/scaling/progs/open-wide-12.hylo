trait Q {}
fun pick<T, U1, U2, U3, U4, U5, U6, U7, U8, U9, U10, U11, U12 where U1 is Q, T == U1, U2 is Q, T == U2, U3 is Q, T == U3, U4 is Q, T == U4, U5 is Q, T == U5, U6 is Q, T == U6, U7 is Q, T == U7, U8 is Q, T == U8, U9 is Q, T == U9, U10 is Q, T == U10, U11 is Q, T == U11, U12 is Q, T == U12>(x: T) {}
fun f<A0 where A0 is Q>(x: A0) { pick(x) }
