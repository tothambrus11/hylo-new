//! Same as t03 with the declaration order swapped (the bug depends on insertion order only via
//! rounds: both are round-0 facts, so the first-declared wins).
trait R<B> {}
trait W<B> {}
struct S<T> {}
struct Y {}
struct Z {}
given <F :: * -> *, A, G :: * -> *, B> => F<A> is R<G<B>> {}
given <T> => T is R<T> {}
given <A, B where S<A> is R<S<B>>> => A is W<B> {}
fun need<where Z is W<Y>>() {}
public fun main() {
  need()
}
