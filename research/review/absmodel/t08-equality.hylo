trait P { type X }
trait Q {}
struct A {}
struct B {}
given A is P { type X = B }
given B is Q {}
given <T, U where T == U, T is P> => U is Q {}
fun needQ<T where T is Q>() {}
fun g<V where V is P>() {}
fun f<T, U where T == U, T is P>() {
  g<U>()
  needQ<U>()
  needQ<T>()
}
fun f2<T where T is P, T.X == B>() {
  needQ<T.X>()
}
fun f3<T where T is P, T.X is Q>() {
  needQ<T.X>()
}
public fun main() {
  needQ<A>()
  needQ<B>()
  f2<A>()
  f3<A>()
}
