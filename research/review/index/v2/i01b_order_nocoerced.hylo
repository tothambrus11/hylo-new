// Control for i01: same program without the coercion in f.
struct A { public memberwise init }
struct B { public memberwise init }

fun needA<where let a: A>() -> B { B() }
fun needB<where let b: B>() -> A { A() }
fun check<T>(x: T) {}

fun f<T, U where T == U>(x: T) {
  check<T>(x)
}

fun k() {
  let z = g
}

given let h = needA()
given let g = needB()
