// Evaluation-order hazard: in the baseline, `coerced` -> canDeriveCoercions exits early at the
// where-clause equality and forces no other given. With `index`, givenIndex forces the declared
// type of every visible given (in group order) at that point.
struct A { public memberwise init }
struct B { public memberwise init }

fun needA<where let a: A>() -> B { B() }
fun needB<where let b: B>() -> A { A() }
fun check<T>(x: T) {}

fun f<T, U where T == U>(x: T) {
  check<U>(x)
}

fun k() {
  let z = g
}

given let h = needA()
given let g = needB()
