trait P0 {}
trait P1 {}
trait P2 {}
trait P3 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {A, A} is P3 {}
given {B, A} is P3 {}
given <T where T is P1> => Box<T> is P1 {}
given <T, U where T == U> => Box<T> is P0 {}
given XA is P0 {}
given {A, B} is P1 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun need3<T is P3>() {}
fun check<T>(x: T) {}
fun f0<T where let t: T, let b: Box<A>>() {
  given <T where T == XA> => T is P1 {}
  if true {
    given <T, U where T == U> => Box<T> is P1 {}
    need3<XB>()
    need2<Pair<B, A>>()
  }
  need3<Pair<B, A>>()
  need2<B>()
}
fun f1<where let a: A, A is P1>() {
  need2<Box<B>>()
  need0<Box<A>>()
  check(summon[P0<Box<B>>])
  need3<XC>()
}
fun f2() {
  need3<Void>()
  need3<XB>()
  need0<Pair<A, B>>()
  need2<XC>()
}
fun f3() {
  need1<XA>()
  given <T where T is P0> => T is P3 {}
}
fun f4() {
  need1<B>()
  check(summon[P1<Box<B>>])
  need1<Pair<A, B>>()
  check(summon[P0<Bool>])
}
