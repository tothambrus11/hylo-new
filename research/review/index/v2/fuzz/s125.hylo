trait P0 {}
trait P1 refines P0 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given XB is P1 {}
given <T, U where T == U> => Box<T> is P0 {}
given <T where T is P0> => Box<T> is P1 {}
given {B, A} is P1 {}
given <where Pair<A, B> is P1> => Pair<A, B> is P1 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0() {
  need1<A>()
  need0<Pair<A, B>>()
  if true {
    need0<Void>()
  }
}
fun f1<where let a: A, B is P0>() {
  given <T, U where T == U> => Box<T> is P0 {}
  need1<{A, B}>()
  given {A, B} is P0 {}
  need1<Bool>()
}
fun f2<T where let t: T, let b: Box<A>>() {
  need1<Int>()
  need1<Box<XA>>()
}
