trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {A, B} is P1 {}
given XB is P1 {}
given <T> => Box<T> is P1 {}
given <T where T == B> => T is P0 {}
given XA is P0 {}
given XC is P0 {}
given <T where T is P1> => Box<T> is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<T where let t: T, let b: Box<A>>() {
  _ = summon[P0<XA>]
  need0<Box<A>>()
  need1<{A, B}>()
  need1<A>()
}
fun f1<T, U where T == U, T is P1>() {
  need0<XC>()
  need1<Box<B>>()
  need1<T>()
}
