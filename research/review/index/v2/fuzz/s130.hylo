trait P0 {}
trait P1 {}
trait P2 {}
trait P3 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T where T == B> => T is P0 {}
given XB is P2 {}
given <T> => Box<T> is P2 {}
given <T where T == XA> => T is P0 {}
given {A, B} is P0 {}
given <T where T is P2> => T is P1 {}
given Bool is P3 {}
given XP is P3 {}
given <T where T is P0> => T is P1 {}
given {A, B} is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun need3<T is P3>() {}
fun check<T>(x: T) {}
fun f0<T is P0>() {
  need0<Box<T>>()
  if true {
    need1<T>()
    check(summon[P3<Box<T>>])
    check(summon[P1<T>])
  }
  need2<Int>()
  need1<Box<Box<A>>>()
}
fun f1<T where let t: T, let b: Box<A>>() {
  if true {
    need0<B>()
    need3<XP>()
    need3<Box<A>>()
  }
  need0<XB>()
  if true {
    need2<Pair<A, B>>()
    check(summon[P1<XA>])
    need1<Pair<A, B>>()
  }
}
fun f2<T, U where T == U, T is P1>() {
  if true {
    given <T, U where T is P2, U is P2> => Pair<T, U> is P2 {}
    given <T where T == XA> => T is P0 {}
    given <T> => Box<T> is P3 {}
    check(summon[P0<Pair<T, A>>])
  }
  given <T where T == A> => T is P1 {}
  need0<A>()
}
