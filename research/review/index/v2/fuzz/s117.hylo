trait P0 {}
trait P1 refines P0 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T, U where T is P1, U is P0> => Pair<T, U> is P1 {}
given XP is P0 {}
given <T, U where T is P1, U is P1> => Pair<T, U> is P0 {}
given <T, U where T is P1, U is P1> => Pair<T, U> is P1 {}
given <T where T is P1> => T is P0 {}
given <T, U where T == U> => Box<T> is P0 {}
given {B, B} is P0 {}
given <T, U where T is P1, U is P0> => Pair<T, U> is P0 {}
given <T, U where T == U> => Box<T> is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<T is P1>() {
  need1<Box<T>>()
  need1<Box<Box<A>>>()
  let _ = summon[P1<T>]
}
fun f1<T where let t: T, let b: Box<A>>() {
  let _ = summon[P1<Int>]
  if true {
    need0<B>()
    need1<XC>()
    need1<A>()
    if true {
      given <T, U where T == U> => Box<T> is P1 {}
      let _ = summon[P1<XB>]
      let _ = summon[P0<XB>]
    }
  }
  need1<XA>()
  need1<Box<A>>()
}
