trait P0 {}
trait P1 {}
trait P2 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {A, A} is P1 {}
given <T where T == B> => T is P1 {}
given <T> => Box<T> is P0 {}
given A is P0 {}
given <T where T is P1> => Box<T> is P0 {}
given {A, B} is P1 {}
given <T where T == XA> => T is P0 {}
given <where Box<A> is P2> => Box<Box<A>> is P2 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun check<T>(x: T) {}
fun f0<T, U where T == U, T is P0>() {
  check(summon[P0<Box<A>>])
  need1<XA>()
  given <where Box<B> is P1> => Bool is P1 {}
}
fun f1<T, U where T == U, T is P1>() {
  need1<Box<U>>()
}
