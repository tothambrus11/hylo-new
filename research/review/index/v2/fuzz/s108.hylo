trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T where T == B> => T is P1 {}
given <T where T is P0> => T is P1 {}
given <T> => Box<T> is P0 {}
given <T> => Box<T> is P1 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0() {
  if true {
    if true {
      need1<Pair<B, A>>()
      need0<Int>()
      need1<XP>()
    }
    need0<Pair<B, A>>()
    need1<Pair<B, A>>()
    if true {
      need0<Void>()
    }
  }
  given XB is P1 {}
}
fun f1() {
  given <T> => Box<T> is P1 {}
  need0<A>()
  given <T, U where T == U> => Box<T> is P1 {}
}
fun f2<where let a: A, A is P0>() {
  if true {
    need0<XP>()
    let _ = summon[P0<XP>]
  }
  given A is P1 {}
}
