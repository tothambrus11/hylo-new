trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T, U where T is P0, U is P1> => Pair<T, U> is P1 {}
given <T, U where T == U> => Box<T> is P1 {}
given <T, U where T == U> => Box<T> is P0 {}
given {A, B} is P1 {}
given <T> => Box<T> is P0 {}
given <T where T is P0> => Box<T> is P0 {}
given <T, U where T == U> => Box<T> is P1 {}
given {A, A} is P1 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<where let a: A, B is P0>() {
  need0<XP>()
  need1<{A, B}>()
}
fun f1<where let a: A, A is P0>() {
  given <T where T is P0> => Box<T> is P1 {}
  check(summon[Void])
  need1<XP>()
}
fun f2<where let a: A, B is P1>() {
  check(summon[A])
  need0<Box<XA>>()
}
fun f3<T where let t: T, let b: Box<A>>() {
  need0<Bool>()
}
fun f4<T is P1>() {
  need1<{A, B}>()
}
