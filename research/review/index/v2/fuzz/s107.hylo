trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {B, A} is P1 {}
given {A, B} is P1 {}
given <T, U where T == U> => Box<T> is P0 {}
given {B, B} is P0 {}
given <T, U where T is P0, U is P0> => Pair<T, U> is P0 {}
given <T> => Box<T> is P1 {}
given <T where T is P0> => Box<T> is P0 {}
given <T where T is P1> => Box<T> is P0 {}
given <T, U where T is P1, U is P1> => Pair<T, U> is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<T, U where T == U, T is P1>() {
  given <T where T is P1> => Box<T> is P1 {}
  check(summon[P0<XC>])
  given <T> => Box<T> is P0 {}
  need0<Int>()
}
fun f1<T is P0>() {
  need1<Int>()
  let _ = summon[P1<B>]
  need1<Box<B>>()
}
fun f2<T where let t: T, let b: Box<A>>() {
  let _ = summon[P0<Void>]
  need1<XB>()
  need1<Box<XA>>()
}
