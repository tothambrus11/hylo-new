trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T> => Box<T> is P1 {}
given <T> => Box<T> is P0 {}
given <T, U where T is P1, U is P0> => Pair<T, U> is P1 {}
given {A, A} is P1 {}
given {A, A} is P0 {}
given <T, U where T is P1, U is P0> => Pair<T, U> is P1 {}
given <T> => Box<T> is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<T, U where T == U, T is P1>() {
  need1<Box<U>>()
  if true {
    need0<Void>()
    if true {
      need1<T>()
    }
    need1<Box<U>>()
    given <T> => Box<T> is P1 {}
  }
}
fun f1() {
  let _ = summon[P0<Pair<B, A>>]
}
fun f2() {
  check(summon[P1<XP>])
}
