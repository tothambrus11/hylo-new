trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {B, B} is P1 {}
given {A, A} is P0 {}
given {B, B} is P0 {}
given <T where T == XA> => T is P0 {}
given XB is P1 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<T is P0>() {
  check(summon[P1<Pair<B, A>>])
  need1<Void>()
}
fun f1<T is P0>() {
  if true {
    given <T, U where T == U> => Box<T> is P0 {}
    given <T, U where T is P0, U is P0> => Pair<T, U> is P1 {}
    need1<Pair<T, A>>()
    if true {
      need1<XP>()
      need1<Box<XA>>()
    }
  }
  need1<Box<B>>()
}
fun f2<T, U where T == U, T is P1>() {
  given let lt = {A(), B()}
  need1<XB>()
  given XP is P0 {}
}
