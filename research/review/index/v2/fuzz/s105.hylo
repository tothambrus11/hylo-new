trait P0 {}
trait P1 {}
trait P2 {}
trait P3 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {B, B} is P1 {}
given XB is P1 {}
given <T where T is P3> => Box<T> is P2 {}
given <T, U where T is P3, U is P3> => Pair<T, U> is P3 {}
given {A, A} is P2 {}
given {B, A} is P2 {}
given <T, U where T == U> => Box<T> is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun need3<T is P3>() {}
fun check<T>(x: T) {}
fun f0<T is P3>() {
  need3<Box<B>>()
  need3<Pair<T, A>>()
  _ = summon[P1<Bool>]
  need2<A>()
}
fun f1<T where let t: T, let b: Box<A>>() {
  given Pair<A, B> is P2 {}
  need3<Int>()
}
fun f2<T where let t: T, let b: Box<A>>() {
  need0<Box<A>>()
  need0<Box<XA>>()
}
fun f3<T where let t: T, let b: Box<A>>() {
  _ = summon[P1<Box<XA>>]
  need2<Box<A>>()
  if true {
    need1<{A, B}>()
  }
}
