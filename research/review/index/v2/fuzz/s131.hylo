trait P0 {}
trait P1 {}
trait P2 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <where A is P1> => Box<B> is P1 {}
given <T, U where T == U> => Box<T> is P2 {}
given <T where T is P2> => Box<T> is P0 {}
given <T> => Box<T> is P2 {}
given {B, B} is P2 {}
given <T> => Box<T> is P0 {}
given {A, A} is P1 {}
given {A, B} is P2 {}
given {A, A} is P2 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun check<T>(x: T) {}
fun f0<T, U where T == U, T is P1>() {
  given <T where T is P0> => Box<T> is P0 {}
}
fun f1<T where let t: T, let b: Box<A>>() {
  if true {
    given <T, U where T is P2, U is P1> => Pair<T, U> is P1 {}
    if true {
      need1<A>()
      need1<Box<Box<A>>>()
    }
    let _ = summon[P1<Pair<B, A>>]
    need2<Box<A>>()
  }
  need1<Box<A>>()
  given A is P1 {}
}
fun f2<where let a: A, A is P1>() {
  need0<XB>()
  if true {
    let _ = summon[P0<Pair<B, A>>]
  }
  check(summon[P0<Int>])
}
fun f3<T, U where T == U, T is P0>() {
  need0<B>()
  if true {
    check(summon[P0<T>])
    need2<XA>()
    given Box<A> = Box<A>()
  }
  need0<Bool>()
  _ = summon[P2<Pair<A, B>>]
}
fun f4<T, U where T == U, T is P2>() {
  need0<Pair<A, B>>()
  need0<Box<Box<A>>>()
  if true {
    need2<Void>()
    need2<Bool>()
  }
  given <T where T == XA> => T is P2 {}
}
