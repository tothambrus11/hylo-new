trait P0 {}
trait P1 refines P0 {}
trait P2 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T> => Box<T> is P2 {}
given {B, A} is P0 {}
given {B, B} is P2 {}
given <T, U where T is P1, U is P2> => Pair<T, U> is P2 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun check<T>(x: T) {}
fun f0() {
  need0<XP>()
  need0<Box<Box<A>>>()
}
fun f1<T where let t: T, let b: Box<A>>() {
  need2<Int>()
  given A is P0 {}
}
fun f2() {
  need2<Bool>()
}
fun f3() {
  need0<Int>()
  need2<Box<B>>()
  need0<XB>()
}
