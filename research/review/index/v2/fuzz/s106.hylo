trait P0 {}
trait P1 {}
trait P2 {}
trait P3 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given XB is P0 {}
given <T> => Box<T> is P3 {}
given XP is P3 {}
given {B, A} is P3 {}
given <where Bool is P1> => Pair<A, B> is P2 {}
given XP is P2 {}
given <T where T is P2> => Box<T> is P2 {}
given XB is P1 {}
given <T where T is P0> => T is P2 {}
given <T where T is P1> => Box<T> is P2 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun need3<T is P3>() {}
fun check<T>(x: T) {}
fun f0<T where let t: T, let b: Box<A>>() {
  need2<Bool>()
  need3<XA>()
  given <T, U where T is P3, U is P1> => Pair<T, U> is P1 {}
}
fun f1<T is P1>() {
  need1<XP>()
  let _ = summon[P2<Int>]
  need3<Box<T>>()
}
fun f2<T is P2>() {
  need3<Box<Box<A>>>()
  given <T, U where T == U> => Box<T> is P0 {}
  need2<Box<A>>()
  need0<Bool>()
}
fun f3<where let a: A, B is P1>() {
  given <T where T is P3> => Box<T> is P0 {}
}
fun f4<T, U where T == U, T is P1>() {
  given <T, U where T is P0, U is P0> => Pair<T, U> is P2 {}
  need2<XP>()
  need0<Box<U>>()
}
