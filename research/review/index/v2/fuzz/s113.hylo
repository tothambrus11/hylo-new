trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given Bool is P1 {}
given <T> => Box<T> is P1 {}
given Box<A> is P1 {}
given <T, U where T is P1, U is P1> => Pair<T, U> is P1 {}
given <where {A, B} is P1> => Void is P0 {}
given {B, B} is P0 {}
given {B, A} is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<where let a: A, B is P1>() {
  check(summon[P1<Pair<B, A>>])
  given let la = A()
}
fun f1() {
  given XC is P0 {}
  given Pair<A, B> is P1 {}
  if true {
    need0<Pair<B, A>>()
  }
  _ = summon[P1<Box<Box<A>>>]
}
fun f2() {
  if true {
    need0<Bool>()
    given <T where T is P0> => Box<T> is P1 {}
  }
  need1<Box<XA>>()
  given <T where T is P0> => Box<T> is P0 {}
  given A = A()
}
fun f3<T where let t: T, let b: Box<A>>() {
  check(summon[P1<XA>])
  need0<A>()
}
