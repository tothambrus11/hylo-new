trait P0 {}
trait P1 {}
trait P2 {}
trait P3 refines P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {B, A} is P1 {}
given XC is P2 {}
given XC is P2 {}
given <T, U where T == U> => Box<T> is P2 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun need3<T is P3>() {}
fun check<T>(x: T) {}
fun f0<T, U where T == U, T is P0>() {
  let _ = summon[P2<Box<A>>]
  check(summon[P2<Box<A>>])
}
fun f1<T is P0>() {
  need1<Void>()
  need0<Box<T>>()
}
fun f2<where let a: A, B is P2>() {
  if true {
    need2<Box<Box<A>>>()
    given Void = ()
  }
  given XC is P0 {}
}
fun f3<T is P2>() {
  given let lt = {A(), B()}
}
