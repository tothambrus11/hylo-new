trait P0 {}
trait P1 {}
trait P2 {}
trait P3 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {A, A} is P1 {}
given <where Bool is P1> => XP is P3 {}
given <T where T is P2> => Box<T> is P1 {}
given <T, U where T is P0, U is P3> => Pair<T, U> is P2 {}
given <T> => Box<T> is P3 {}
given XB is P3 {}
given <T where T is P3> => T is P3 {}
given <where Pair<B, A> is P0> => XP is P2 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun need3<T is P3>() {}
fun check<T>(x: T) {}
fun f0<where let a: A, A is P3>() {
  need3<A>()
}
fun f1<where let a: A, A is P0>() {
  if true {
    need2<A>()
    _ = summon[P1<B>]
    check(summon[A])
  }
  given A is P2 {}
  need3<Pair<A, B>>()
}
fun f2<where let a: A, B is P2>() {
  need0<Box<A>>()
  if true {
    need2<Int>()
  }
}
fun f3() {
  need1<Pair<A, B>>()
  given let lt = {A(), B()}
  need1<Box<A>>()
  given <where XP is P3> => Box<A> is P0 {}
}
fun f4<T where let t: T, let b: Box<A>>() {
  need0<Pair<B, A>>()
  _ = summon[P2<Box<A>>]
  let _ = summon[P2<Int>]
}
