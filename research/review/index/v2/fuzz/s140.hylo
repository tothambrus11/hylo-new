trait P0 {}
trait P1 refines P0 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T where T == XA> => T is P0 {}
given Pair<B, A> is P1 {}
given <T where T == B> => T is P1 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<T is P0>() {
  need1<XC>()
  if true {
    need0<Pair<T, A>>()
    need0<T>()
    need1<Box<B>>()
    need1<XP>()
  }
}
fun f1<T is P0>() {
  if true {
    need0<T>()
    need1<Bool>()
    need1<Void>()
  }
  need1<Box<XA>>()
  need1<{A, B}>()
  given XP is P1 {}
}
