trait P0 {}
trait P1 {}
trait P2 {}
trait P3 refines P2 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T where T == A> => T is P2 {}
given <T> => Box<T> is P0 {}
given {A, A} is P2 {}
given <T, U where T == U> => Box<T> is P1 {}
given <T, U where T is P3, U is P3> => Pair<T, U> is P1 {}
given <T where T is P2> => Box<T> is P0 {}
given <where Box<A> is P3> => B is P1 {}
given <T, U where T == U> => Box<T> is P1 {}
given <T where T is P1> => Box<T> is P3 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun need3<T is P3>() {}
fun check<T>(x: T) {}
fun f0<T, U where T == U, T is P2>() {
  given XP is P0 {}
  need1<Box<T>>()
  need3<Box<U>>()
}
fun f1<T, U where T == U, T is P2>() {
  need3<Pair<T, A>>()
  given <T where T == XA> => T is P1 {}
  need1<Box<T>>()
}
