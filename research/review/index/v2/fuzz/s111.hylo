trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {A, B} is P1 {}
given <T, U where T == U> => Box<T> is P0 {}
given <T where T == A> => T is P1 {}
given {A, A} is P1 {}
given A is P1 {}
given <T where T is P1> => T is P1 {}
given XP is P0 {}
given <T, U where T == U> => Box<T> is P1 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0() {
  need0<XC>()
  if true {
    need1<XA>()
    need0<A>()
    need1<Bool>()
  }
  need0<Box<Box<A>>>()
  if true {
    need1<A>()
    _ = summon[P0<Int>]
  }
}
fun f1<T is P0>() {
  need1<Pair<T, A>>()
  need0<T>()
  need1<Box<T>>()
  if true {
    need0<Box<B>>()
    need1<T>()
    need1<Pair<T, A>>()
  }
}
fun f2<where let a: A, Box<A> is P0>() {
  check(summon[P0<{A, B}>])
}
fun f3<T is P0>() {
  need1<T>()
}
fun f4<T is P0>() {
  need0<Pair<T, A>>()
  check(summon[P1<XB>])
  let _ = summon[P1<Pair<T, A>>]
  need0<Pair<T, A>>()
}
