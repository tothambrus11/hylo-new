trait P0 {}
trait P1 {}
trait P2 {}
trait P3 refines P2 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {A, B} is P3 {}
given <T> => Box<T> is P2 {}
given A is P3 {}
given <T, U where T == U> => Box<T> is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun need3<T is P3>() {}
fun check<T>(x: T) {}
fun f0() {
  need2<Bool>()
  if true {
    need2<Box<Box<A>>>()
  }
  need3<Pair<B, A>>()
}
fun f1<T where let t: T, let b: Box<A>>() {
  need2<Box<XA>>()
  need0<{A, B}>()
  need0<Void>()
  need1<XP>()
}
fun f2<T where let t: T, let b: Box<A>>() {
  if true {
    check(summon[P1<Box<XA>>])
    need3<Pair<A, B>>()
    need2<B>()
    need3<Void>()
  }
}
fun f3() {
  let _ = summon[P1<XP>]
}
fun f4<T, U where T == U, T is P0>() {
  if true {
    _ = summon[P3<Box<U>>]
    given A = A()
  }
  need3<Box<U>>()
  need3<XP>()
  need0<Box<B>>()
}
