trait P0 {}
trait P1 refines P0 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T where T is P0> => Box<T> is P1 {}
given {B, B} is P0 {}
given <T, U where T is P0, U is P1> => Pair<T, U> is P1 {}
given {A, A} is P0 {}
given A is P1 {}
given <T where T is P0> => Box<T> is P1 {}
given {B, A} is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<T is P0>() {
  check(summon[P1<T>])
}
fun f1<T, U where T == U, T is P1>() {
  given <T, U where T == U> => Box<T> is P1 {}
  if true {
    need1<Bool>()
    need1<T>()
    need0<Box<A>>()
    need1<Pair<T, A>>()
  }
  need1<Int>()
  need1<Box<U>>()
}
