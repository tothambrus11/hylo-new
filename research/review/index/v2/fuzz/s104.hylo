trait P0 {}
trait P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given A is P0 {}
given Pair<A, B> is P0 {}
given <T, U where T is P0, U is P0> => Pair<T, U> is P1 {}
given XA is P0 {}
given <T, U where T == U> => Box<T> is P1 {}
given A is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun check<T>(x: T) {}
fun f0<where let a: A, A is P1>() {
  need0<XB>()
  given <T, U where T == U> => Box<T> is P0 {}
  if true {
    need0<Pair<A, B>>()
  }
  _ = summon[P1<XP>]
}
fun f1() {
  need0<Box<B>>()
  if true {
    need1<Box<Box<A>>>()
    given <T, U where T is P0, U is P0> => Pair<T, U> is P0 {}
    need1<B>()
    given A = A()
  }
  given <T, U where T == U> => Box<T> is P1 {}
}
fun f2() {
  given <T where T is P0> => Box<T> is P0 {}
}
fun f3<T is P0>() {
  need1<Bool>()
}
