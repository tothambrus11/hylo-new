trait P0 {}
trait P1 refines P0 {}
trait P2 refines P1 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given <T, U where T is P1, U is P1> => Pair<T, U> is P0 {}
given {A, B} is P2 {}
given <where {A, B} is P2> => B is P2 {}
given <T where T == B> => T is P0 {}
given <T, U where T is P1, U is P0> => Pair<T, U> is P2 {}
given {B, B} is P0 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun check<T>(x: T) {}
fun f0<T is P0>() {
  need1<Pair<A, B>>()
  if true {
    given let la = A()
  }
  given <T, U where T == U> => Box<T> is P0 {}
  check(summon[P1<Box<T>>])
}
fun f1<T is P2>() {
  need0<T>()
  need1<A>()
}
