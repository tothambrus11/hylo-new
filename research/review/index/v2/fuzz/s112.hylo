trait P0 {}
trait P1 {}
trait P2 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {B, B} is P2 {}
given <T, U where T is P1, U is P0> => Pair<T, U> is P2 {}
given {A, B} is P2 {}
given <T> => Box<T> is P2 {}
given {B, B} is P1 {}
given <T> => Box<T> is P0 {}
given {A, B} is P2 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun check<T>(x: T) {}
fun f0<where let a: A, B is P1>() {
  if true {
    if true {
      check(summon[P2<Box<A>>])
      need0<Box<A>>()
    }
  }
  given <where Bool is P0> => XB is P2 {}
  need0<XC>()
}
fun f1<T where let t: T, let b: Box<A>>() {
  given {A, A} is P2 {}
  let _ = summon[P2<Pair<A, B>>]
  need1<XA>()
  need2<Pair<A, B>>()
}
fun f2() {
  need2<Box<A>>()
  need0<XP>()
  if true {
    if true {
      need2<Pair<A, B>>()
      let _ = summon[P0<A>]
      need1<Box<XA>>()
      check(summon[P1<XP>])
    }
    need0<XC>()
    if true {
      need0<{A, B}>()
    }
    need0<XP>()
  }
}
fun f3<where let a: A, B is P2>() {
  need1<Box<Box<A>>>()
  if true {
    need1<Int>()
    if true {
      let _ = summon[P2<Int>]
      need1<XP>()
      need2<XC>()
    }
    given let lb = Box<A>()
    need1<Int>()
  }
}
