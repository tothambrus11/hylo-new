trait P0 {}
trait P1 refines P0 {}
trait P2 {}
struct A { public memberwise init }
struct B { public memberwise init }
struct Box<T> { public memberwise init }
struct Pair<T, U> { public memberwise init }
type XA = A
type XB = Box<A>
type XC = XB
type XP = Pair<A, B>
given {B, B} is P2 {}
given XP is P0 {}
given {A, A} is P0 {}
given <where Pair<A, B> is P1> => XA is P0 {}
given <T, U where T is P0, U is P2> => Pair<T, U> is P0 {}
given <T, U where T is P2, U is P2> => Pair<T, U> is P1 {}
given Pair<B, A> is P2 {}
given XB is P2 {}
fun need0<T is P0>() {}
fun need1<T is P1>() {}
fun need2<T is P2>() {}
fun check<T>(x: T) {}
fun f0<T where let t: T, let b: Box<A>>() {
  check(summon[P1<Pair<B, A>>])
  need2<XP>()
}
fun f1<T is P2>() {
  need2<Int>()
  let _ = summon[P2<XP>]
  need1<Pair<A, B>>()
  if true {
    need2<T>()
  }
}
fun f2<T is P0>() {
  need2<Box<T>>()
  check(summon[P0<Pair<B, A>>])
  if true {
    _ = summon[P0<XP>]
  }
}
fun f3<T where let t: T, let b: Box<A>>() {
  check(summon[P2<Bool>])
  need2<Pair<A, B>>()
}
