// Value givens whose types are tuples, arrows, metatypes, machine types; queries of the same.
trait P {}
struct A { public memberwise init }
struct Box<T> { public memberwise init }
fun check<T>(x: T) {}

fun f<where let t: {A, A}, let m: Metatype<A>, let i: Int, let b: Bool, let v: Void>() {
  check(summon[{A, A}])
  check(summon[Metatype<A>])
  check(summon[Int])
  check(summon[Bool])
  check(summon[Void])
  check(summon[A])
  given let fa = A()
  check(summon[A])
  given let fb = Box<{A, A}>()
  check(summon[Box<{A, A}>])
}
