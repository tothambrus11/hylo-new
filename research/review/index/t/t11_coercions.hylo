trait P { type X; fun f() -> X }
struct A<T> { public memberwise init }

extension A<Void> { fun f() { () } }
given A<Void> is P { type X = A<Void>; fun f() -> X { A() } }

fun use(x: Void) {}
fun check<T>(x: T) {}

fun need<T is P>() {}

fun g<T, U where T == U, T is P>(x: T.X) -> U.X { x }

fun k<T where T == A<Void>>(x: T) {
  need<T>()
  let y = x as A<Void>
  check<A<Void>>(y)
}

fun main() {
  let a = A<Void>()
  let x = a.f()
  use(x)
  let y: A<Void> = a.f()
  k(a)
}
