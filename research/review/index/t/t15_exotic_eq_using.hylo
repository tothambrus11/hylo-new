trait P {}
trait Q {}
struct A { public memberwise init }
struct S { public memberwise init }
struct S2 { public memberwise init }
type Z = S

fun need<T is P>() {}
fun check<T>(x: T) {}

// Candidate with a mismatched head whose own premise equates the mismatched constructors.
given <where Q == P> => A is Q {}
given <where S2 == S> => A is Q {}

fun f() {
  need<A>()
}

fun g<where let s2: S2>() {
  check<S>(summon[Z])
}
