//! stage:typing no-std
// Generic parameters (distinct parameters never unify), higher-kinded, universal types as values.
struct A<T> { public let x: T; public memberwise init }
struct B<T> { public memberwise init }

fun check<T>(x: T) {}
fun f<T :: * -> *, U>() -> T<U> { Builtin.trap() }
fun g<T :: * -> *, U>(x: T<U>) -> T<A<U>> { Builtin.trap() }
fun same<T>(x: T, y: T) {}
fun twoParams<T, U>(x: T, y: U) {
  same(x, y)
  check<T>(y)
  let z: U = x
}
fun poly<T>(x: T) -> T { Builtin.trap() }

fun main() {
  let x = f<A, Void>()
  check<A<Void>>(x)
  let y = g(A(x: ()))
  check<A<A<Void>>>(y)
  let z = g(B<Void>())
  check<B<A<Void>>>(z)
  check<A<A<Void>>>(z)
  let p = poly
  let q: [](let Void) -> Void = poly
  same(A(x: ()), B<Void>())
}
