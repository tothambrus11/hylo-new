//! stage:typing no-std
fun check<T>(x: T) {}
fun apply<A, B>(f: [](let A) -> B, x: A) -> B { f(x) }
fun applyS<A, B>(f: [](sink A) -> B, x: sink A) -> B { f(x) }
fun lab<A>(f: [](a: let A) -> A) {}
fun id<T>(x: T) -> T { x }
public fun main() {
  let f0 = fun[](a: Void) { a }
  check<[](let Void) -> Void>(f0)
  let r = apply(f0, ())
  check<Void>(r)
  // effect mismatch: let vs sink
  let r2 = applyS(f0, ())
  // label mismatch
  lab(f0)
  let g = fun[](a: sink Void) { a }
  check<[](let Void) -> Void>(g)
  let h: [](sink Void) -> Void = g
}
