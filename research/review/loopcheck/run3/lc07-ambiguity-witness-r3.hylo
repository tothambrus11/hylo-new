trait T {}
trait U refines T {}
struct SA {}
struct SP {}
struct SP1 {}
struct SP2 {}
struct SQ1 {}
struct SQ2 {}
struct SX {}

given SP2 is T {}
given <where SP2 is T> => SP1 is T {}
given <where SP1 is T> => SP is T {}
given SX is T {}
given <where SX is T, SQ1 is T, SQ2 is T> => SA is T {}
given <where SP is T> => SQ1 is T {}
given <where SP is T> => SQ2 is T {}

// Two copies of the looping given: two equally good loop terms (baseline: ambiguous).
given <where SP is T, SA is T> => SA is T {}
given <where SP is T, SA is T> => SA is T {}

given SA is U {}
