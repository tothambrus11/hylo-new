trait T {}
struct SA {}
struct SP {}
struct SP1 {}
struct SP2 {}
struct SP3 {}
struct SQ1 {}
struct SQ2 {}

// D_P has 4 nodes.
given SP3 is T {}
given <where SP3 is T> => SP2 is T {}
given <where SP2 is T> => SP1 is T {}
given <where SP1 is T> => SP is T {}

// Direct derivation of SA: g3(g4(D_P), g5(D_P)) = 1 + (1+4) + (1+4) = 11 matches.
given <where SQ1 is T, SQ2 is T> => SA is T {}
given <where SP is T> => SQ1 is T {}
given <where SP is T> => SQ2 is T {}

// Loop derivation: g1(D_P, g3(g4(p), g5(p))) = 1 + 1 + 2 + 2 + 4 = 10 matches, where p is the
// pending premise `SP is T` of g1, available while its sibling `SA is T` is resolved.
given <where SP is T, SA is T> => SA is T {}

fun need<where SA is T>() {}
public fun main() { need() }
