// Overloads whose viability depends on summoning a given (context clause).
trait P {}
trait Q {}
struct A { public memberwise init }
struct B { public memberwise init }
given A is P {}
given B is Q {}
fun f<T where T is P>(x: T) -> A { A() }
fun f<T where T is Q>(x: T) -> B { B() }
fun take(x: B) {}
public fun main() {
  let a = f(A())
  take(f(B()))
  let c = f(B()) as B
}
