// Overloaded calls whose choice determines a lambda parameter / result type.
struct A { public memberwise init }
struct B { public memberwise init }
fun f(x: A) -> A { x }
fun f(x: B) -> B { x }
fun app<T, U>(g: [](let T) -> U, x: T) -> U { g(x) }
fun check<T>(x: T) {}
public fun main() {
  let v = app(fun[](a: A) { f(a) }, A())
  check<A>(v)
  let w = (fun[](a) { f(a) })(B())
}
