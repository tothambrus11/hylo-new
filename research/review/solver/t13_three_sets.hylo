// Three overload sets with different survivor counts; preference order disagrees.
struct X { public memberwise init }
struct Y { public memberwise init }
struct Z { public memberwise init }
struct S {
  public memberwise init
  public static fun a() -> X { X() }
  public static fun b() -> Y { Y() }
  public static fun c() -> Z { Z() }
}
fun j<V>(x: V, y: V, z: V) {}
fun main() {
  extension S {
    static fun a() -> Y { Y() }
    static fun b() -> Z { Z() }
    static fun c() -> X { X() }
  }
  extension <T> T {
    static fun a() -> Z { Z() }
    static fun b() -> X { X() }
  }
  j(S.a(), S.b(), S.c())
}
