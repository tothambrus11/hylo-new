// Lambdas and overloaded calls.
struct A { public memberwise init }
struct B { public memberwise init }
fun f(x: A) -> A { x }
fun f(x: B) -> B { x }
fun check<T>(x: T) {}
public fun main() {
  let l0 = fun[](a: A) { f(a) }
  let l1 = fun[](a) { f(a) } as [](let A) -> A
  let l2: [](let B) -> B = fun[](a) { f(a) }
  let v = (fun[](a: sink _) { f(a) })(A())
  check<A>(v)
}
